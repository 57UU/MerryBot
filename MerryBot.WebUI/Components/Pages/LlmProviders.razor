@page "/llmproviders"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<PageTitle>模型配置</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
    <h1>模型配置</h1>
    <p>models.dev 用于目录导入；真正使用的 API 地址、模型启用状态和 Key 都保存在本机数据库。Key 仅可写入，不会再次显示。</p>
</FluentStack>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <FluentMessageBar Intent="MessageIntent.Error" Style="margin-bottom: 12px;">@Error</FluentMessageBar>
}

<FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8" Style="margin-bottom: 12px;">
    <FluentButton Appearance="Appearance.Accent" OnClick="OpenImportDialogAsync">从 models.dev 导入</FluentButton>
    <FluentButton Appearance="Appearance.Neutral" OnClick="() => OpenProviderDialogAsync()">手动添加 Provider</FluentButton>
    <FluentButton Appearance="Appearance.Neutral" OnClick="() => OpenModelDialogAsync()">手动添加模型</FluentButton>
</FluentStack>

<FluentCard Style="margin-bottom: 12px;">
    <h3>本地运行配置</h3>
    @if (Config == null)
    {
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
            <FluentProgressRing />
            <span>加载中…</span>
        </FluentStack>
    }
    else if (Config.Providers.Count == 0)
    {
        <p>暂无已导入的配置，可手动添加 Provider 或从 models.dev 导入。</p>
    }
    else
    {
        @foreach (var provider in Config.Providers)
        {
            <FluentCard Style="margin-bottom: 12px;" @key="provider.Id">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <strong>@provider.Name</strong>
                    @if (provider.Enabled)
                    {
                        <FluentBadge Appearance="Appearance.Accent">启用</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Neutral">禁用</FluentBadge>
                    }
                    <FluentSpacer />
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => OpenProviderDialogAsync(provider)">编辑</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => DeleteProviderAsync(provider.Id)">删除 Provider（含模型和 Key）</FluentButton>
                </FluentStack>
                <div style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@($"{provider.Id} · {provider.ApiFormat} · {provider.BaseUrl}")"><small><code>@provider.Id</code> · @provider.ApiFormat · @provider.BaseUrl</small></div>

                @if (provider.Keys.Count > 0)
                {
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="margin-top: 8px;">
                        <span>Key</span>
                        @foreach (var key in provider.Keys)
                        {
                            <FluentBadge Appearance="Appearance.Neutral" @key="key.Id">
                                <code>@key.Fingerprint</code>
                                <FluentButton Appearance="Appearance.Lightweight" Title="删除此 Key" aria-label="删除此 Key" OnClick="() => DeleteKeyAsync(key.Id)">×</FluentButton>
                            </FluentBadge>
                        }
                    </FluentStack>
                }

                @if (provider.Models.Count > 0)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="margin-top: 8px;">
                        @foreach (var model in provider.Models)
                        {
                            <FluentCard @key="model.Id">
                                <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:8px;align-items:start;width:100%;">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                        <span style="display:block;overflow-wrap:break-word;"><code>@model.Id</code><span>→</span><code>@model.RemoteModelId</code></span>
                                        @if (Config.DefaultModelId == model.Id || !model.Enabled || !string.IsNullOrEmpty(model.ReasoningEffort) || model.EnablePromptCache)
                                        {
                                            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4">
                                                @if (Config.DefaultModelId == model.Id)
                                                {
                                                    <FluentBadge Appearance="Appearance.Accent">默认</FluentBadge>
                                                }
                                                @if (!model.Enabled)
                                                {
                                                    <FluentBadge Appearance="Appearance.Neutral">禁用</FluentBadge>
                                                }
                                                @if (!string.IsNullOrEmpty(model.ReasoningEffort))
                                                {
                                                    <FluentBadge Appearance="Appearance.Neutral">思维 @model.ReasoningEffort</FluentBadge>
                                                }
                                                @if (model.EnablePromptCache)
                                                {
                                                    <FluentBadge Appearance="Appearance.Neutral">缓存</FluentBadge>
                                                }
                                            </FluentStack>
                                        }
                                        <small>
                                            @FormatLimit(model.ContextLength) context · @FormatLimit(model.MaxOutputTokens) output · @FormatCapabilities(model.Capabilities) · @FormatReasoningOptions(model.ReasoningOptions)
                                        </small>
                                    </FluentStack>
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                        @if (Config.DefaultModelId != model.Id)
                                        {
                                            <FluentButton Appearance="Appearance.Neutral" OnClick="() => SetDefaultAsync(model.Id)">设为默认</FluentButton>
                                        }
                                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => OpenModelDialogAsync(model)">编辑</FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => DeleteModelAsync(model.Id)">删除模型</FluentButton>
                                    </FluentStack>
                                </div>
                            </FluentCard>
                        }
                    </FluentStack>
                }
            </FluentCard>
        }
    }
</FluentCard>

@code {
    private LlmConfigSnapshot? Config;
    private string? error;

    /// <summary>页面级错误文案：入库前先经 DialogErrors 压成一句话，避免服务端 HTML 白墙。</summary>
    private string? Error
    {
        get => error;
        set => error = DialogErrors.Shorten(value);
    }

    private bool _initialized;

    // 预渲染阶段无法调用 JS 互操作，首次渲染（交互连接建立）后再加载
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadConfigAsync();
            StateHasChanged();
        }
    }

    private async Task LoadConfigAsync()
    {
        try
        {
            Error = null;
            Config = await RequestAsync<LlmConfigSnapshot>("GET", "/api/plugins/llm-provider/config");
        }
        catch (Exception ex)
        {
            Error = $"无法加载 LLM 配置：{ex.Message}";
        }
    }

    private async Task OpenProviderDialogAsync(LlmProviderDto? existing = null)
    {
        var parameters = new ProviderDialogParams { Existing = existing };
        var dialog = await DialogService.ShowDialogAsync<ProviderDialog>(parameters, new DialogParameters
        {
            Title = existing is null ? "手动添加 Provider" : "编辑 Provider",
            Width = "560px",
            Modal = true,
        });
        await dialog.Result;
        await LoadConfigAsync();
    }

    private async Task OpenModelDialogAsync(LlmModelDto? existing = null, LlmCatalogModelDto? prefill = null)
    {
        if (Config is null) return;
        var parameters = new ModelDialogParams { Providers = Config.Providers, Existing = existing, Prefill = prefill };
        var dialog = await DialogService.ShowDialogAsync<ModelDialog>(parameters, new DialogParameters
        {
            Title = existing is null ? "手动添加模型" : "编辑模型",
            Width = "720px",
            Modal = true,
        });
        await dialog.Result;
        await LoadConfigAsync();
    }

    private async Task OpenImportDialogAsync()
    {
        var parameters = new ImportDialogParams();
        var dialog = await DialogService.ShowDialogAsync<ImportDialog>(parameters, new DialogParameters
        {
            Title = "从 models.dev 导入",
            Width = "900px",
            Modal = true,
        });
        await dialog.Result;
        // 不依赖 result.Cancelled：× 关闭也可能发生在导入之后，以回填对象为准
        if (parameters.FillIntoForm is { } catalogModel)
        {
            await LoadConfigAsync();
            await OpenModelDialogAsync(prefill: catalogModel);
        }
        else if (parameters.Changed)
        {
            await LoadConfigAsync();
        }
    }

    private async Task SetDefaultAsync(string modelId)
    {
        try
        {
            await RequestAsync<object>("POST", $"/api/plugins/llm-provider/default/{Uri.EscapeDataString(modelId)}");
            await LoadConfigAsync();
        }
        catch (Exception ex)
        {
            Error = $"设置默认模型失败：{ex.Message}";
        }
    }

    private async Task DeleteModelAsync(string modelId)
    {
        if (!await ConfirmAsync($"确定要删除模型 {modelId} 吗？")) return;
        try
        {
            await RequestAsync<object>("POST", $"/api/plugins/llm-provider/models/delete?id={Uri.EscapeDataString(modelId)}");
            await LoadConfigAsync();
        }
        catch (Exception ex)
        {
            Error = $"删除模型失败：{ex.Message}";
        }
    }

    private async Task DeleteProviderAsync(string providerId)
    {
        if (!await ConfirmAsync($"确定要删除 Provider {providerId} 吗？其下所有模型和 Key 会一并删除。")) return;
        try
        {
            await RequestAsync<object>("POST", $"/api/plugins/llm-provider/providers/{Uri.EscapeDataString(providerId)}/delete");
            await LoadConfigAsync();
        }
        catch (Exception ex)
        {
            Error = $"删除 Provider 失败：{ex.Message}";
        }
    }

    private async Task DeleteKeyAsync(string keyId)
    {
        if (!await ConfirmAsync("确定要删除这个 Key 吗？删除后该 Provider 将没有可用 Key，AI 调用会失败。")) return;
        try
        {
            await RequestAsync<object>("POST", $"/api/plugins/llm-provider/keys/{Uri.EscapeDataString(keyId)}/delete");
            await LoadConfigAsync();
        }
        catch (Exception ex)
        {
            Error = $"删除 Key 失败：{ex.Message}";
        }
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("confirm", message);
        }
        catch
        {
            return false;
        }
    }

    private async Task<T?> RequestAsync<T>(string method, string url, object? body = null)
        => await JSRuntime.InvokeAsync<T?>("llmProviderApi.request", method, url, body);

    private static string FormatLimit(int value) => value > 0 ? value.ToString("N0") : "未知";

    private static string FormatCapabilities(string? caps)
    {
        if (string.IsNullOrWhiteSpace(caps)) return "未知";
        return caps.Replace("Text", "文本")
            .Replace("ImageInput", "视觉")
            .Replace("AttachmentInput", "附件")
            .Replace("ToolCalls", "工具")
            .Replace("Reasoning", "推理")
            .Replace("StructuredOutput", "结构化");
    }

    private static string FormatReasoningOptions(IReadOnlyList<LlmReasoningOptionDto>? options)
    {
        if (options == null || options.Count == 0) return "—";
        return string.Join(" · ", options.Select(o => o.Type == "toggle" ? "toggle" : $"effort: {string.Join(", ", o.Values ?? [])}"));
    }
}
