    private async Task<T?> RequestAsync<T>(string method, string url, object? body = null)
        => await JSRuntime.InvokeAsync<T?>("llmProviderApi.request", method, url, body);

    private int BuildCapabilities()
        => 1
            | (EditModelImageInput ? 2 : 0)
            | (EditModelAttachmentInput ? 4 : 0)
            | (EditModelToolCalls ? 8 : 0)
            | (EditModelReasoningCap ? 16 : 0)
            | (EditModelStructuredOutput ? 32 : 0);

    private void ApplyCapabilitiesFromString(string? caps)
    {
        EditModelImageInput = false;
        EditModelAttachmentInput = false;
        EditModelToolCalls = false;
        EditModelReasoningCap = false;
        EditModelStructuredOutput = false;
        if (string.IsNullOrWhiteSpace(caps)) return;
        if (int.TryParse(caps.Trim(), out var numeric))
        {
            EditModelImageInput = (numeric & 2) != 0;
            EditModelAttachmentInput = (numeric & 4) != 0;
            EditModelToolCalls = (numeric & 8) != 0;
            EditModelReasoningCap = (numeric & 16) != 0;
            EditModelStructuredOutput = (numeric & 32) != 0;
            return;
        }
        EditModelImageInput = caps.Contains("ImageInput", StringComparison.OrdinalIgnoreCase);
        EditModelAttachmentInput = caps.Contains("AttachmentInput", StringComparison.OrdinalIgnoreCase);
        EditModelToolCalls = caps.Contains("ToolCalls", StringComparison.OrdinalIgnoreCase);
        EditModelReasoningCap = caps.Contains("Reasoning", StringComparison.OrdinalIgnoreCase);
        EditModelStructuredOutput = caps.Contains("StructuredOutput", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatCapabilities(string? caps)
    {
        if (string.IsNullOrWhiteSpace(caps)) return "未知";
        return caps.Replace("Text", "文本")
            .Replace("ImageInput", "视觉")
            .Replace("AttachmentInput", "附件")
            .Replace("ToolCalls", "工具")
            .Replace("Reasoning", "推理")
            .Replace("StructuredOutput", "结构化");
    }

    private void AddReasoningOption()
    {
        if (EditReasoningOptions.Count >= 2) return;
        var hasToggle = EditReasoningOptions.Any(o => o.Type == "toggle");
        var hasEffort = EditReasoningOptions.Any(o => o.Type == "effort");
        if (!hasToggle) EditReasoningOptions.Add(new EditReasoningOption { Type = "toggle" });
        else if (!hasEffort) EditReasoningOptions.Add(new EditReasoningOption { Type = "effort" });
    }

    private void RemoveReasoningOption(int index)
    {
        if (index < 0 || index >= EditReasoningOptions.Count) return;
        EditReasoningOptions.RemoveAt(index);
    }

    private void OnReasoningOptionTypeChanged(int index, string? value)
    {
        if (index < 0 || index >= EditReasoningOptions.Count) return;
        var normalized = value?.Trim().ToLowerInvariant() == "effort" ? "effort" : "toggle";
        if (EditReasoningOptions.Where((o, i) => i != index).Any(o => o.Type == normalized)) return;
        EditReasoningOptions[index].Type = normalized;
        if (normalized == "toggle") EditReasoningOptions[index].ValuesText = string.Empty;
    }

    private void OnReasoningOptionValuesChanged(int index, string? value)
    {
        if (index < 0 || index >= EditReasoningOptions.Count) return;
        EditReasoningOptions[index].ValuesText = value ?? string.Empty;
    }

    private void ApplyReasoningOptions(IReadOnlyList<LlmReasoningOptionDto>? options)
    {
        EditReasoningOptions = [];
        if (options == null || options.Count == 0) return;
        foreach (var o in options)
        {
            if (o == null || string.IsNullOrWhiteSpace(o.Type)) continue;
            var type = o.Type.Trim().ToLowerInvariant();
            if (type != "toggle" && type != "effort") continue;
            if (EditReasoningOptions.Any(x => x.Type == type)) continue;
            var valuesText = o.Values == null || o.Values.Count == 0 ? string.Empty : string.Join(", ", o.Values);
            EditReasoningOptions.Add(new EditReasoningOption { Type = type, ValuesText = type == "toggle" ? string.Empty : valuesText });
        }
    }

    private IReadOnlyList<LlmReasoningOptionDto>? BuildReasoningOptions()
    {
        if (EditReasoningOptions.Count == 0) return null;
        var result = new List<LlmReasoningOptionDto>();
        foreach (var o in EditReasoningOptions)
        {
            var type = o.Type?.Trim().ToLowerInvariant();
            if (type != "toggle" && type != "effort") continue;
            IReadOnlyList<string>? values = null;
            if (type == "effort")
            {
                var parsed = (o.ValuesText ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v.Trim().ToLowerInvariant()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                if (parsed.Count > 0) values = parsed;
            }
            result.Add(new LlmReasoningOptionDto(type, values));
        }
        return result.Count == 0 ? null : result;
    }

    private IEnumerable<string> GetReasoningEffortOptions()
    {
        var effort = EditReasoningOptions.FirstOrDefault(o => o.Type == "effort");
        if (effort != null)
        {
            var parsed = (effort.ValuesText ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v.Trim().ToLowerInvariant()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (parsed.Count > 0) return parsed;
        }
        return ["low", "medium", "high"];
    }

    private static string FormatReasoningOptions(IReadOnlyList<LlmReasoningOptionDto>? options)
    {
        if (options == null || options.Count == 0) return "—";
        return string.Join(" · ", options.Select(o => o.Type == "toggle" ? "toggle" : $"effort: {string.Join(", ", o.Values ?? [])}"));
    }

    private static string FormatLimit(int value) => value > 0 ? value.ToString("N0") : "未知";
    private static string FormatCatalogSource(string source) => source switch
    {
        "local-cache" => "本地缓存",
        "models.dev" => "models.dev（刚刷新）",
