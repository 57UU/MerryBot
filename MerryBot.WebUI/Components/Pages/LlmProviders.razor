@page "/llmproviders"
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JSRuntime

<PageTitle>模型配置</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
    <h1>模型配置</h1>
    <p>models.dev 用于目录导入；真正使用的 API 地址、模型启用状态和 Key 都保存在本机数据库。Key 仅可写入，不会再次显示。</p>
</FluentStack>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <FluentMessageBar Intent="MessageIntent.Error" Style="margin-bottom: 12px;">@Error</FluentMessageBar>
}

<FluentCard Style="margin-bottom: 12px;">
    <h3>本地运行配置</h3>
    @if (Config == null)
    {
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
            <FluentProgressRing />
            <span>加载中…</span>
        </FluentStack>
    }
    else if (Config.Providers.Count == 0)
    {
        <p>暂无已导入的配置。可从页面底部 models.dev 目录导入，或在「手工维护配置」中手动添加。</p>
    }
    else
    {
        @foreach (var provider in Config.Providers)
        {
            <FluentCard Style="margin-bottom: 12px;" @key="provider.Id">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <strong>@provider.Name</strong>
                    <code>@provider.Id</code>
                    <FluentBadge Appearance="Appearance.Neutral">@provider.ApiFormat</FluentBadge>
                    @if (provider.Enabled)
                    {
                        <FluentBadge Appearance="Appearance.Accent">启用</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Neutral">禁用</FluentBadge>
                    }
                    <FluentSpacer />
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => DeleteProviderAsync(provider.Id)">删除 Provider（含模型和 Key）</FluentButton>
                </FluentStack>
                <p><small>@provider.BaseUrl</small></p>

                @if (provider.Keys.Count > 0)
                {
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" Style="margin-top: 8px;">
                        <span>Key</span>
                        @foreach (var key in provider.Keys)
                        {
                            <FluentBadge Appearance="Appearance.Neutral" @key="key.Id">
                                <strong>@key.Name</strong>
                                <code>@key.Fingerprint</code>
                                <FluentButton Appearance="Appearance.Lightweight" Title="删除此 Key" aria-label="删除此 Key" OnClick="() => DeleteKeyAsync(key.Id)">×</FluentButton>
                            </FluentBadge>
                        }
                    </FluentStack>
                }

                @if (provider.Models.Count > 0)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="margin-top: 8px;">
                        @foreach (var model in provider.Models)
                        {
                            <FluentCard @key="model.Id">
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                                            <code>@model.Id</code><span>→</span><code>@model.RemoteModelId</code>
                                            @if (Config.DefaultModelId == model.Id)
                                            {
                                                <FluentBadge Appearance="Appearance.Accent">默认</FluentBadge>
                                            }
                                            @if (!model.Enabled)
                                            {
                                                <FluentBadge Appearance="Appearance.Neutral">禁用</FluentBadge>
                                            }
                                            @if (!string.IsNullOrEmpty(model.ReasoningEffort))
                                            {
                                                <FluentBadge Appearance="Appearance.Neutral">思维 @model.ReasoningEffort</FluentBadge>
                                            }
                                            @if (model.EnablePromptCache)
                                            {
                                                <FluentBadge Appearance="Appearance.Neutral">缓存</FluentBadge>
                                            }
                                        </FluentStack>
                                        <small>
                                            @FormatLimit(model.ContextLength) context · @FormatLimit(model.MaxOutputTokens) output · @FormatCapabilities(model.Capabilities) · @FormatReasoningOptions(model.ReasoningOptions)
                                        </small>
                                    </FluentStack>
                                    <FluentSpacer />
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                        @if (Config.DefaultModelId != model.Id)
                                        {
                                            <FluentButton Appearance="Appearance.Neutral" OnClick="() => SetDefaultAsync(model.Id)">设为默认</FluentButton>
                                        }
                                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => FillManualFormAsync(model)">编辑</FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => DeleteModelAsync(model.Id)">删除模型</FluentButton>
                                    </FluentStack>
                                </FluentStack>
                            </FluentCard>
                        }
                    </FluentStack>
                }
            </FluentCard>
        }
    }
</FluentCard>

@* 手工维护表单：外层 div 保留 ElementReference，供 llmProviderApi.scrollIntoView 定位 *@
<div @ref="ManualFormSection" style="margin-bottom: 12px;">
<FluentCard>
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
        <h3>手工维护配置</h3>
        @if (EditingModelId is not null)
        {
            <span>正在编辑 <code>@EditingModelId</code></span>
            <FluentButton Appearance="Appearance.Neutral" OnClick="ClearManualForm">清空表单</FluentButton>
        }
    </FluentStack>
    <form @onsubmit="SaveProviderAsync" @onsubmit:preventDefault>
        <h5>Provider</h5>
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="12">
            <FluentTextField Label="Provider ID" Placeholder="provider-id，例如 openai-compatible" Required="true" @bind-Value="EditProviderId" />
            <FluentTextField Label="显示名称" Placeholder="显示名称" Required="true" @bind-Value="EditProviderName" />
            <FluentTextField Label="API 地址" Placeholder="https://api.example.com/v1" Required="true" @bind-Value="EditProviderBaseUrl" />
            <FluentSelect TOption="string" Label="API 格式" @bind-Value="EditApiFormat">
                <FluentOption TOption="string" Value="openai-chat-completions">OpenAI Chat Completions（/chat/completions）</FluentOption>
                <FluentOption TOption="string" Value="openai-responses">OpenAI Responses（/responses）</FluentOption>
                <FluentOption TOption="string" Value="anthropic-messages">Anthropic Messages（/v1/messages）</FluentOption>
            </FluentSelect>
        </FluentStack>
        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Style="margin-top: 8px;">保存 Provider</FluentButton>
    </form>

    <form style="margin-top: 12px;" @onsubmit="SaveModelAsync" @onsubmit:preventDefault>
        <h5>模型</h5>
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="12">
            <FluentTextField Label="本地模型 ID" Placeholder="本地模型 ID，例如 provider/model" Required="true" @bind-Value="EditModelId" />
            <FluentTextField Label="Provider ID" Placeholder="Provider ID" Required="true" @bind-Value="EditModelProviderId" />
            <FluentTextField Label="显示名称" Placeholder="显示名称" Required="true" @bind-Value="EditModelName" />
            <FluentTextField Label="上游 model ID" Placeholder="上游 model ID" Required="true" @bind-Value="EditModelRemoteId" />
            <FluentNumberField Label="上下文长度" Placeholder="上下文长度" @bind-Value="EditModelContextLength" />
            <FluentNumberField Label="最大输出" Placeholder="最大输出" @bind-Value="EditModelMaxOutput" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" Style="margin-top: 8px;">
            <span>能力（Capabilities）</span>
            <small>Text 恒为启用；其余按模型实际能力勾选，影响工具调用与多模态路由。</small>
            <FluentCheckbox @bind-Value="EditModelImageInput">视觉输入（ImageInput）</FluentCheckbox>
            <FluentCheckbox @bind-Value="EditModelAttachmentInput">附件输入（AttachmentInput）</FluentCheckbox>
            <FluentCheckbox @bind-Value="EditModelToolCalls">工具调用（ToolCalls）</FluentCheckbox>
            <FluentCheckbox @bind-Value="EditModelReasoningCap">推理（Reasoning）</FluentCheckbox>
            <FluentCheckbox @bind-Value="EditModelStructuredOutput">结构化输出（StructuredOutput）</FluentCheckbox>
        </FluentStack>
        <FluentCheckbox Style="margin-top: 8px;" @bind-Value="EditModelEnabled">启用此模型</FluentCheckbox>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" Style="margin-top: 8px;">
            <span>推理选项（Reasoning Options）</span>
            <small>直接编辑入库的 <code>reasoning_options</code>（来源 models.dev）：<code>toggle</code> 开关 / <code>effort</code> 档位 + 可选值列表；目录导入时自动带入，可手工覆盖。</small>
            @for (var _roIdx = 0; _roIdx < EditReasoningOptions.Count; _roIdx++)
            {
                var _ro = EditReasoningOptions[_roIdx];
                var _idx = _roIdx;
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 4px;" @key="_idx">
                    <FluentSelect TOption="string" Label="类型" Value="@_ro.Type" ValueChanged="@((string v) => OnReasoningOptionTypeChanged(_idx, v))">
                        <FluentOption TOption="string" Value="toggle">toggle（开关）</FluentOption>
                        <FluentOption TOption="string" Value="effort">effort（档位）</FluentOption>
                    </FluentSelect>
                    <FluentTextField Label="可选值" Placeholder="可选值，逗号分隔，如 low, medium, high" Immediate="true" Value="@_ro.ValuesText" ValueChanged="@((string v) => OnReasoningOptionValuesChanged(_idx, v))" Disabled="@(_ro.Type == "toggle")" />
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => RemoveReasoningOption(_idx)">删除</FluentButton>
                </FluentStack>
            }
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 8px;">
                <FluentButton Appearance="Appearance.Neutral" OnClick="AddReasoningOption">添加推理选项</FluentButton>
            </FluentStack>
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="12" Style="margin-top: 8px;">
            <FluentSelect TOption="string" Label="思维强度（Reasoning Effort）" @bind-Value="EditModelReasoningEffort">
                <FluentOption TOption="string" Value="">不开启</FluentOption>
                @foreach (var _eff in GetReasoningEffortOptions())
                {
                    <FluentOption TOption="string" Value="@_eff">@_eff</FluentOption>
                }
            </FluentSelect>
        </FluentStack>
        <small>anthropic 格式映射 thinking 预算（low=4096 / medium=16384 / high=32768）；chat_completions 传 reasoning_effort；responses 传 reasoning.effort；若上方 effort 声明了可选值则仅允许其中档位</small>
        <FluentCheckbox Style="margin-top: 8px;" @bind-Value="EditModelEnablePromptCache">启用 Anthropic Prompt 缓存（cache_control 断点，5m TTL：写入 1.25x / 读取 0.1x；仅 anthropic 格式生效）</FluentCheckbox>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 8px;">
            <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit">保存模型</FluentButton>
        </FluentStack>
    </form>
</FluentCard>
</div>

<FluentCard Style="margin-bottom: 12px;">
    <h3>添加或替换 Provider Key</h3>
    @if (Config?.Providers.Count > 0)
    {
        <form @onsubmit="SaveKeyAsync" @onsubmit:preventDefault>
            <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="12">
                <FluentSelect TOption="string" Label="Provider" @bind-Value="KeyProviderId">
                    @foreach (var provider in Config.Providers)
                    {
                        <FluentOption TOption="string" Value="@provider.Id">@provider.Name (@provider.Id)</FluentOption>
                    }
                </FluentSelect>
                <FluentTextField Label="名称" Placeholder="生产 Key" @bind-Value="KeyName" />
                <FluentTextField Label="API Key" TextFieldType="TextFieldType.Password" AutoComplete="new-password" Required="true" @bind-Value="KeySecret" />
                <FluentNumberField Label="优先级（数字越小越优先）" @bind-Value="KeyPriority" />
            </FluentStack>
            <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Style="margin-top: 8px;">保存 Key</FluentButton>
        </form>
    }
    else
    {
        <p>请先从 models.dev 导入至少一个模型。</p>
    }
</FluentCard>

<FluentCard Style="margin-bottom: 12px;">
    <h3>从 models.dev 添加模型</h3>
    <p>目录优先从本地缓存读取；只有点击“刷新 models.dev”才会联网更新缓存。</p>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="margin-bottom: 12px;">
        <span><strong>步骤 1 · 选择 Provider</strong></span>
        <FluentSearch Immediate="true" Placeholder="例如 OpenCode、OpenAI、DeepSeek" Value="@CatalogProviderQuery" ValueChanged="@(v => OnProviderQueryChanged(new ChangeEventArgs { Value = v }))" />
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
            <FluentButton Appearance="Appearance.Accent" Loading="@IsLoadingCatalog" Disabled="@IsLoadingCatalog" OnClick="SearchProvidersAsync">@(IsLoadingCatalog ? "读取中…" : "搜索 Provider")</FluentButton>
            <FluentButton Appearance="Appearance.Neutral" Disabled="@IsLoadingCatalog" OnClick="RefreshCatalogAsync">刷新 models.dev</FluentButton>
        </FluentStack>
        @if (CatalogStatus is not null)
        {
            <div><small>目录来源：@FormatCatalogSource(CatalogStatus.Source) @if (CatalogStatus.UpdatedAtUtc is { } updatedAt) { <text>· 更新于 @updatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</text> }</small></div>
            @if (!string.IsNullOrWhiteSpace(CatalogStatus.RefreshError))
            {
                <div><small>刷新失败，仍在使用已有缓存：@CatalogStatus.RefreshError</small></div>
            }
        }
    </FluentStack>

    @if (HasSearchedProviders && CatalogProviders.Count == 0)
    {
        <p>没有找到匹配的 Provider。</p>
    }
    else if (CatalogProviders.Count > 0)
    {
        <FluentDataGrid Items="@CatalogProviders.AsQueryable()" Style="margin-bottom: 12px;">
            <PropertyColumn Property="@(p => p.Name)" Title="Provider" Sortable="true" />
            <TemplateColumn Title="ID" Context="catalogProvider"><code>@catalogProvider.Id</code></TemplateColumn>
            <PropertyColumn Property="@(p => p.ModelCount)" Title="可用模型" Sortable="true" />
            <TemplateColumn Title="操作" Context="catalogProvider">
                <FluentButton Appearance="Appearance.Neutral" OnClick="() => SelectProviderAsync(catalogProvider)">选择并查看模型</FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    }

    @if (SelectedCatalogProvider is not null)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" Style="margin-bottom: 12px;">
            <span><strong>步骤 2 · 为 @SelectedCatalogProvider.Name 添加模型</strong></span>
            <div><small><code>@SelectedCatalogProvider.Id</code> · models.dev 收录 @SelectedCatalogProvider.ModelCount 个模型</small></div>
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="12" Style="margin-bottom: 12px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                <FluentSearch Immediate="true" Label="筛选模型（输入即过滤）" Placeholder="例如 gpt、deepseek、flash" Value="@CatalogModelQuery" ValueChanged="@(v => OnModelQueryChanged(new ChangeEventArgs { Value = v }))" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 8px;">
                    <FluentButton Appearance="Appearance.Neutral" Disabled="@IsLoadingCatalog" OnClick="LoadModelsAsync">搜索此 Provider 的模型</FluentButton>
                </FluentStack>
            </FluentStack>
            <FluentTextField Label="首次添加此 Provider 时使用的 API 地址" Placeholder="https://api.example.com/v1" @bind-Value="ImportBaseUrl" />
            <FluentSelect TOption="string" Label="API 格式" @bind-Value="ImportApiFormat">
                <FluentOption TOption="string" Value="openai-chat-completions">OpenAI Chat Completions（/chat/completions）</FluentOption>
                <FluentOption TOption="string" Value="openai-responses">OpenAI Responses（/responses）</FluentOption>
                <FluentOption TOption="string" Value="anthropic-messages">Anthropic Messages（/v1/messages）</FluentOption>
            </FluentSelect>
            <FluentTextField Label="添加模型时一并保存的 API Key（可留空，随后单独添加）" TextFieldType="TextFieldType.Password" AutoComplete="new-password" @bind-Value="ImportApiKey" />
        </FluentStack>
        <p><small>默认采用 models.dev 目录地址；已存在的 Provider 不会被此处覆盖。按 Provider 自动预设，可手动覆盖；已存在的 Provider 不会被覆盖。</small></p>
        @if (HasSearchedModels && CatalogModels.Count == 0)
        {
            <p>这个 Provider 中没有匹配的模型。</p>
        }
        else if (CatalogModels.Count > 0)
        {
            <FluentDataGrid Items="@CatalogModels.AsQueryable()">
                <TemplateColumn Title="模型" Context="catalogModel"><code>@catalogModel.ModelId</code><br /><small>@catalogModel.Name</small></TemplateColumn>
                <TemplateColumn Title="上下文" Context="catalogModel">@FormatLimit(catalogModel.ContextLength)</TemplateColumn>
                <TemplateColumn Title="输出" Context="catalogModel">@FormatLimit(catalogModel.MaxOutputTokens)</TemplateColumn>
                <PropertyColumn Property="@(m => m.Capabilities)" Title="能力" />
                <TemplateColumn Title="推理选项" Context="catalogModel"><small>@FormatReasoningOptions(catalogModel.ReasoningOptions)</small></TemplateColumn>
                <TemplateColumn Title="操作" Context="catalogModel">
                    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
                        <FluentButton Appearance="Appearance.Accent" OnClick="() => ImportAsync(catalogModel)">添加模型</FluentButton>
                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => FillManualFormAsync(catalogModel)">填入编辑表单</FluentButton>
                    </FluentStack>
                </TemplateColumn>
            </FluentDataGrid>
        }
    }
</FluentCard>

@code {
    private LlmConfigSnapshot? Config;
    private List<LlmCatalogProviderDto> CatalogProviders { get; set; } = [];
    private List<LlmCatalogModelDto> CatalogModels { get; set; } = [];
    private LlmCatalogProviderDto? SelectedCatalogProvider { get; set; }
    private LlmCatalogStatusDto? CatalogStatus { get; set; }
    private string CatalogProviderQuery { get; set; } = string.Empty;
    private string CatalogModelQuery { get; set; } = string.Empty;
    private string ImportApiKey { get; set; } = string.Empty;
    private string ImportBaseUrl { get; set; } = string.Empty;
    private string ImportApiFormat { get; set; } = "openai-chat-completions";
    private string KeyProviderId { get; set; } = string.Empty;
    private string KeyName { get; set; } = "API Key";
    private string KeySecret { get; set; } = string.Empty;
    private int KeyPriority { get; set; }
    private string? Error { get; set; }
    private bool IsLoadingCatalog { get; set; }
    private bool HasSearchedProviders { get; set; }
    private bool HasSearchedModels { get; set; }
    private string EditProviderId { get; set; } = string.Empty;
    private string EditProviderName { get; set; } = string.Empty;
    private string EditProviderBaseUrl { get; set; } = string.Empty;
    private string EditApiFormat { get; set; } = "openai-chat-completions";
    private string EditModelId { get; set; } = string.Empty;
    private string EditModelProviderId { get; set; } = string.Empty;
    private string EditModelName { get; set; } = string.Empty;
    private string EditModelRemoteId { get; set; } = string.Empty;
    private int EditModelContextLength { get; set; } = 32_768;
    private int EditModelMaxOutput { get; set; } = 4_096;
    private bool EditModelImageInput { get; set; }
    private bool EditModelAttachmentInput { get; set; }
    private bool EditModelToolCalls { get; set; }
    private bool EditModelReasoningCap { get; set; }
    private bool EditModelStructuredOutput { get; set; }
    private bool EditModelEnabled { get; set; } = true;
    private List<EditReasoningOption> EditReasoningOptions { get; set; } = [];
    private sealed class EditReasoningOption
    {
        public string Type { get; set; } = "toggle";
        public string ValuesText { get; set; } = string.Empty;
    }
    private string EditModelReasoningEffort { get; set; } = string.Empty;
    private bool EditModelEnablePromptCache { get; set; }
    private ElementReference ManualFormSection;

    /// <summary>当前正在编辑的已保存模型 ID；null 表示表单为空白新增状态。</summary>
    private string? EditingModelId;

    // 输入即过滤：防抖计时器，连续输入时只执行最后一次查询
    private CancellationTokenSource? _providerSearchCts;
    private CancellationTokenSource? _modelSearchCts;
    // 请求序号守卫：响应乱序时丢弃过期结果，只应用最后一次查询
    private int _providerSearchSeq;
    private int _modelSearchSeq;

    private bool _initialized;

    // 预渲染阶段无法调用 JS 互操作，首次渲染（交互连接建立）后再加载
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadConfigAsync();
            // 初始加载完整 Provider 列表，输入框实时过滤
            await SearchProvidersAsync();
            StateHasChanged();
        }
    }

    /// <summary>Provider 输入变化：更新查询词并防抖触发搜索。</summary>
    private async Task OnProviderQueryChanged(ChangeEventArgs e)
    {
        CatalogProviderQuery = e.Value?.ToString() ?? string.Empty;
        _providerSearchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _providerSearchCts = cts;
        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // 期间又有新输入，本次查询作废
        }
        await SearchProvidersAsync();
    }

    /// <summary>模型输入变化：更新查询词并防抖触发搜索。</summary>
    private async Task OnModelQueryChanged(ChangeEventArgs e)
    {
        CatalogModelQuery = e.Value?.ToString() ?? string.Empty;
        _modelSearchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _modelSearchCts = cts;
        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await LoadModelsAsync();
    }

    public void Dispose()
    {
        _providerSearchCts?.Cancel();
        _providerSearchCts?.Dispose();
        _modelSearchCts?.Cancel();
        _modelSearchCts?.Dispose();
    }

    private async Task LoadConfigAsync()
    {
        try
        {
            Error = null;
            Config = await RequestAsync<LlmConfigSnapshot>("GET", "/api/plugins/llm-provider/config");
            if (string.IsNullOrWhiteSpace(KeyProviderId))
            {
                KeyProviderId = Config?.Providers.FirstOrDefault()?.Id ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Error = $"无法加载 LLM 配置：{ex.Message}";
        }
    }

    private async Task SearchProvidersAsync()
    {
        var seq = ++_providerSearchSeq;
        try
        {
            Error = null;
            IsLoadingCatalog = true;
            var query = Uri.EscapeDataString(CatalogProviderQuery ?? string.Empty);
            var providers = (await RequestAsync<List<LlmCatalogProviderDto>>("GET", $"/api/plugins/llm-provider/catalog/providers?query={query}")) ?? [];
            if (seq != _providerSearchSeq) return; // 已有更新的查询，丢弃过期结果
            CatalogProviders = providers;
            CatalogStatus = await RequestAsync<LlmCatalogStatusDto>("GET", "/api/plugins/llm-provider/catalog/status");
            if (seq != _providerSearchSeq) return;
            HasSearchedProviders = true;
        }
        catch (Exception ex)
        {
            if (seq != _providerSearchSeq) return;
            Error = $"读取本地 models.dev 目录失败：{ex.Message}";
        }
        finally
        {
            if (seq == _providerSearchSeq) IsLoadingCatalog = false;
        }
    }

    private async Task RefreshCatalogAsync()
    {
        try
        {
            Error = null;
            IsLoadingCatalog = true;
            CatalogStatus = await RequestAsync<LlmCatalogStatusDto>("POST", "/api/plugins/llm-provider/catalog/refresh");
        }
        catch (Exception ex)
        {
            Error = $"刷新 models.dev 失败：{ex.Message}";
        }
        finally
        {
            IsLoadingCatalog = false;
        }

        if (Error is null)
        {
            await SearchProvidersAsync();
            if (SelectedCatalogProvider is not null)
            {
                await LoadModelsAsync();
            }
        }
    }

    private async Task SelectProviderAsync(LlmCatalogProviderDto provider)
    {
        SelectedCatalogProvider = provider;
        CatalogModelQuery = string.Empty;
        CatalogModels = [];
        HasSearchedModels = false;
        ImportBaseUrl = provider.SuggestedBaseUrl ?? string.Empty;
        ImportApiFormat = provider.Id.Equals("anthropic", StringComparison.OrdinalIgnoreCase)
            ? "anthropic-messages"
            : "openai-chat-completions";
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        if (SelectedCatalogProvider is null)
        {
            return;
        }

        var seq = ++_modelSearchSeq;
        try
        {
            Error = null;
            IsLoadingCatalog = true;
            var providerId = Uri.EscapeDataString(SelectedCatalogProvider.Id);
            var query = Uri.EscapeDataString(CatalogModelQuery ?? string.Empty);
            var models = (await RequestAsync<List<LlmCatalogModelDto>>("GET", $"/api/plugins/llm-provider/catalog?providerId={providerId}&query={query}")) ?? [];
            if (seq != _modelSearchSeq) return; // 已有更新的查询，丢弃过期结果
            CatalogModels = models;
            HasSearchedModels = true;
        }
        catch (Exception ex)
        {
            if (seq != _modelSearchSeq) return;
            Error = $"读取 Provider 模型失败：{ex.Message}";
        }
        finally
        {
            if (seq == _modelSearchSeq) IsLoadingCatalog = false;
        }
    }

    private async Task ImportAsync(LlmCatalogModelDto model)
    {
        try
        {
            Error = null;
            Config = await RequestAsync<LlmConfigSnapshot>("POST", "/api/plugins/llm-provider/import",
                new LlmCatalogImportRequest(model.ProviderId, model.ModelId,
                    string.IsNullOrWhiteSpace(ImportBaseUrl) ? model.SuggestedBaseUrl : ImportBaseUrl,
                    ImportApiFormat, ImportApiKey, true));
            ImportApiKey = string.Empty;
            KeyProviderId = model.ProviderId;
        }
        catch (Exception ex)
        {
            Error = $"导入失败：{ex.Message}";
        }
    }

    /// <summary>把 models.dev 目录模型填入「手工维护配置」的模型表单（空白新增态），便于微调后保存。</summary>
    private async Task FillManualFormAsync(LlmCatalogModelDto model)
    {
        EditModelId = MakeLocalModelId(model.ProviderId, model.ModelId);
        EditModelProviderId = model.ProviderId;
        EditModelName = model.Name;
        EditModelRemoteId = model.ModelId;
        EditModelContextLength = model.ContextLength > 0 ? model.ContextLength : 32_768;
        EditModelMaxOutput = model.MaxOutputTokens > 0 ? model.MaxOutputTokens : 4_096;
        ApplyCapabilitiesFromString(model.Capabilities);
        EditModelEnabled = true;
        ApplyReasoningOptions(model.ReasoningOptions);
        EditModelReasoningEffort = string.Empty;
        EditModelEnablePromptCache = false;
        EditingModelId = null;
        await ScrollToManualFormAsync();
    }

    /// <summary>把已导入的本地模型回填到「手工维护配置」的模型表单，便于微调后覆盖保存。</summary>
    private async Task FillManualFormAsync(LlmModelDto model)
    {
        EditingModelId = model.Id;
        EditModelId = model.Id;
        EditModelProviderId = model.ProviderId;
        EditModelName = model.Name;
        EditModelRemoteId = model.RemoteModelId;
        EditModelContextLength = model.ContextLength > 0 ? model.ContextLength : 32_768;
        EditModelMaxOutput = model.MaxOutputTokens > 0 ? model.MaxOutputTokens : 4_096;
        ApplyCapabilitiesFromString(model.Capabilities);
        EditModelEnabled = model.Enabled;
        ApplyReasoningOptions(model.ReasoningOptions);
        EditModelReasoningEffort = model.ReasoningEffort ?? string.Empty;
        EditModelEnablePromptCache = model.EnablePromptCache;
        await ScrollToManualFormAsync();
    }

    private async Task ScrollToManualFormAsync()
