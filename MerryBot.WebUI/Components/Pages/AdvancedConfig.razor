@page "/advanced"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@using MerryBot.WebUI.Api

<PageTitle>高级配置</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
        <div>
            <h1>高级配置</h1>
            <p>查看 / 删除插件数据库（plugin_data.db）中的原始 BSON 数据，用于排查与清理残留数据（如已删除插件遗留的记录）。</p>
        </div>
        <FluentSpacer />
        <FluentButton Appearance="Appearance.Neutral" OnClick="LoadAsync" Disabled="@IsLoading" Loading="@IsLoading">
            @(IsLoading ? "刷新中…" : "刷新")
        </FluentButton>
    </FluentStack>

    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <strong>数据库维护</strong>
            <small>对 plugin_data.db / group_history.db 执行 LiteDB Rebuild（碎片整理），回收空洞并重建索引。执行时阻塞读写，大库可能耗时数秒。</small>
            @if (!string.IsNullOrEmpty(DbSizesText))
            {
                <span>@DbSizesText</span>
            }
            @if (!string.IsNullOrEmpty(RebuildResult))
            {
                <FluentMessageBar Intent="MessageIntent.Success">@RebuildResult</FluentMessageBar>
            }
            @if (!string.IsNullOrEmpty(RebuildError))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@RebuildError</FluentMessageBar>
            }
            <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
                <FluentButton Appearance="Appearance.Neutral" OnClick='() => RebuildAsync("plugin")' Disabled="@IsRebuilding" Loading="@(IsRebuilding && RebuildingTarget == "plugin")">
                    @(IsRebuilding && RebuildingTarget == "plugin" ? "整理中…" : "整理插件库")
                </FluentButton>
                <FluentButton Appearance="Appearance.Neutral" OnClick='() => RebuildAsync("history")' Disabled="@IsRebuilding" Loading="@(IsRebuilding && RebuildingTarget == "history")">
                    @(IsRebuilding && RebuildingTarget == "history" ? "整理中…" : "整理历史库")
                </FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick='() => RebuildAsync("all")' Disabled="@IsRebuilding" Loading="@(IsRebuilding && RebuildingTarget == "all")">
                    @(IsRebuilding && RebuildingTarget == "all" ? "整理中…" : "全部整理")
                </FluentButton>
                <FluentButton Appearance="Appearance.Neutral" OnClick="LoadDbSizesAsync" Disabled="@IsRebuilding">刷新大小</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    @if (Error != null)
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <strong>插件数据（Plugin_Data_Table）</strong>
            <FluentSpacer />
            <small>共 @(DataEntries?.Count ?? 0) 条</small>
        </FluentStack>
        @if (DataEntries == null)
        {
            <FluentProgressRing />
        }
        else if (DataEntries.Count == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">暂无数据。</FluentMessageBar>
        }
        else
        {
            @foreach (var entry in DataEntries)
            {
                <FluentCard>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                        <code>@entry.Id</code>
                        <FluentSpacer />
                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => DeleteEntryAsync(entry, isConfig: false)">删除</FluentButton>
                    </FluentStack>
                    <pre style="white-space:pre-wrap;word-break:break-all;margin:8px 0 0">@entry.Bson</pre>
                </FluentCard>
            }
        }
    </FluentStack>

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <strong>插件配置（Plugin_Config_Table）</strong>
            <FluentSpacer />
            <small>共 @(ConfigEntries?.Count ?? 0) 条</small>
        </FluentStack>
        @if (ConfigEntries == null)
        {
            <FluentProgressRing />
        }
        else if (ConfigEntries.Count == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">暂无数据。</FluentMessageBar>
        }
        else
        {
            @foreach (var entry in ConfigEntries)
            {
                <FluentCard>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                        <code>@entry.Id</code>
                        <FluentSpacer />
                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => DeleteEntryAsync(entry, isConfig: true)">删除</FluentButton>
                    </FluentStack>
                    <pre style="white-space:pre-wrap;word-break:break-all;margin:8px 0 0">@entry.Bson</pre>
                </FluentCard>
            }
        }
    </FluentStack>
</FluentStack>

@code {
    private List<RawEntryDto>? DataEntries;
    private List<RawEntryDto>? ConfigEntries;
    private string? Error;
    private bool IsLoading;
    private bool _initialized;
    private string? DbSizesText;
    private string? RebuildResult;
    private string? RebuildError;
    private bool IsRebuilding;
    private string? RebuildingTarget;

    // 预渲染阶段无法调用 JS 互操作，首次渲染（交互连接建立）后再加载
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadAsync();
            await LoadDbSizesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Error = null;
        try
        {
            DataEntries = await JSRuntime.InvokeAsync<List<RawEntryDto>>("configApi.request", "GET", "/api/advanced/data");
            ConfigEntries = await JSRuntime.InvokeAsync<List<RawEntryDto>>("configApi.request", "GET", "/api/advanced/config");
        }
        catch (Exception ex)
        {
            Error = $"加载失败：{ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task DeleteEntryAsync(RawEntryDto entry, bool isConfig)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"确定删除 [{entry.Id}] ？此操作不可恢复。"))
        {
            return;
        }
        try
        {
            string api = isConfig ? "/api/advanced/config/delete" : "/api/advanced/data/delete";
            // id 含 "/"（如 plugin/agent），经 query 传递（服务端会正确解码）
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", $"{api}?id={Uri.EscapeDataString(entry.Id)}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Error = $"删除失败：{ex.Message}";
        }
    }

    private async Task LoadDbSizesAsync()
    {
        try
        {
            var sizes = await JSRuntime.InvokeAsync<DatabaseSizesPayload>("configApi.request", "GET", "/api/database/sizes");
            DbSizesText = $"插件库：{sizes.PluginDbSize}  ·  历史库：{sizes.HistoryDbSize}";
        }
        catch (Exception ex)
        {
            DbSizesText = $"大小加载失败：{ex.Message}";
        }
    }

    private async Task RebuildAsync(string target)
    {
        string label = target == "plugin" ? "插件库 (plugin_data.db)" : target == "history" ? "历史库 (group_history.db)" : "全部数据库";
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"确定要整理 {label} 吗？\n整理期间数据库会被独占，操作可能耗时数秒。")) return;
        IsRebuilding = true;
        RebuildingTarget = target;
        RebuildResult = null;
        RebuildError = null;
        try
        {
            var results = await JSRuntime.InvokeAsync<List<RebuildResultPayload>>("configApi.request", "POST", "/api/database/rebuild", new { target });
            if (results == null || results.Count == 0) RebuildResult = "整理完成，未返回结果。";
            else RebuildResult = string.Join("； ", results.Select(r => $"{r.Target}: {r.BeforeSize} → {r.AfterSize}，{r.ReducedSize}"));
            await LoadDbSizesAsync();
        }
        catch (Exception ex)
        {
            RebuildError = $"整理失败：{ex.Message}";
        }
        finally
        {
            IsRebuilding = false;
            RebuildingTarget = null;
        }
    }

    private sealed class DatabaseSizesPayload
    {
        public long PluginDbBytes { get; set; }
        public string PluginDbSize { get; set; } = "";
        public long HistoryDbBytes { get; set; }
        public string HistoryDbSize { get; set; } = "";
    }

    private sealed class RebuildResultPayload
    {
        public string Target { get; set; } = "";
        public long BeforeBytes { get; set; }
        public string BeforeSize { get; set; } = "";
        public long AfterBytes { get; set; }
        public string AfterSize { get; set; } = "";
        public long ReducedBytes { get; set; }
        public string ReducedSize { get; set; } = "";
    }
}
