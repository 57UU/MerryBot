@page "/statistics"
@rendermode InteractiveServer
@using DataService
@using BotPlugin
@using DataProvider
@using MerryBot.WebUI.Api
@using Microsoft.Extensions.Logging
@inject HistoryRecorder HistoryRecorder
@inject PluginStorageDatabase PluginDatabase
@inject ILogger<Statistics> Logger
@inject IJSRuntime JSRuntime

<PageTitle>数据统计</PageTitle>

<h1>数据统计</h1>
<p>历史消息与存储占用统计，统计逐群计数，加载可能需要一些时间。</p>

<h2>消息统计</h2>
<FluentGrid Spacing="3" Style="margin-bottom:12px;width:100%;">
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.People())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@(IsLoadingStats ? "—" : GroupCount.ToString())</strong>
                <span>活跃群聊</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Chat())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@(IsLoadingStats ? "—" : MessageCount.ToString())</strong>
                <span>群聊消息数</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Bot())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@(IsLoadingStats ? "—" : AiMessageCount.ToString())</strong>
                <span>AI 消息数</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Image())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@(IsLoadingStats ? "—" : ImageCount.ToString())</strong>
                <span>图片数量</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Box())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@(IsLoadingStats ? "—" : FileCount.ToString())</strong>
                <span>文件/视频/语音</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

<h2>存储占用</h2>
<FluentGrid Spacing="3" Style="margin-bottom:12px;width:100%;">
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Database())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@GroupHistoryDbSize</strong>
                <span>群聊历史库</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Database())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@PluginDbSize</strong>
                <span>插件数据库</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Image())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@ImageStorageSize</strong>
                <span>图片存储</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" lg="4" xl="2">
        <FluentCard Style="height:100%;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Size20.Box())" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <strong>@FileStorageSize</strong>
                <span>文件存储</span>
            </FluentStack>
        </FluentStack>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

<h2>数据库维护</h2>
<FluentCard>
    <p>LiteDB 碎片整理（Rebuild）：重写整个数据库文件，回收删除/更新产生的空洞并重建索引，可减小文件体积。执行期间会阻塞数据库读写，大库可能耗时数秒，请勿频繁操作。</p>
    @if (!string.IsNullOrEmpty(RebuildError))
    {
        <FluentMessageBar Intent="MessageIntent.Error">@RebuildError</FluentMessageBar>
    }
    @if (!string.IsNullOrEmpty(RebuildMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Info">@RebuildMessage</FluentMessageBar>
    }
    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
        <FluentButton Appearance="Appearance.Neutral" Disabled="@IsRebuilding" Loading="@(IsRebuilding && RebuildingTarget == "history")" OnClick='() => RebuildAsync("history")'>
            @(IsRebuilding && RebuildingTarget == "history" ? "整理中…" : "整理历史库")
        </FluentButton>
        <FluentButton Appearance="Appearance.Neutral" Disabled="@IsRebuilding" Loading="@(IsRebuilding && RebuildingTarget == "plugin")" OnClick='() => RebuildAsync("plugin")'>
            @(IsRebuilding && RebuildingTarget == "plugin" ? "整理中…" : "整理插件库")
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent" Disabled="@IsRebuilding" Loading="@(IsRebuilding && RebuildingTarget == "all")" OnClick='() => RebuildAsync("all")'>
            @(IsRebuilding && RebuildingTarget == "all" ? "整理中…" : "全部整理")
        </FluentButton>
        <FluentButton Appearance="Appearance.Neutral" Disabled="@IsRebuilding" OnClick="LoadDbSizesAsync">刷新大小</FluentButton>
    </FluentStack>
</FluentCard>

@code {
    private List<long> GroupIds { get; set; } = new List<long>();
    private int GroupCount { get; set; } = 0;
    private int MessageCount { get; set; } = 0;
    private int AiMessageCount { get; set; } = 0;
    private int ImageCount { get; set; } = 0;
    private int FileCount { get; set; } = 0;
    private string GroupHistoryDbSize { get; set; } = "加载中";
    private string PluginDbSize { get; set; } = "加载中";
    private string ImageStorageSize { get; set; } = "加载中";
    private string FileStorageSize { get; set; } = "加载中";

    private bool IsLoadingStats { get; set; } = true;
    private bool IsRebuilding { get; set; }
    private string? RebuildingTarget { get; set; }
    private string? RebuildMessage { get; set; }
    private string? RebuildError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupIds();
        // LoadStatistics 依赖 GroupIds；LoadDbSizesAsync 与统计无依赖，并行执行
        var statsTask = LoadStatistics();
        var sizesTask = LoadDbSizesAsync();
        await Task.WhenAll(statsTask, sizesTask);
    }

    private async Task LoadGroupIds()
    {
        try
        {
            GroupIds = await HistoryRecorder.GetAllGroupIdsAsync();
            GroupCount = GroupIds.Count;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载群聊列表失败");
            GroupIds = new List<long>();
            GroupCount = 0;
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            // 消息计数：使用 CountAsync，避免逐群拉取 1000 条消息
            MessageCount = 0;
            foreach (var gid in GroupIds)
            {
                MessageCount += await HistoryRecorder.GetMessageCountByGroupIdAsync(gid);
            }

            AiMessageCount = 0;
            foreach (var gid in GroupIds)
            {
                AiMessageCount += await HistoryRecorder.AiMessages.GetAiMessageCountBySessionKeyAsync(SessionKey.ToString(gid));
            }

            ImageCount = await HistoryRecorder.GetImageCountAsync();
            FileCount = await HistoryRecorder.GetFileCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载统计数据失败");
        }
        finally
        {
            IsLoadingStats = false;
        }
    }

    private async Task LoadDbSizesAsync()
    {
        try
        {
            // 直连进程内数据库查大小，不再经 JS fetch 回调 HTTP API
            DatabaseSizesDto sizes = DatabaseMaintenanceService.GetSizes(PluginDatabase, HistoryRecorder);
            GroupHistoryDbSize = sizes.HistoryDbSize;
            PluginDbSize = sizes.PluginDbSize;
            ImageStorageSize = await HistoryRecorder.GetImageStorageSizeAsync();
            FileStorageSize = await HistoryRecorder.GetFileStorageSizeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载文件大小失败");
            GroupHistoryDbSize = "加载失败";
            PluginDbSize = "加载失败";
            ImageStorageSize = "加载失败";
            FileStorageSize = "加载失败";
        }
    }

    private async Task RebuildAsync(string target)
    {
        string label = target == "plugin" ? "插件库 (plugin_data.db)" : target == "history" ? "历史库 (group_history.db)" : "全部数据库";
        bool confirmed;
        try
        {
            confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"确定要整理 {label} 吗？\n\n整理期间数据库会被独占，操作可能耗时数秒。");
        }
        catch
        {
            confirmed = false;
        }
        if (!confirmed) return;

        IsRebuilding = true;
        RebuildingTarget = target;
        RebuildMessage = null;
        RebuildError = null;
        try
        {
            IReadOnlyList<RebuildResultDto> results = await DatabaseMaintenanceService.RebuildAsync(PluginDatabase, HistoryRecorder, target);
            if (results.Count == 0)
            {
                RebuildMessage = "整理完成，未返回结果。";
            }
            else
            {
                RebuildMessage = string.Join("； ", results.Select(r => $"{r.Target}: {r.BeforeSize} → {r.AfterSize}，{r.ReducedSize}"));
            }
            await LoadDbSizesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "数据库整理失败");
            RebuildError = $"整理失败：{ex.Message}";
        }
        finally
        {
            IsRebuilding = false;
            RebuildingTarget = null;
        }
    }
}
