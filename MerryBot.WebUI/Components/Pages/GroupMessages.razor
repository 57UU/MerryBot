@page "/groupmessages"
@using DataService
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject HistoryRecorder HistoryRecorder

<PageTitle>群聊记录</PageTitle>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="height: 100%;">
	@* 左侧群聊列表 *@
	<div style="width: 280px; flex-shrink: 0;">
		<GroupListPanel SelectedGroupId="SelectedGroupId"
						OnGroupSelected="OnGroupSelected"
						OnLoaded="OnGroupsLoaded" />
	</div>

	@* 右侧消息展示 *@
	<div style="flex-grow: 1; min-width: 0; height: 100%;">
		<PagedMessageContainer TItem="GroupMessage"
							   ElementId="group-message-container"
							   Key="@(SelectedGroupId > 0 ? SelectedGroupId.ToString() : string.Empty)"
							   EmptySelectionHint="请从左侧选择一个群聊"
							   EmptyText="暂无消息"
							   LoadBeforeAsync="LoadGroupMessagesBefore"
							   AnchorSelector="GetGroupMessageAnchor">
			<HeaderContent>
				@if (SelectedGroupId > 0)
				{
					@if (GroupNames.TryGetValue(SelectedGroupId, out var groupInfo) &&
							!string.IsNullOrEmpty(groupInfo.Name))
					{
						<span>@groupInfo.Name (@SelectedGroupId) - 成员: @groupInfo.MemberCount/@groupInfo.MaxMemberCount |
							更新于: @groupInfo.UpdatedTime.ToString("yyyy-MM-dd HH:mm")</span>
					}
					else
					{
						<span>群聊 @SelectedGroupId 的消息</span>
					}
				}
				else
				{
					<span>请选择一个群聊</span>
				}
			</HeaderContent>
			<BodyContent>
				@foreach (var message in context)
				{
					@* sender *@
					<FluentCard Style="margin-bottom: 12px;">
						<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
							<strong>@message.SenderNickname</strong>
							<span>@message.SenderId
								@(!string.IsNullOrEmpty(message.SenderGroupNickname) ?
									$"({message.SenderGroupNickname})" : "")
							</span>
							<FluentSpacer />
							<span style="font-size: 12px; color: var(--neutral-foreground-hint);">
								@message.MessageId &nbsp;
								@message.Time.ToString("yyyy-MM-dd HH:mm:ss")
							</span>
						</FluentStack>
						@* content *@
						<div style="margin-top: 8px;">
							@if (message.IsDeleted)
							{
								<FluentMessageBar Intent="MessageIntent.Warning">已撤回</FluentMessageBar>
							}
							@foreach (var msg in message.Messages)
							{
								<MessageRenderer Msg="msg" Mode="MessageRenderMode.Inline" OnForwardClick="OpenForwardModal" />
							}
						</div>
					</FluentCard>
				}
			</BodyContent>
		</PagedMessageContainer>
	</div>
</FluentStack>

@* 转发消息浮层：id 与 openForwardModal/closeForwardModal JS 互操作绑定，样式内联 *@
<div id="forward-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1000; justify-content: center; align-items: center;"
	role="dialog" aria-modal="true" aria-labelledby="forward-modal-title"
	@onkeydown="OnModalKeyDown">
	<div style="background: var(--neutral-layer-1); border: 1px solid var(--neutral-stroke-rest); border-radius: 8px; width: 80%; height: 80%; max-width: 1000px; max-height: 800px; display: flex; flex-direction: column; overflow: hidden;">
		<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="padding: 8px 16px; border-bottom: 1px solid var(--neutral-stroke-rest);">
			<span id="forward-modal-title">转发消息</span>
			<FluentSpacer />
			<button type="button" aria-label="关闭" onclick="closeForwardModal()" style="border:0;background:transparent;font-size:1.2rem;cursor:pointer;">×</button>
		</FluentStack>
		<iframe id="forward-iframe" title="转发消息内容" style="flex: 1; border: 0; width: 100%;"></iframe>
	</div>
</div>

@code {
	private long SelectedGroupId { get; set; } = 0;

	private IReadOnlyDictionary<long, GroupNameEntry> GroupNames { get; set; } = new Dictionary<long, GroupNameEntry>();

	private Task OnGroupsLoaded(GroupListContext context)
	{
		GroupNames = context.GroupNames;
		// 首次进入自动选中第一个群聊
		if (SelectedGroupId == 0 && context.GroupIds.Any())
		{
			SelectedGroupId = context.GroupIds[0];
		}
		return Task.CompletedTask;
	}

	private Task OnGroupSelected(long groupId)
	{
		if (SelectedGroupId == groupId) return Task.CompletedTask;
		SelectedGroupId = groupId;
		return Task.CompletedTask;
	}

	private Task<List<GroupMessage>> LoadGroupMessagesBefore(long? beforeMessageId, int pageSize)
		=> HistoryRecorder.GetMessagesByGroupIdBeforeAsync(SelectedGroupId, beforeMessageId, pageSize);

	private static long GetGroupMessageAnchor(GroupMessage message) => message.MessageId;

	private async Task OpenForwardModal(string forwardId)
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("openForwardModal", forwardId);
		}
		catch (JSDisconnectedException)
		{
			// 电路已断开，忽略
		}
	}

	private async Task OnModalKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Escape")
		{
			await JSRuntime.InvokeVoidAsync("closeForwardModal");
		}
	}
}
