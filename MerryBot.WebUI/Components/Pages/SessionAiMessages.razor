@page "/sessionai"
@using CommonLib
@using DataService
@rendermode InteractiveServer
@inject IContextSnapshotService SnapshotService
@inject HistoryRecorder HistoryRecorder
@inject IJSRuntime JSRuntime

<PageTitle>会话快照</PageTitle>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="height: 100%;">
    @* 左侧 session 列表 *@
    <div style="width: 280px; flex-shrink: 0;">
        <SelectableList TItem="ContextSessionDto"
                        Title="Session 列表"
                        Items="Sessions"
                        GetKey="@(session => session.SessionKey)"
                        SelectedKey="@SelectedSessionKey"
                        OnSelected="SelectSessionAsync"
                        RowTitle="@(session => session.DisplayName)"
                        RowSub="@(session => $"{session.MessageCount} 条 · {session.UpdatedAtUtc.LocalDateTime:yyyy-MM-dd HH:mm}")"
                        LoadingText="加载 session 列表中..."
                        EmptyText="暂无上下文快照。"
                        LoadError="@LoadError"
                        OnRetry="LoadSessionsAsync"
                        ListMaxHeight="80vh"
                        CardStyle="height: 100%;" />
    </div>

    @* 右侧上下文展示 *@
    <div style="flex-grow: 1; min-width: 0;">
        <FluentCard Style="height: 100%;">
            @if (!string.IsNullOrEmpty(SelectedSessionKey))
            {
                <strong>@SelectedSessionKey 的当前上下文</strong>
            }
            else
            {
                <strong>请选择一个 session</strong>
            }
            <div style="max-height: 90vh; overflow: auto; margin-top: 8px;" id="snapshot-scroll">
                @if (LoadError != null && Snapshot is null)
                {
                    <FluentMessageBar Intent="MessageIntent.Error">@LoadError</FluentMessageBar>
                }
                else if (Snapshot is null && !string.IsNullOrEmpty(SelectedSessionKey))
                {
                    @if (SnapshotLoading)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                            <FluentProgressRing />
                            <span>加载中…</span>
                        </FluentStack>
                    }
                    else
                    {
                        <p style="text-align: center; margin-top: 48px;">该 session 暂无上下文快照。</p>
                    }
                }
                else if (Snapshot is null)
                {
                    <p style="text-align: center; margin-top: 48px;">请从左侧选择一个 session</p>
                }
                else if (Snapshot.Messages.Count == 0)
                {
                    <p style="text-align: center; margin-top: 48px;">上下文为空（可能是刚压缩或重置过）。</p>
                }
                else
                {
                    @foreach (var message in Snapshot.Messages)
                    {
                        <FluentCard Style="margin-bottom: 12px;">
                            <FluentBadge Appearance="Appearance.Accent">@message.Role</FluentBadge>
                            <div style="margin-top: 8px;">
                                @if (!string.IsNullOrEmpty(message.Content))
                                {
                                    <div>@message.Content</div>
                                }
                                @if (message.ToolCalls.Count > 0)
                                {
                                    <div style="font-size: 12px; color: var(--neutral-foreground-hint); margin-top: 4px;">
                                        工具调用：
                                        @foreach (var call in message.ToolCalls)
                                        {
                                            <div>· @(call.Name)(@(call.Arguments))</div>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(message.ReasoningContent))
                                {
                                    <div style="font-size: 12px; color: var(--neutral-foreground-hint); margin-top: 4px;">
                                        <details>
                                            <summary>思维链</summary>
                                            <div style="white-space: pre-wrap;">@message.ReasoningContent</div>
                                        </details>
                                    </div>
                                }
                            </div>
                        </FluentCard>
                    }
                    <div style="font-size: 12px; color: var(--neutral-foreground-hint); margin-top: 8px;">
                        快照时间：@Snapshot.UpdatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                    </div>
                }
            </div>
        </FluentCard>
    </div>
</FluentStack>

@code {
    private List<ContextSessionDto>? Sessions;
    private string SelectedSessionKey { get; set; } = string.Empty;
    private ContextSnapshotDetail? Snapshot;
    private bool SnapshotLoading;
    private string? LoadError;
    private bool _scrollToBottomPending;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionsAsync();
        if (Sessions is { Count: > 0 })
        {
            await SelectSessionAsync(Sessions[0].SessionKey);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 快照渲染完成后滚动到消息最底端（最新消息）；预渲染阶段 JS 不可用时忽略，
        // 交互式实例初始化时会再次触发
        if (_scrollToBottomPending)
        {
            _scrollToBottomPending = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("configApi.scrollToBottom", "snapshot-scroll");
            }
            catch
            {
                // 忽略（预渲染阶段 JS 互操作不可用）
            }
        }
    }

    private async Task LoadSessionsAsync()
    {
        try
        {
            LoadError = null;
            // 服务端组件直接注入服务读取（不经过 JS 互操作 + HTTP 回调），
            // 大快照 JSON 不会因 SignalR 32KB 消息上限导致断连/取消
            var sessions = await SnapshotService.ListSessionsAsync();
            var names = (await HistoryRecorder.GetAllGroupNamesAsync())
                .GroupBy(item => item.GroupId)
                .ToDictionary(g => g.Key, g => g.First().Name);
            Sessions = sessions
                .Select(session => new ContextSessionDto(
                    session.SessionKey,
                    GetDisplayName(session.SessionKey, names),
                    session.MessageCount,
                    session.UpdatedAtUtc))
                .ToList();
        }
        catch (Exception exception)
        {
            LoadError = $"加载 session 列表失败: {exception.Message}";
        }
    }

    private async Task SelectSessionAsync(string sessionKey)
    {
        if (SelectedSessionKey == sessionKey && Snapshot is not null) return;
        SelectedSessionKey = sessionKey;
        Snapshot = null;
        SnapshotLoading = true;
        try
        {
            Snapshot = await SnapshotService.GetSnapshotAsync(sessionKey);
            LoadError = null;
            _scrollToBottomPending = true;
        }
        catch (Exception exception)
        {
            LoadError = $"加载上下文失败: {exception.Message}";
        }
        finally
        {
            SnapshotLoading = false;
        }
    }

    private static string GetDisplayName(string sessionKey, IReadOnlyDictionary<long, string> names)
    {
        var parts = sessionKey.Split('/', StringSplitOptions.None);
        if (parts is ["qq", "group", var id] && long.TryParse(id, out var groupId))
        {
            return names.TryGetValue(groupId, out var name) && !string.IsNullOrWhiteSpace(name)
                ? $"{name} ({groupId})"
                : $"群 {groupId}";
        }
        return sessionKey;
    }
}
