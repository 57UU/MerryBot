@page "/config"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@using System.Globalization
@using System.Text.Json

<PageTitle>配置中心</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <div>
        <h1>配置中心</h1>
        <p>在这里维护核心与已加载插件注册的配置。每个配置文件单独保存，修改需要重启才能生效的字段请随后重启 bot。</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }

    @if (Snapshot is null)
    {
        <FluentProgressRing />
    }
    else if (Snapshot.Sections.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">没有已注册的配置。</FluentMessageBar>
    }
    else
    {
        <FluentGrid Style="width:100%;">
            <FluentGridItem xs="12" md="3" Style="align-self:start;">
                <SelectableList TItem="ConfigSectionDto"
                                Title="配置文件"
                                Items="Snapshot.Sections"
                                GetKey="@(section => section.Id)"
                                OnSelected="ScrollToAsync"
                                RowTitle="@(section => section.Name)"
                                ShowCount="false" />
            </FluentGridItem>

            <FluentGridItem xs="12" md="9">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" HorizontalAlignment="HorizontalAlignment.Stretch">
                    @foreach (var section in Snapshot.Sections)
                    {
                        <section id="@SectionElementId(section.Id)" @key="section.Id">
                            <FluentCard Style="width:100%;">
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                    <strong>@(section.Name)</strong>
                                    @if (!string.IsNullOrWhiteSpace(section.Description))
                                    {
                                        <span>@(section.Description)</span>
                                    }

                                    @foreach (var field in section.Fields)
                                    {
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" @key="field.Key">

                                    @switch (field.Type)
                                    {
                                        case "string" when IsLlmModelField(field):
                                            <FluentTextField Label="@field.Name" DataList="saved-llm-models" Style="width:100%;"
                                                   Value="@GetText(section.Id, field.Key)"
                                                   ValueChanged="@(v => SetText(section.Id, field.Key, v ?? string.Empty))" />
                                            <small>可从已保存的模型中选择，也可以直接输入模型 ID。</small>
                                            break;
                                        case "string" when IsPromptField(field):
                                            <FluentTextArea Label="@field.Name" Rows="8" Style="width:100%;"
                                                    Value="@GetText(section.Id, field.Key)"
                                                    ValueChanged="@(v => SetText(section.Id, field.Key, v ?? string.Empty))" />
                                            break;
                                        case "string":
                                            <FluentTextField Label="@field.Name" Style="width:100%;"
                                                   Value="@GetText(section.Id, field.Key)"
                                                   ValueChanged="@(v => SetText(section.Id, field.Key, v ?? string.Empty))" />
                                            break;
                                        case "number":
                                            <FluentTextField Label="@field.Name" TextFieldType="TextFieldType.Number" Style="width:100%;"
                                                   Value="@GetText(section.Id, field.Key)"
                                                   ValueChanged="@(v => SetText(section.Id, field.Key, v ?? string.Empty))" />
                                            break;
                                        case "boolean":
                                            <FluentCheckbox Label="@field.Name" Value="@GetBoolean(section.Id, field.Key)"
                                                  ValueChanged="@(v => SetBoolean(section.Id, field.Key, v))" />
                                            break;
                                        case "enum":
                                            <FluentLabel>@field.Name</FluentLabel>
                                            <FluentSelect TOption="string" Style="width:100%;"
                                                Items="@(field.EnumOptions ?? [])"
                                                OptionText="@(option => option)"
                                                OptionValue="@(option => option)"
                                                SelectedOption="@GetText(section.Id, field.Key)"
                                                SelectedOptionChanged="@(v => SetText(section.Id, field.Key, v ?? string.Empty))" />
                                            break;
                                        case "list":
                                            <FluentTextArea Label="@field.Name" Rows="4" Style="width:100%;"
                                                    Value="@GetText(section.Id, field.Key)"
                                                    ValueChanged="@(v => SetListText(section.Id, field.Key, v))" />
                                            <small>请使用 JSON 数组，例如 <code>[123, 456]</code>。</small>
                                            break;
                                        case "stringlist":
                                            <FluentLabel>@field.Name</FluentLabel>
                                            @foreach (var (item, index) in GetStringList(section.Id, field.Key).Select((value, i) => (value, i)))
                                            {
                                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                                                    <FluentTextField Value="@item" Style="flex:1"
                                                           ValueChanged="@(v => SetStringListItem(section.Id, field.Key, index, v ?? string.Empty))" />
                                                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => RemoveStringListItem(section.Id, field.Key, index)">删除</FluentButton>
                                                </FluentStack>
                                            }
                                            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                                                <FluentTextField DataList="saved-llm-models" Placeholder="选择或输入模型 ID" Style="flex:1"
                                                       Value="@GetStringListDraft(section.Id, field.Key)"
                                                       ValueChanged="@(v => SetStringListDraft(section.Id, field.Key, v ?? string.Empty))" />
                                                <FluentButton Appearance="Appearance.Accent" OnClick="() => AddStringListItem(section.Id, field.Key)">添加</FluentButton>
                                            </FluentStack>
                                            <small>按顺序使用；某个模型失效时自动切换到下一个。</small>
                                            break;
                                    }
                                    @if (!string.IsNullOrWhiteSpace(field.Description))
                                    {
                                        <small>@field.Description</small>
                                    }
                                </FluentStack>
                            }

                                    @if (SaveErrors.TryGetValue(section.Id, out var saveError))
                                    {
                                        <FluentMessageBar Intent="MessageIntent.Error">@saveError</FluentMessageBar>
                                    }
                                    @if (SaveStatus.TryGetValue(section.Id, out var saveStatus))
                                    {
                                        <FluentMessageBar Intent="MessageIntent.Success">@saveStatus</FluentMessageBar>
                                    }
                                    <div>
                                        <FluentButton Appearance="Appearance.Accent" OnClick="() => SaveAsync(section)"
                                                      Disabled="@(SavingSectionId == section.Id)" Loading="@(SavingSectionId == section.Id)">
                                            @(SavingSectionId == section.Id ? "保存中…" : "保存此配置")
                                        </FluentButton>
                                    </div>
                                </FluentStack>
                            </FluentCard>
                        </section>
                    }
                </FluentStack>
            </FluentGridItem>
        </FluentGrid>
        <datalist id="saved-llm-models">
            @foreach (var modelId in LlmModelIds)
            {
                <option value="@modelId"></option>
            }
        </datalist>
    }
</FluentStack>

@code {
    private ConfigPanelDto? Snapshot;
    private readonly Dictionary<string, Dictionary<string, object?>> Edits = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> SaveErrors = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> SaveStatus = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> StringListDrafts = new(StringComparer.Ordinal);
    private IReadOnlyList<string> LlmModelIds = [];
    private string? Error;
    private string? SavingSectionId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            Error = null;
            var configTask = JSRuntime.InvokeAsync<ConfigPanelDto>("configApi.request", "GET", "/api/config").AsTask();
            var llmModelsTask = JSRuntime.InvokeAsync<LlmConfigSnapshot>("configApi.request", "GET", "/api/plugins/llm-provider/config").AsTask();
            Snapshot = await configTask;
            try
            {
                var llmConfiguration = await llmModelsTask;
                LlmModelIds = llmConfiguration.Providers
                    .SelectMany(provider => provider.Models)
                    .Select(model => model.Id)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(modelId => modelId, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            catch
            {
                // LLM Provider 插件未加载或请求失败时，模型字段仍允许手工编辑。
                LlmModelIds = [];
            }
            Edits.Clear();
            SaveErrors.Clear();
            SaveStatus.Clear();
            StringListDrafts.Clear();
            foreach (var section in Snapshot.Sections)
            {
                Edits[section.Id] = section.Fields.ToDictionary(field => field.Key, NormalizeValue, StringComparer.Ordinal);
            }
        }
        catch (Exception ex)
        {
            Error = $"无法加载配置: {ex.Message}";
        }
    }

    private static object? NormalizeValue(ConfigFieldDto field)
    {
        if (field.Value is not JsonElement value)
        {
            return field.Type switch
            {
                "number" => Convert.ToString(field.Value, CultureInfo.InvariantCulture) ?? string.Empty,
                "list" => JsonSerializer.Serialize(field.Value),
                "stringlist" => new List<string>(),
                _ => field.Value,
            };
        }

        return field.Type switch
        {
            "string" or "enum" => value.ValueKind == JsonValueKind.Null ? string.Empty : value.GetString() ?? string.Empty,
            "number" => value.GetRawText(),
            "boolean" => value.ValueKind is JsonValueKind.True or JsonValueKind.False && value.GetBoolean(),
            "list" => value.GetRawText(),
            "stringlist" => value.ValueKind == JsonValueKind.Array
                ? value.EnumerateArray()
                    .Select(item => item.GetString() ?? string.Empty)
                    .Where(static item => !string.IsNullOrWhiteSpace(item))
                    .ToList()
                : new List<string>(),
            _ => null,
        };
    }

    private string GetText(string sectionId, string key)
        => Edits.TryGetValue(sectionId, out var section)
            && section.TryGetValue(key, out var value)
            ? Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty
            : string.Empty;

    private bool GetBoolean(string sectionId, string key)
        => Edits.TryGetValue(sectionId, out var section)
            && section.TryGetValue(key, out var value)
            && value is bool boolean
            && boolean;

    private void SetText(string sectionId, string key, string value)
        => Edits[sectionId][key] = value;

    private void SetBoolean(string sectionId, string key, bool value)
        => Edits[sectionId][key] = value;

    private void SetListText(string sectionId, string key, string? value)
        => SetText(sectionId, key, value ?? "[]");

    // ── stringlist（字符串列表）控件 ──────────────────────────────────────────

    private static string StringListDraftKey(string sectionId, string key) => $"{sectionId}|{key}";

    private IReadOnlyList<string> GetStringList(string sectionId, string key)
        => Edits.TryGetValue(sectionId, out var section)
            && section.TryGetValue(key, out var value)
            && value is List<string> list
            ? list
            : [];

    private void SetStringListItem(string sectionId, string key, int index, string value)
    {
        if (Edits.TryGetValue(sectionId, out var section)
            && section.TryGetValue(key, out var current)
            && current is List<string> list
            && index >= 0
            && index < list.Count)
        {
            list[index] = value;
        }
    }

    private void AddStringListItem(string sectionId, string key)
    {
        var draft = GetStringListDraft(sectionId, key).Trim();
        if (draft.Length == 0)
        {
            return;
        }
        var list = GetStringList(sectionId, key) as List<string>;
        if (list is null)
        {
            list = [];
            Edits[sectionId][key] = list;
        }
        list.Add(draft);
        SetStringListDraft(sectionId, key, string.Empty);
    }

    private void RemoveStringListItem(string sectionId, string key, int index)
    {
        if (Edits.TryGetValue(sectionId, out var section)
            && section.TryGetValue(key, out var current)
            && current is List<string> list
            && index >= 0
            && index < list.Count)
        {
            list.RemoveAt(index);
        }
    }

    private string GetStringListDraft(string sectionId, string key)
        => StringListDrafts.TryGetValue(StringListDraftKey(sectionId, key), out var draft) ? draft : string.Empty;

    private void SetStringListDraft(string sectionId, string key, string value)
        => StringListDrafts[StringListDraftKey(sectionId, key)] = value;

    private static bool IsLlmModelField(ConfigFieldDto field)
        => field.Type == "string"
            && field.Key.Contains("LlmModel", StringComparison.OrdinalIgnoreCase);

    /// <summary>prompt 类字段内容较长，单行输入框写不下，使用多行 textarea 渲染。</summary>
    private static bool IsPromptField(ConfigFieldDto field)
        => field.Type == "string"
            && field.Key.Contains("Prompt", StringComparison.OrdinalIgnoreCase);

    private async Task ScrollToAsync(string sectionId)
        => await JSRuntime.InvokeVoidAsync("configApi.scrollTo", SectionElementId(sectionId));

    private async Task SaveAsync(ConfigSectionDto section)
    {
        try
        {
            SavingSectionId = section.Id;
            SaveErrors.Remove(section.Id);
            SaveStatus.Remove(section.Id);
            await JSRuntime.InvokeAsync<object>(
                "configApi.request",
                "POST",
                $"/api/config/{Uri.EscapeDataString(section.Id)}",
                new ConfigUpdateDto(Edits[section.Id]));
            SaveStatus[section.Id] = "已保存。";
        }
        catch (Exception ex)
        {
            SaveErrors[section.Id] = $"保存失败: {ex.Message}";
        }
        finally
        {
            SavingSectionId = null;
        }
    }

    private static string SectionElementId(string sectionId) => $"config-section-{sectionId}";

    private static string InputElementId(string sectionId, string key) => $"config-field-{sectionId}-{key}";
}
