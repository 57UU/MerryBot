@page "/groups"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<PageTitle>群组管理</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
        <div>
            <h1>群组管理</h1>
            <p>管理 MerryBot 在哪些群聊中启用。改动直接写入 core 配置，立即生效，无需重启。</p>
        </div>
        <FluentSpacer />
        <FluentButton Appearance="Appearance.Neutral" OnClick="LoadAsync" Disabled="@IsLoading" Loading="@IsLoading">
            @(IsLoading ? "刷新中…" : "刷新")
        </FluentButton>
    </FluentStack>

    @if (Error != null)
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }

    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <strong>启用新群</strong>
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentTextField Placeholder="输入 QQ 群号" @bind-Value="NewGroupText" Style="flex:1" />
                <FluentButton Appearance="Appearance.Accent" OnClick="AddGroupAsync" Disabled="@(IsMutating || string.IsNullOrWhiteSpace(NewGroupText))" Loading="@IsMutating">
                    @(IsMutating ? "处理中…" : "启用")
                </FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    @if (Data == null)
    {
        <FluentProgressRing />
    }
    else if (Data.Groups.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">还没有任何群聊记录，输入群号即可启用。</FluentMessageBar>
    }
    else
    {
        <FluentDataGrid Items="@((Data?.Groups ?? []).AsQueryable())">
            <PropertyColumn Property="@(group => group.GroupId)" Title="群号" Sortable="true" />
            <TemplateColumn Title="群名" Context="group">@(string.IsNullOrEmpty(group.Name) ? "—" : group.Name)</TemplateColumn>
            <TemplateColumn Title="人数" Context="group">@(group.MemberCount > 0 ? group.MemberCount.ToString() : "—")</TemplateColumn>
            <PropertyColumn Property="@(group => group.MessageCount)" Title="消息数" Sortable="true" />
            <PropertyColumn Property="@(group => group.AiMessageCount)" Title="AI 消息数" Sortable="true" />
            <TemplateColumn Title="状态" Context="group">
                @if (group.Enabled)
                {
                    <FluentBadge Appearance="Appearance.Accent">已启用</FluentBadge>
                }
                else
                {
                    <FluentBadge Appearance="Appearance.Neutral">未启用</FluentBadge>
                }
            </TemplateColumn>
            <TemplateColumn Title="操作" Context="group">
                @if (group.Enabled)
                {
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => ToggleAsync(group.GroupId, false)" Disabled="@IsMutating">禁用</FluentButton>
                }
                else
                {
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => ToggleAsync(group.GroupId, true)" Disabled="@IsMutating">启用</FluentButton>
                }
            </TemplateColumn>
        </FluentDataGrid>
    }
</FluentStack>

@code {
    private GroupListPayload? Data;
    private string? Error;
    private bool IsLoading;
    private bool IsMutating;
    private string NewGroupText = "";

    private bool _initialized;

    // 预渲染阶段无法调用 JS 互操作，首次渲染（交互连接建立）后再加载
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Error = null;
        try
        {
            Data = await JSRuntime.InvokeAsync<GroupListPayload>("configApi.request", "GET", "/api/groups/");
        }
        catch (Exception ex)
        {
            Error = $"加载失败：{ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AddGroupAsync()
    {
        if (!long.TryParse(NewGroupText.Trim(), out var groupId) || groupId <= 0)
        {
            Error = "请输入有效的 QQ 群号。";
            return;
        }
        IsMutating = true;
        try
        {
            Error = null;
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", $"/api/groups/{groupId}");
            NewGroupText = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Error = $"启用失败：{ex.Message}";
        }
        finally
        {
            IsMutating = false;
        }
    }

    private async Task ToggleAsync(long groupId, bool enable)
    {
        IsMutating = true;
        try
        {
            Error = null;
            var url = enable ? $"/api/groups/{groupId}" : $"/api/groups/{groupId}/delete";
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", url);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Error = $"操作失败：{ex.Message}";
        }
        finally
        {
            IsMutating = false;
        }
    }

    private sealed class GroupListPayload
    {
        public List<GroupEntryPayload> Groups { get; set; } = new();
    }

    private sealed class GroupEntryPayload
    {
        public long GroupId { get; set; }
        public string? Name { get; set; }
        public int MemberCount { get; set; }
        public int MessageCount { get; set; }
        public int AiMessageCount { get; set; }
        public bool Enabled { get; set; }
    }
}
