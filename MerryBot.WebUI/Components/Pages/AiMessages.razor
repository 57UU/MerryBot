@page "/aimessages"
@using DataService
@using BotPlugin
@rendermode InteractiveServer
@inject HistoryRecorder HistoryRecorder

<PageTitle>AI 记录</PageTitle>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="height: 100%;">
    @* 左侧群聊列表 *@
    <div style="width: 280px; flex-shrink: 0;">
        <GroupListPanel SelectedGroupId="SelectedAiGroupId"
                        OnGroupSelected="OnGroupSelected"
                        OnLoaded="OnGroupsLoaded" />
    </div>

    @* 右侧消息展示 *@
    <div style="flex-grow: 1; min-width: 0;">
        <PagedMessageContainer TItem="AiMessageEntry"
                               ElementId="ai-message-container"
                               Key="@(SelectedAiGroupId > 0 ? SelectedAiGroupId.ToString() : string.Empty)"
                               EmptySelectionHint="请从左侧选择一个群聊"
                               EmptyText="暂无 AI 消息"
                               LoadPageAsync="LoadAiMessagesPage">
            <HeaderContent>
                @(SelectedAiGroupId > 0 ? $"群聊 {SelectedAiGroupId} 的 AI 消息" : "请选择一个群聊")
            </HeaderContent>
            <BodyContent>
                @foreach (var message in context)
                {
                    <FluentCard Style="margin-bottom: 12px;">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                            <FluentBadge Appearance="Appearance.Accent">@message.MessageType</FluentBadge>
                            <FluentSpacer />
                            <span style="font-size: 12px; color: var(--neutral-foreground-hint);">@DateTimeOffset.FromUnixTimeSeconds(message.Time).ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </FluentStack>
                        <div style="margin-top: 8px;">@message.Content</div>
                        @if (message.InputTokens > 0 || message.OutputTokens > 0)
                        {
                            <div style="font-size: 12px; color: var(--neutral-foreground-hint); margin-top: 4px;">Token 用量：输入 @message.InputTokens · 输出 @message.OutputTokens · 共 @(message.InputTokens + message.OutputTokens)</div>
                        }
                    </FluentCard>
                }
            </BodyContent>
        </PagedMessageContainer>
    </div>
</FluentStack>

@code {
    private long SelectedAiGroupId { get; set; } = 0;

    private Task OnGroupsLoaded(GroupListContext context)
    {
        // 首次进入自动选中第一个群聊
        if (SelectedAiGroupId == 0 && context.GroupIds.Any())
        {
            SelectedAiGroupId = context.GroupIds[0];
        }
        return Task.CompletedTask;
    }

    private Task OnGroupSelected(long groupId)
    {
        if (SelectedAiGroupId == groupId) return Task.CompletedTask;
        SelectedAiGroupId = groupId;
        return Task.CompletedTask;
    }

    private Task<List<AiMessageEntry>> LoadAiMessagesPage(int page, int pageSize)
        => HistoryRecorder.AiMessages.GetAiMessagesBySessionKeyAsync(SessionKey.ToString(SelectedAiGroupId), page, pageSize);
}
