@page "/skills"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<PageTitle>技能管理</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <div>
        <h1>技能管理</h1>
        <p>支持直接上传单文件 <code>.md</code>，或上传目录型 Skill 的 <code>.zip</code>，或从 Git 仓库克隆。禁用会将入口文件标记为 <code>.disable</code>，运行中的新会话只会读取启用的 Skill。Git 形式的 Skill 支持一键更新（<code>git pull --ff-only</code>）。</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }
    @if (!string.IsNullOrWhiteSpace(Success))
    {
        <FluentMessageBar Intent="MessageIntent.Success">@Success</FluentMessageBar>
    }

    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <strong>上传 Skill</strong>
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <input id="skill-upload-file" type="file" accept=".md,.zip" />
                <FluentButton Appearance="Appearance.Accent" OnClick="UploadAsync" Disabled="@IsUploading" Loading="@IsUploading">@(IsUploading ? "上传中…" : "上传")</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <strong>从 Git 导入</strong>
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentTextField Placeholder="Git 地址，如 https://github.com/owner/repo.git" @bind-Value="GitUrl" Immediate="true" Style="flex:1" />
                <FluentTextField Placeholder="名称（可选，默认取仓库名）" @bind-Value="GitName" Immediate="true" Style="max-width:14rem" />
                <FluentButton Appearance="Appearance.Accent" OnClick="CloneGitAsync" Disabled="@IsCloning" Loading="@IsCloning">@(IsCloning ? "克隆中…" : "克隆")</FluentButton>
            </FluentStack>
            <small>支持 https、git at、ssh、git 协议；以 shallow clone 方式克隆。</small>
        </FluentStack>
    </FluentCard>

    @if (SkillItems is null)
    {
        <FluentProgressRing />
    }
    else if (SkillItems.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">还没有 Skill。</FluentMessageBar>
    }
    else
    {
        <FluentDataGrid Items="@((SkillItems ?? []).AsQueryable())">
            <TemplateColumn Title="名称" Context="skill">
                <code>@skill.Name</code>
                @if (skill.Layout == SkillLayout.GitRepository && !string.IsNullOrWhiteSpace(skill.GitUrl))
                {
                    <div><small title="@skill.GitUrl">@skill.GitUrl @if (!string.IsNullOrWhiteSpace(skill.GitHead)) { <span>(@skill.GitHead)</span> }</small></div>
                }
            </TemplateColumn>
            <TemplateColumn Title="描述" Context="skill">
                <span title="@(skill.Description ?? string.Empty)">@(string.IsNullOrWhiteSpace(skill.Description) ? "—" : skill.Description)</span>
            </TemplateColumn>
            <TemplateColumn Title="形式" Context="skill">@LayoutLabel(skill.Layout)</TemplateColumn>
            <TemplateColumn Title="状态" Context="skill">
                @if (skill.Enabled)
                {
                    <FluentBadge Appearance="Appearance.Accent">启用</FluentBadge>
                }
                else
                {
                    <FluentBadge Appearance="Appearance.Neutral">禁用</FluentBadge>
                }
            </TemplateColumn>
            <TemplateColumn Title="更新时间" Context="skill">@skill.UpdatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</TemplateColumn>
            <TemplateColumn Title="操作" Context="skill">
                <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
                    @if (skill.Layout == SkillLayout.GitRepository)
                    {
                        <FluentButton Appearance="Appearance.Neutral" OnClick="() => UpdateGitAsync(skill)" Disabled="@IsMutating" Title="git pull 更新">更新</FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => ToggleAsync(skill)" Disabled="@IsMutating">@(skill.Enabled ? "禁用" : "启用")</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => DeleteAsync(skill)" Disabled="@IsMutating">删除</FluentButton>
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>
    }
</FluentStack>

@code {
    private IReadOnlyList<ManagedSkill>? SkillItems;
    private string? Error;
    private string? Success;
    private bool IsUploading;
    private bool IsCloning;
    private bool IsMutating;
    private string GitUrl = string.Empty;
    private string GitName = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            Error = null;
            SkillItems = await JSRuntime.InvokeAsync<List<ManagedSkill>>("configApi.request", "GET", "/api/skills/");
        }
        catch (Exception exception) { Error = $"无法读取 Skill: {exception.Message}"; }
    }

    private async Task UploadAsync()
    {
        IsUploading = true;
        try
        {
            Error = null; Success = null;
            await JSRuntime.InvokeVoidAsync("skillApi.upload", "skill-upload-file", "/api/skills/upload");
            await LoadAsync();
            Success = "上传成功。";
        }
        catch (Exception exception) { Error = $"上传失败: {exception.Message}"; }
        finally { IsUploading = false; }
    }

    private async Task CloneGitAsync()
    {
        if (string.IsNullOrWhiteSpace(GitUrl)) { Error = "请填写 Git 地址。"; return; }
        IsCloning = true;
        try
        {
            Error = null; Success = null;
            var payload = new { gitUrl = GitUrl.Trim(), name = string.IsNullOrWhiteSpace(GitName) ? null : GitName.Trim() };
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", "/api/skills/clone", payload);
            GitUrl = string.Empty; GitName = string.Empty;
            await LoadAsync();
            Success = "Git 克隆成功。";
        }
        catch (Exception exception) { Error = $"克隆失败: {exception.Message}"; }
        finally { IsCloning = false; }
    }

    private async Task UpdateGitAsync(ManagedSkill skill)
    {
        IsMutating = true;
        try
        {
            Error = null; Success = null;
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", $"/api/skills/update?name={Uri.EscapeDataString(skill.Name)}");
            await LoadAsync();
            Success = $"已更新 Git Skill “{skill.Name}”。";
        }
        catch (Exception exception) { Error = $"更新失败: {exception.Message}"; }
        finally { IsMutating = false; }
    }

    private async Task ToggleAsync(ManagedSkill skill)
    {
        IsMutating = true;
        try
        {
            Error = null; Success = null;
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", "/api/skills/enabled", new SkillEnabledRequest(skill.Name, !skill.Enabled));
            await LoadAsync();
        }
        catch (Exception exception) { Error = $"保存失败: {exception.Message}"; }
        finally { IsMutating = false; }
    }

    private async Task DeleteAsync(ManagedSkill skill)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"确定删除 Skill “{skill.Name}”吗？")) return;
        IsMutating = true;
        try
        {
            Error = null; Success = null;
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", $"/api/skills/delete?name={Uri.EscapeDataString(skill.Name)}");
            await LoadAsync();
        }
        catch (Exception exception) { Error = $"删除失败: {exception.Message}"; }
        finally { IsMutating = false; }
    }

    private static string LayoutLabel(SkillLayout layout) => layout switch
    {
        SkillLayout.GitRepository => "Git",
        SkillLayout.Directory => "目录",
        _ => "Markdown",
    };
}
