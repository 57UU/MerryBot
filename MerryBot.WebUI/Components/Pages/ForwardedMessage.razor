@page "/forwardedmessage"
@using DataService
@using Microsoft.Extensions.Logging
@rendermode InteractiveServer
@inject HistoryRecorder HistoryRecorder
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<ForwardedMessage> Logger

<PageTitle>转发消息</PageTitle>

<FluentCard Style="height: 100%;">
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
        @if (IsEmbed)
        {
            <FluentButton Appearance="Appearance.Lightweight" aria-label="关闭" @onclick="CloseModal">×</FluentButton>
        }
        else
        {
            <FluentButton Appearance="Appearance.Lightweight" @onclick="NavigateBack">← 返回</FluentButton>
        }
        <strong>@(ForwardEntry != null ? $"转发消息详情 ({ForwardEntry.Messages.Count} 条)" : "转发消息")</strong>
    </FluentStack>
    <div style="max-height: 90vh; overflow: auto; margin-top: 8px;">
        @if (string.IsNullOrEmpty(Id))
        {
            <p style="text-align: center; margin-top: 48px;">
                未指定转发消息ID
            </p>
        }
        else if (IsLoading)
        {
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentProgressRing />
                <span>加载中...</span>
            </FluentStack>
        }
        else if (ForwardEntry == null)
        {
            <p style="text-align: center; margin-top: 48px;">
                @(LoadError ?? "未找到转发消息")
            </p>
        }
        else
        {
            <div>
                @foreach (var message in SortedMessages)
                {
                    <FluentCard Style="margin-bottom: 12px;">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                            <strong>@message.SenderNickname</strong>
                            <span>@message.SenderId
                                @(!string.IsNullOrEmpty(message.SenderGroupNickname) ? $"({message.SenderGroupNickname})" : "")
                            </span>
                            <FluentSpacer />
                            <span style="font-size: 12px; color: var(--neutral-foreground-hint);">@message.Time.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </FluentStack>
                        <div style="margin-top: 8px;">
                            @foreach (var msg in message.Messages)
                            {
                                <MessageRenderer Msg="msg" Mode="MessageRenderMode.Link" />
                            }
                        </div>
                    </FluentCard>
                }
            </div>
        }
    </div>
</FluentCard>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Embed { get; set; }

    private bool IsEmbed => Embed == "1";
    private ForwardMessageEntry? ForwardEntry { get; set; }
    private string? LoadError { get; set; }
    private IReadOnlyList<GroupMessage> SortedMessages { get; set; } = Array.Empty<GroupMessage>();
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadForwardMessage();
    }

    private async Task LoadForwardMessage()
    {
        IsLoading = true;
        LoadError = null;

        try
        {
            if (!string.IsNullOrEmpty(Id))
            {
                ForwardEntry = await HistoryRecorder.GetForwardMessageByIdAsync(Id);
                // 排序仅做一次，避免每次渲染重排
                SortedMessages = ForwardEntry != null
                    ? ForwardEntry.Messages.OrderBy(m => m.Time).ToList()
                    : Array.Empty<GroupMessage>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载转发消息失败: id={Id}", Id);
            LoadError = $"加载转发消息失败：{ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CloseModal()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("parent.closeForwardModal");
        }
        catch (JSDisconnectedException)
        {
            // 电路已断开，忽略
        }
    }

    private void NavigateBack()
    {
        // 优先回退历史栈，无历史则回首页
        NavigationManager.NavigateTo("/");
    }
}
