@page "/logs"
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JSRuntime
@using System.Text.RegularExpressions

<PageTitle>运行日志</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
        <div>
            <h1>运行日志</h1>
            <p>NLog 日志（按天分文件，最新在顶）；级别/关键词过滤在服务端执行，可浏览历史文件。</p>
        </div>
        <FluentSpacer />
        <FluentButton Appearance="Appearance.Neutral" OnClick="LoadAsync" Disabled="@IsLoading" Loading="@IsLoading">
            @(IsLoading ? "刷新中…" : "刷新")
        </FluentButton>
    </FluentStack>

    @if (Error != null)
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }

    <FluentCard>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
            <span>当前日志：@(Data?.File ?? "—")</span>
            <FluentSelect TOption="string" TOption="string"
                SelectedOption="@(SelectedFile ?? string.Empty)"
                SelectedOptionChanged="@(async (string? v) => { SelectedFile = string.IsNullOrEmpty(v) ? null : v; await LoadAsync(); })"
                Style="min-width:12rem">
                <FluentOption TOption="string" Value="">当前日志</FluentOption>
                @foreach (var f in Files)
                {
                    <FluentOption TOption="string" Value="@f.Name">@f.Name</FluentOption>
                }
            </FluentSelect>
            <FluentSelect TOption="string" TOption="string"
                SelectedOption="@LineCount.ToString()"
                SelectedOptionChanged="@(async (string? v) => { if (int.TryParse(v, out int n)) LineCount = n; await LoadAsync(); })"
                Style="min-width:7rem">
                <FluentOption TOption="string" Value="200">200 行</FluentOption>
                <FluentOption TOption="string" Value="500">500 行</FluentOption>
                <FluentOption TOption="string" Value="1000">1000 行</FluentOption>
            </FluentSelect>
            @foreach (var level in LevelFilters)
            {
                <FluentButton Appearance="@(Level == level ? Appearance.Accent : Appearance.Lightweight)" OnClick="() => SetLevel(level)">@level</FluentButton>
            }
            <FluentSearch Placeholder="搜索日志…" Immediate="true" ImmediateDelay="300"
                Value="@SearchText"
                ValueChanged="@(async (string? v) => { SearchText = v ?? string.Empty; await OnSearchInput(); })"
                Style="flex:1;min-width:10rem" />
            <FluentCheckbox Label="自动刷新" @bind-Value="AutoRefresh" @bind-Value:after="ToggleAutoRefresh" />
        </FluentStack>
    </FluentCard>

    @if (Data == null)
    {
        <FluentProgressRing />
    }
    else if (Data.Lines.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">暂无日志。</FluentMessageBar>
    }
    else
    {
        <div style="max-height:60vh;overflow:auto;font-family:monospace;font-size:.8rem;padding:8px">
            @foreach (var line in Data.Lines)
            {
                <div style="@LogLineStyle(line)">@line</div>
            }
        </div>
    }
</FluentStack>

@code {
    private static readonly string[] LevelFilters = { "全部", "DEBUG", "INFO", "WARN", "ERROR", "FATAL" };
    private static readonly Regex LevelRegex = new(@"\b(TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\b", RegexOptions.Compiled);

    private LogContentPayload? Data;
    private List<LogFileInfoPayload> Files = new();
    private string? Error;
    private bool IsLoading;
    private int LineCount = 500;
    private string Level = "全部";
    private string SearchText = "";
    private bool AutoRefresh = true;
    private string? SelectedFile; // null/空 = 当前日志文件

    private System.Threading.Timer? _refreshTimer;
    private System.Threading.Timer? _searchDebounce;
    private bool _initialized;

    // 请求 URL 统一收敛：级别/关键词/文件过滤由服务端执行
    private string BuildUrl()
    {
        var url = $"/api/logs/current?lines={LineCount}";
        if (Level != "全部")
        {
            url += $"&level={Uri.EscapeDataString(Level)}";
        }
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            url += $"&keyword={Uri.EscapeDataString(SearchText.Trim())}";
        }
        if (!string.IsNullOrEmpty(SelectedFile))
        {
            url += $"&file={Uri.EscapeDataString(SelectedFile)}";
        }
        return url;
    }

    // 预渲染阶段无法调用 JS 互操作，首次渲染（交互连接建立）后再加载
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadFilesAsync();
            await LoadAsync();
            // AutoRefresh 默认勾选：首载后即启动定时器，否则复选框状态与实际行为不一致
            ToggleAutoRefresh();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Error = null;
        try
        {
            Data = await JSRuntime.InvokeAsync<LogContentPayload>("configApi.request", "GET", BuildUrl());
        }
        catch (Exception ex)
        {
            Error = $"加载失败：{ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadFilesAsync()
    {
        try
        {
            var files = await JSRuntime.InvokeAsync<List<LogFileInfoPayload>>("configApi.request", "GET", "/api/logs/files");
            Files = files ?? new List<LogFileInfoPayload>();
        }
        catch
        {
            // 文件列表加载失败不阻塞日志查看
            Files = new List<LogFileInfoPayload>();
        }
    }

    private async Task SetLevel(string level)
    {
        Level = level;
        await LoadAsync();
    }

    /// <summary>搜索框输入防抖：停止输入 400ms 后触发服务端过滤请求。</summary>
    private async Task OnSearchInput()
    {
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Threading.Timer(
            async _ =>
            {
                try
                {
                    await InvokeAsync(LoadAsync);
                }
                catch
                {
                    // 电路已断开等场景，防抖回调异常不向外传播
                }
            },
            null,
            TimeSpan.FromMilliseconds(400),
            Timeout.InfiniteTimeSpan);
        await Task.CompletedTask;
    }

    private void ToggleAutoRefresh()
    {
        if (AutoRefresh)
        {
            _refreshTimer ??= new System.Threading.Timer(async _ => await RefreshTickAsync(), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
        else
        {
            _refreshTimer?.Dispose();
            _refreshTimer = null;
        }
    }

    private async Task RefreshTickAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                Error = null;
                try
                {
                    Data = await JSRuntime.InvokeAsync<LogContentPayload>("configApi.request", "GET", BuildUrl());
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Error = $"加载失败：{ex.Message}";
                }
            });
        }
        catch
        {
            // 电路已断开等场景，忽略
        }
    }

    /// <summary>宽松识别日志行级别；无级别行（异常堆栈续行等）归为 DEBUG（灰色显示）。</summary>
    private static string DetectLevel(string line)    {
        var match = LevelRegex.Match(line);
        if (!match.Success)
        {
            return "DEBUG";
        }
        var level = match.Value;
        return level == "TRACE" ? "DEBUG" : level;
    }

    /// <summary>日志行内联颜色（亮暗主题均可读的固定色，无自定义 CSS）。</summary>
    private static string LogLineStyle(string line) => DetectLevel(line) switch
    {
        "ERROR" or "FATAL" => "color:#d13438;",
        "WARN" => "color:#9d7300;",
        "INFO" => "",
        _ => "color:#888888;",
    };

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
        _searchDebounce?.Dispose();
        _searchDebounce = null;
    }

    private sealed class LogContentPayload
    {
        public string? File { get; set; }
        public List<string> Lines { get; set; } = new();
    }

    private sealed class LogFileInfoPayload
    {
        public string Name { get; set; } = "";
        public DateTimeOffset LastWriteTimeUtc { get; set; }
        public long SizeBytes { get; set; }
        public bool IsCurrent { get; set; }
    }
}
