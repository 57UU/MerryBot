@page "/tokenusage"
@rendermode InteractiveServer
@using DataService
@using Microsoft.Extensions.Logging
@inject HistoryRecorder HistoryRecorder
@inject ILogger<TokenUsage> Logger

<PageTitle>Token 用量</PageTitle>

<h1>Token 用量</h1>
<p>AI 会话 token 消耗统计，数据来自消息审计的 AI 消息。</p>

<FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
    @foreach (var range in Ranges)
    {
        var kind = range;
        <FluentButton Appearance="@(Selected == kind ? Appearance.Accent : Appearance.Neutral)" OnClick="() => SelectRangeAsync(kind)">@Describe(kind)</FluentButton>
    }
</FluentStack>

@if (IsLoading)
{
    <FluentProgressRing />
}
else
{
    <h2>用量汇总（@Describe(Selected)）</h2>
    <FluentGrid Spacing="3" Style="margin-bottom:12px;width:100%;">
        <FluentGridItem xs="12" sm="6" lg="4" xl="2">
            <FluentCard Style="height:100%;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(new Size20.ArrowDownload())" Color="Color.Accent" />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                        <strong style="font-size:1.35rem;line-height:1.2;">@FormatTokens(TotalInput)</strong>
                        <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">总输入</span>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" lg="4" xl="2">
            <FluentCard Style="height:100%;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(new Size20.Sparkle())" Color="Color.Accent" />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                        <strong style="font-size:1.35rem;line-height:1.2;">@FormatTokens(TotalCached)</strong>
                        <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">缓存命中</span>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" lg="4" xl="2">
            <FluentCard Style="height:100%;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(new Size20.Target())" Color="Color.Accent" />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                        <strong style="font-size:1.35rem;line-height:1.2;">@FormatRate(TotalCached, TotalUncached)</strong>
                        <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">缓存命中率</span>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" lg="4" xl="2">
            <FluentCard Style="height:100%;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(new Size20.TextFont())" Color="Color.Accent" />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                        <strong style="font-size:1.35rem;line-height:1.2;">@FormatTokens(TotalUncached)</strong>
                        <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">未缓存输入</span>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" lg="4" xl="2">
            <FluentCard Style="height:100%;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(new Size20.ArrowUpload())" Color="Color.Accent" />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                        <strong style="font-size:1.35rem;line-height:1.2;">@FormatTokens(TotalOutput)</strong>
                        <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">输出</span>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" lg="4" xl="2">
            <FluentCard Style="height:100%;">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(new Size20.Brain())" Color="Color.Accent" />
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                        <strong style="font-size:1.35rem;line-height:1.2;">@($"{FormatTokens(TotalAll)} / {MessageCount}")</strong>
                        <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">总计 / 消息数</span>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

    <h2>@GranularityTitle 柱状图</h2>
    <TokenBarChart Buckets="PaddedBuckets" BucketSeconds="BucketSeconds" />

    <h2>会话明细</h2>
    @if (Sessions.Count == 0)
    {
        <p>该时间范围内没有 AI 消息记录</p>
    }
    else
    {
        <FluentDataGrid Items="@Sessions.AsQueryable()">
            <TemplateColumn Title="会话" Context="session">@DescribeSession(session.SessionKey)</TemplateColumn>
            <PropertyColumn Property="@(s => s.MessageCount)" Title="消息数" Sortable="true" />
            <PropertyColumn Property="@(s => s.CachedTokens)" Title="缓存命中" Sortable="true" />
            <PropertyColumn Property="@(s => s.UncachedInputTokens)" Title="未缓存输入" Sortable="true" />
            <PropertyColumn Property="@(s => s.OutputTokens)" Title="输出" Sortable="true" />
            <TemplateColumn Title="命中率" Context="session">@FormatRate(session.CachedTokens, session.UncachedInputTokens)</TemplateColumn>
            <PropertyColumn Property="@(s => s.TotalTokens)" Title="合计" Sortable="true" />
            <TemplateColumn Title="最后活动" Context="session">@DateTimeOffset.FromUnixTimeSeconds(session.LastTime).ToLocalTime().ToString("yyyy-MM-dd HH:mm")</TemplateColumn>
        </FluentDataGrid>
    }
}

@code {
    private enum RangeKind { Today, Last24h, Last7d, Last30d }

    private static readonly RangeKind[] Ranges = [RangeKind.Today, RangeKind.Last24h, RangeKind.Last7d, RangeKind.Last30d];

    private bool IsLoading { get; set; } = true;
    private RangeKind Selected { get; set; } = RangeKind.Today;

    private List<TokenUsageBucket> PaddedBuckets { get; set; } = [];
    private List<TokenSessionSummary> Sessions { get; set; } = [];

    private long TotalCached => PaddedBuckets.Sum(bucket => bucket.CachedTokens);
    private long TotalUncached => PaddedBuckets.Sum(bucket => bucket.UncachedInputTokens);
    private long TotalOutput => PaddedBuckets.Sum(bucket => bucket.OutputTokens);
    private long TotalInput => TotalCached + TotalUncached;
    private long TotalAll => PaddedBuckets.Sum(bucket => bucket.TotalTokens);
    private int MessageCount => Sessions.Sum(session => session.MessageCount);

    private long SinceUnixSec { get; set; }
    private long UntilUnixSec { get; set; }
    private long BucketSeconds => Selected is RangeKind.Today or RangeKind.Last24h ? 3600 : 86400;
    /// <summary>本地时区偏移（秒）：让天级桶对齐本地零点而非 UTC 零点。</summary>
    private long LocalOffsetSeconds => (long)TimeZoneInfo.Local.GetUtcOffset(DateTime.Now).TotalSeconds;

    private string GranularityTitle => BucketSeconds >= 86400 ? "按天" : "按小时";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task SelectRangeAsync(RangeKind kind)
    {
        if (Selected == kind) return;
        Selected = kind;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            var now = DateTimeOffset.Now;
            UntilUnixSec = now.ToUnixTimeSeconds();
            SinceUnixSec = Selected switch
            {
                RangeKind.Today => new DateTimeOffset(now.Date, now.Offset).ToUnixTimeSeconds(),
                RangeKind.Last24h => UntilUnixSec - 24 * 3600,
                RangeKind.Last7d => UntilUnixSec - 7L * 86400,
                _ => UntilUnixSec - 30L * 86400,
            };

            var bucketsTask = HistoryRecorder.AiMessages.GetTokenUsageBucketsAsync(SinceUnixSec, UntilUnixSec, BucketSeconds, LocalOffsetSeconds);
            var sessionsTask = HistoryRecorder.AiMessages.GetTokenUsageBySessionAsync(SinceUnixSec, UntilUnixSec);
            await Task.WhenAll(bucketsTask, sessionsTask);

            // 补齐空桶，保持时间轴连续
            var found = bucketsTask.Result.ToDictionary(bucket => bucket.BucketStart);
            var first = FloorToBucket(SinceUnixSec);
            PaddedBuckets = [];
            for (var start = first; start <= UntilUnixSec; start += BucketSeconds)
            {
                PaddedBuckets.Add(found.TryGetValue(start, out var bucket)
                    ? bucket
                    : new TokenUsageBucket(start, 0, 0, 0));
            }
            // 最后一个不完整的小时/天桶保留（部分数据也画出来）
            Sessions = sessionsTask.Result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载 Token 用量统计失败");
            PaddedBuckets = [];
            Sessions = [];
        }
        finally
        {
            IsLoading = false;
        }
    }

    private long FloorToBucket(long time)
        => (time + LocalOffsetSeconds) / BucketSeconds * BucketSeconds - LocalOffsetSeconds;

    private static string Describe(RangeKind kind) => kind switch
    {
        RangeKind.Today => "今天",
        RangeKind.Last24h => "过去 24h",
        RangeKind.Last7d => "过去 7 天",
        _ => "过去 30 天",
    };

    private static string DescribeSession(string sessionKey)
        => sessionKey.StartsWith("qq/group/", StringComparison.Ordinal)
            ? $"群聊 {sessionKey["qq/group/".Length..]}"
            : sessionKey;

    private static string FormatTokens(long value)
    {
        if (value >= 1_000_000) return $"{(double)value / 1_000_000:0.#}M";
        if (value >= 10_000) return $"{(double)value / 1000:0.#}k";
        return value.ToString();
    }

    /// <summary>缓存命中率 = cached / (cached + uncached)，总输入为 0 时显示 "—"。</summary>
    private static string FormatRate(long cached, long uncached)
    {
        var input = cached + uncached;
        return input <= 0 ? "—" : $"{(double)cached / input:P1}";
    }
}
