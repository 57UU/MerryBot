@page "/prompts"
@rendermode InteractiveServer
@using System.Text.Json
@using DataService
@using MerryBot.Contracts
@using MerryBot.WebUI.Api
@inject WebUiServiceRegistry WebUiServices
@inject HistoryRecorder HistoryRecorder
@inject IJSRuntime JSRuntime

<PageTitle>提示词管理</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <div>
        <h1>提示词管理</h1>
        <p>按群复写 Agent 的系统提示词。未复写的群跟随配置中心 <code>plugin:agent / AiPrompt</code>（全局默认）。修改保存后，对该群<strong>下次 <code>/new</code>（或会话空闲淘汰、重启）后生效</strong>，不会中断正在生成的回复。</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }
    @if (!string.IsNullOrWhiteSpace(Notice))
    {
        <FluentMessageBar Intent="MessageIntent.Success">@Notice</FluentMessageBar>
    }

    @* 左右分栏：左列按内容自适应（最长行决定宽度），右列占满剩余；窄屏自动换行堆叠 *@
    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="12" Style="width:100%;align-items:flex-start;">
        <div style="flex:0 1 auto;min-width:min(100%,280px);">
            <SelectableList TItem="GroupItem"
                            Title="群聊"
                            Items="Groups"
                            GetKey="@(group => group.SessionKey)"
                            SelectedKey="@SelectedSessionKey"
                            OnSelected="SelectSessionAsync"
                            RowTitle="@(group => group.DisplayName)"
                            LoadingText="加载群聊中…"
                            EmptyText="还没有任何群聊记录。">
                <RowContent Context="group">
                    <span class="select-row-line">
                        <span class="select-row-title" title="@group.DisplayName">@group.DisplayName</span>
                        @if (group.HasOverride)
                        {
                            <FluentBadge Appearance="Appearance.Accent">已复写</FluentBadge>
                        }
                        else
                        {
                            <FluentBadge Appearance="Appearance.Neutral">跟随全局</FluentBadge>
                        }
                    </span>
                </RowContent>
            </SelectableList>
        </div>

        <div style="flex:1 1 400px;min-width:0;">
            @if (SelectedSessionKey is null)
            {
                <FluentMessageBar Intent="MessageIntent.Info">从左侧选择一个群以管理其提示词复写。</FluentMessageBar>
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentCard>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                                <strong>群提示词复写</strong>
                                @if (HasOverride)
                                {
                                    <FluentBadge Appearance="Appearance.Accent">已复写</FluentBadge>
                                }
                                else
                                {
                                    <FluentBadge Appearance="Appearance.Neutral">跟随全局</FluentBadge>
                                }
                            </FluentStack>
                            <FluentTextArea Rows="10" @bind-Value="EditText" Placeholder="输入该群专用的系统提示词，留空保存则回退全局" Style="width:100%" />
                            <small>@(EditText.Length) / @IPromptOverrideService.MaxPromptLength 字符</small>
                            <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
                                <FluentButton Appearance="Appearance.Accent" OnClick="SaveAsync" Disabled="@IsSaving" Loading="@IsSaving">保存复写</FluentButton>
                                <FluentButton Appearance="Appearance.Neutral" OnClick="CopyFromGlobal" Disabled="@IsSaving">从全局复制</FluentButton>
                                @if (HasOverride)
                                {
                                    <FluentButton Appearance="Appearance.Neutral" OnClick="DeleteAsync" Disabled="@IsSaving">回退全局</FluentButton>
                                }
                            </FluentStack>
                        </FluentStack>
                    </FluentCard>

                    <FluentCard>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                            <strong>全局默认（配置中心 plugin:agent / AiPrompt）</strong>
                            @if (GlobalPrompt is null)
                            {
                                <span>无法读取全局提示词：@(GlobalPromptError ?? "未知错误")</span>
                            }
                            else
                            {
                                <pre style="white-space:pre-wrap;word-break:break-word;margin:0">@GlobalPrompt</pre>
                            }
                        </FluentStack>
                    </FluentCard>
                </FluentStack>
            }
        </div>
    </FluentStack>
</FluentStack>

@code {
    private sealed class GroupItem
    {
        public required string SessionKey { get; init; }
        public required string DisplayName { get; init; }
        public bool HasOverride { get; set; }
    }

    private sealed class GroupNameInfo(long groupId, string? name)
    {
        public long GroupId { get; } = groupId;
        public string? Name { get; } = name;
    }

    private List<GroupItem>? Groups;
    private string? SelectedSessionKey;
    private bool HasOverride;
    private string EditText = string.Empty;
    private string? GlobalPrompt;
    private string? GlobalPromptError;
    private string? Error;
    private string? Notice;
    private bool IsSaving;

    // 直连进程内服务，无 JS 互操作依赖，初始化时直接加载
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private static string ToSessionKey(long groupId) => $"qq/group/{groupId}";

    private async Task LoadAsync()
    {
        try
        {
            Error = null;
            // 提示词复写服务未加载时对等原 API 404 语义：整页报错
            var promptService = WebUiServices.PromptOverrides;
            if (promptService is null)
            {
                Error = "提示词复写服务未加载。";
                return;
            }
            var overridesTask = promptService.ListOverridesAsync();
            var groupsTask = LoadGroupsAsync();
            await Task.WhenAll(overridesTask, groupsTask);

            var overrideKeys = overridesTask.Result.Select(item => item.SessionKey).ToHashSet(StringComparer.Ordinal);
            var items = groupsTask.Result
                .OrderBy(group => group.GroupId)
                .Select(group => new GroupItem
                {
                    SessionKey = ToSessionKey(group.GroupId),
                    DisplayName = string.IsNullOrWhiteSpace(group.Name)
                        ? $"群 {group.GroupId}"
                        : $"{group.Name} ({group.GroupId})",
                    HasOverride = overrideKeys.Contains(ToSessionKey(group.GroupId)),
                })
                .ToList();
            // 已复写但不在群列表中的会话（如已禁用历史群）追加展示，避免复写“消失”
            var namesByGroupId = groupsTask.Result.ToDictionary(group => group.GroupId, group => group.Name);
            foreach (var key in overrideKeys)
            {
                if (items.All(item => item.SessionKey != key))
                {
                    items.Add(new GroupItem { SessionKey = key, DisplayName = GetDisplayName(key, namesByGroupId), HasOverride = true });
                }
            }
            Groups = items;

            LoadGlobalPrompt();

            // 刷新左侧徽标；若正选中某群，同步其复写状态
            if (SelectedSessionKey is not null)
            {
                HasOverride = overrideKeys.Contains(SelectedSessionKey);
            }
        }
        catch (Exception exception) { Error = $"无法读取提示词配置: {exception.Message}"; }
    }

    /// <summary>群列表：历史记录群 + 已启用群并上群名；缺名群实时向 napcat 查询（3 秒超时）。逻辑照抄 GroupApiMapper（精简掉本页不用的消息计数）。</summary>
    private async Task<List<GroupNameInfo>> LoadGroupsAsync()
    {
        var knownGroupIds = await HistoryRecorder.GetAllGroupIdsAsync();
        var enabledIds = WebUiServices.GroupManager?.GetEnabledGroupIds().OrderBy(static id => id).ToList()
            ?? new List<long>();
        var nameMap = (await HistoryRecorder.GetAllGroupNamesAsync())
            .GroupBy(static item => item.GroupId)
            .ToDictionary(group => group.Key, static group => group.First());
        var allIds = knownGroupIds.Concat(enabledIds).Distinct().OrderBy(static id => id).ToList();

        // 群管理服务未加载时跳过实时查询，仅用历史缓存群名
        var groupManager = WebUiServices.GroupManager;
        if (groupManager is not null)
        {
            var missingNameIds = allIds.Where(id => !nameMap.ContainsKey(id)).ToList();
            if (missingNameIds.Count > 0)
            {
                var resolved = await Task.WhenAll(missingNameIds.Select(ResolveWithTimeoutAsync));
                foreach (var info in resolved)
                {
                    if (info is not null)
                    {
                        nameMap[info.GroupId] = new GroupNameEntry
                        {
                            GroupId = info.GroupId,
                            Name = info.Name,
                            MemberCount = info.MemberCount,
                            MaxMemberCount = info.MaxMemberCount,
                            UpdatedTime = DateTime.Now,
                        };
                    }
                }
            }
        }

        return allIds
            .Select(id => new GroupNameInfo(id, nameMap.TryGetValue(id, out var entry) ? entry.Name : null))
            .ToList();

        // 单次查询最多等 3 秒：napcat 未响应时快速返回，避免列表被拖住
        async Task<GroupNameInfoDto?> ResolveWithTimeoutAsync(long groupId)
        {
            var lookup = groupManager!.ResolveGroupNameAsync(groupId);
            var completed = await Task.WhenAny(lookup, Task.Delay(TimeSpan.FromSeconds(3)));
            return completed == lookup ? await lookup : null;
        }
    }

    /// <summary>全局默认提示词：从配置中心读 plugin:agent / AiPrompt（对等原 config 快照取值）。</summary>
    private void LoadGlobalPrompt()
    {
        var registry = WebUiServices.Config;
        if (registry is null)
        {
            GlobalPrompt = null;
            GlobalPromptError = "配置中心不可用。";
            return;
        }
        var promptField = registry.GetSnapshot()
            .FirstOrDefault(section => section.Id == "plugin:agent")
            ?.Fields.FirstOrDefault(field => field.Key == "AiPrompt");
        string? promptText = promptField?.Value switch
        {
            string text => text,
            JsonElement element when element.ValueKind == JsonValueKind.String => element.GetString(),
            _ => null,
        };
        if (promptField is null || (promptText is null && promptField.Value is not null))
        {
            GlobalPrompt = null;
            GlobalPromptError = "配置中心缺少 plugin:agent / AiPrompt。";
        }
        else
        {
            GlobalPrompt = promptText;
            GlobalPromptError = null;
        }
    }

    private async Task SelectSessionAsync(string sessionKey)
    {
        var promptService = WebUiServices.PromptOverrides;
        if (promptService is null)
        {
            Error = "提示词复写服务未加载。";
            return;
        }
        try
        {
            Error = null;
            Notice = null;
            SelectedSessionKey = sessionKey;
            var entry = await promptService.GetOverrideAsync(sessionKey);
            HasOverride = entry is not null;
            // 未复写时以全局值预填编辑框，方便微调后直接保存
            EditText = entry is not null ? entry.Prompt : (GlobalPrompt ?? string.Empty);
        }
        catch (Exception exception) { Error = $"无法读取提示词复写: {exception.Message}"; }
    }

    private void CopyFromGlobal()
    {
        if (GlobalPrompt is null)
        {
            Error = "无法读取全局提示词，复制失败。";
            return;
        }
        EditText = GlobalPrompt;
        Notice = null;
    }

    private async Task SaveAsync()
    {
        if (SelectedSessionKey is null) return;
        if (EditText.Length > IPromptOverrideService.MaxPromptLength)
        {
            Error = $"提示词过长（最多 {IPromptOverrideService.MaxPromptLength} 字符）。";
            return;
        }
        var promptService = WebUiServices.PromptOverrides;
        if (promptService is null)
        {
            Error = "提示词复写服务未加载，保存失败。";
            return;
        }
        IsSaving = true;
        try
        {
            Error = null;
            string sessionKey = SelectedSessionKey;
            // 空白视为回退全局：与删除语义一致，避免存入空提示词导致空 system prompt
            if (string.IsNullOrWhiteSpace(EditText))
            {
                await promptService.DeleteOverrideAsync(sessionKey);
            }
            else
            {
                await promptService.SaveOverrideAsync(sessionKey, EditText);
            }
            var isDelete = string.IsNullOrWhiteSpace(EditText);
            Notice = isDelete ? "已回退全局。" : "已保存复写，对该群下次 /new 后生效。";
            if (isDelete) EditText = GlobalPrompt ?? string.Empty;
            await LoadAsync();
        }
        catch (Exception exception) { Error = $"保存失败: {exception.Message}"; }
        finally { IsSaving = false; }
    }

    private async Task DeleteAsync()
    {
        if (SelectedSessionKey is null) return;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "确定回退为全局提示词吗？该群的复写将被删除。")) return;
        var promptService = WebUiServices.PromptOverrides;
        if (promptService is null)
        {
            Error = "提示词复写服务未加载，回退失败。";
            return;
        }
        IsSaving = true;
        try
        {
            Error = null;
            string sessionKey = SelectedSessionKey;
            await promptService.DeleteOverrideAsync(sessionKey);
            Notice = "已回退全局。";
            EditText = GlobalPrompt ?? string.Empty;
            await LoadAsync();
        }
        catch (Exception exception) { Error = $"回退失败: {exception.Message}"; }
        finally { IsSaving = false; }
    }

    private static string GetDisplayName(string sessionKey, IReadOnlyDictionary<long, string?> names)
    {
        var parts = sessionKey.Split('/', StringSplitOptions.None);
        if (parts is ["qq", "group", var id] && long.TryParse(id, out var groupId))
        {
            return names.TryGetValue(groupId, out var name) && !string.IsNullOrWhiteSpace(name)
                ? $"{name} ({groupId})"
                : $"群 {groupId}";
        }
        return sessionKey;
    }
}
