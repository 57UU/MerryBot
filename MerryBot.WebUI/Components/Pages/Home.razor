@page "/"
@rendermode InteractiveServer
@using DataService
@using System.Diagnostics
@using System.Runtime.InteropServices
@using MerryBot.WebUI.Api
@inject WebUiServiceRegistry WebUiServices
@inject HistoryRecorder HistoryRecorder

<PageTitle>概览</PageTitle>

<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
        <h1>概览</h1>
        <p>MerryBot 运行状态、系统信息与资源一览。</p>
    </FluentStack>
    <FluentSpacer />
    <FluentButton Appearance="Appearance.Neutral" Loading="@IsLoading" OnClick="LoadAsync">
        @(IsLoading ? "刷新中…" : "刷新")
    </FluentButton>
</FluentStack>

@if (Error != null)
{
    <FluentMessageBar Intent="MessageIntent.Error">加载失败：@Error</FluentMessageBar>
}

<FluentGrid Spacing="3" Style="margin-bottom:12px;">
    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Style="height:100%;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Size20.Wifi1())" Color="Color.Accent" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                    @if (Connected == true)
                    {
                        <FluentBadge Appearance="Appearance.Accent">已连接</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Neutral">@(Status == null ? "—" : "未连接")</FluentBadge>
                    }
                    <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">连接状态</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Style="height:100%;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Size20.PuzzleCube())" Color="Color.Accent" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                    <strong style="font-size:1.35rem;line-height:1.2;">@(SkillCount.HasValue ? SkillCount.Value.ToString() : "—")</strong>
                    <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">Skill 数量</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Style="height:100%;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Size20.People())" Color="Color.Accent" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                    <strong style="font-size:1.35rem;line-height:1.2;">@(Status == null ? "—" : Status.GroupCount.ToString())</strong>
                    <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">群聊数量</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Style="height:100%;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Size20.Clock())" Color="Color.Accent" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                    <strong style="font-size:1.35rem;line-height:1.2;">@(Status == null ? "—" : FormatUptime(Status.UptimeSeconds))</strong>
                    <span style="color:var(--neutral-foreground-hint);font-size:.85rem;">运行时长</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

<FluentGrid Spacing="3" Style="margin-bottom:12px;">
    <FluentGridItem xs="12" lg="6">
        <FluentCard Style="height:100%;">
            <h3>Bot 信息</h3>
            @if (Status == null)
            {
                <FluentProgressRing />
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">QQ 号</span>
                        <span>@Status.Bot.SelfId</span>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">昵称</span>
                        <span>@Status.Bot.Nickname</span>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">Napcat 地址</span>
                        <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@Status.Bot.NapcatAddress"><code>@Status.Bot.NapcatAddress</code></span>
                    </FluentStack>
                </FluentStack>
            }
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" lg="6">
        <FluentCard Style="height:100%;">
            <h3>系统信息</h3>
            @if (Status == null)
            {
                <FluentProgressRing />
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">操作系统</span>
                        <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@Status.OsVersion">@Status.OsVersion</span>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">运行时</span>
                        <span>@Status.Framework</span>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">机器名</span>
                        <span>@Status.MachineName</span>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">进程 ID</span>
                        <span>@Status.ProcessId</span>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span style="width:5.5rem;flex-shrink:0;color:var(--neutral-foreground-hint);">内存占用</span>
                        <span>@FormatBytes(Status.WorkingSetBytes)（托管 @FormatBytes(Status.GcMemoryBytes)）</span>
                    </FluentStack>
                </FluentStack>
            }
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

@if (Status != null && !string.IsNullOrWhiteSpace(Status.GitInfo))
{
    <FluentCard>
        <strong>Git 版本信息</strong>
        <pre style="margin:0; white-space: pre-wrap; font-family: inherit; font-size: 0.9em;">@Status.GitInfo</pre>
    </FluentCard>
}

<h2>快捷入口</h2>
<FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
    <FluentAnchor Appearance="Appearance.Lightweight" Href="statistics" IconStart="@(new Size20.DataBarVertical())">数据统计</FluentAnchor>
    <FluentAnchor Appearance="Appearance.Lightweight" Href="groups" IconStart="@(new Size20.People())">群组管理</FluentAnchor>
    <FluentAnchor Appearance="Appearance.Lightweight" Href="groupmessages" IconStart="@(new Size20.Chat())">群聊记录</FluentAnchor>
    <FluentAnchor Appearance="Appearance.Lightweight" Href="aimessages" IconStart="@(new Size20.Bot())">AI 记录</FluentAnchor>
    <FluentAnchor Appearance="Appearance.Lightweight" Href="skills" IconStart="@(new Size20.PuzzleCube())">技能管理</FluentAnchor>
</FluentStack>

@code {
    private SystemStatusDto? Status;
    private int? SkillCount;
    private string? Error;
    private bool IsLoading;

    private bool? Connected => Status?.Bot.Connected;

    private static readonly DateTime ProcessStartUtc = Process.GetCurrentProcess().StartTime.ToUniversalTime();

    // 直连进程内服务拼 SystemStatusDto（逻辑与 StatusApiMapper 同体），不再经 JS fetch 回调 HTTP API；
    // 无 JS 互操作依赖，初始化时直接加载
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Error = null;
        try
        {
            if (WebUiServices.BotStatusProvider == null || WebUiServices.HostLifecycle == null)
            {
                Error = "状态服务不可用。";
                return;
            }
            List<long> groups = await HistoryRecorder.GetAllGroupIdsAsync();
            // git 信息获取失败不应影响整体状态展示，失败时返回空串
            string gitInfo;
            try
            {
                gitInfo = await WebUiServices.HostLifecycle.GetVersionInfoAsync();
            }
            catch
            {
                gitInfo = string.Empty;
            }
            Status = new SystemStatusDto(
                WebUiServices.BotStatusProvider(),
                groups.Count,
                Environment.OSVersion.ToString(),
                RuntimeInformation.FrameworkDescription,
                Environment.MachineName,
                Environment.ProcessId,
                (DateTime.UtcNow - ProcessStartUtc).TotalSeconds,
                Environment.WorkingSet,
                GC.GetTotalMemory(forceFullCollection: false),
                gitInfo);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        // Skill 服务未加载（对等原来 API 404）时仅 Skill 数显示「—」，不影响其余状态
        if (WebUiServices.Skills == null)
        {
            SkillCount = null;
        }
        else
        {
            try
            {
                IReadOnlyList<ManagedSkill> skills = await WebUiServices.Skills.ListSkillsAsync();
                SkillCount = skills.Count;
            }
            catch
            {
                SkillCount = null;
            }
        }

        IsLoading = false;
    }

    private static string FormatUptime(double seconds)
    {
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalDays >= 1
            ? $"{(int)t.TotalDays} 天 {t.Hours} 小时"
            : t.TotalHours >= 1
                ? $"{t.Hours} 小时 {t.Minutes} 分"
                : $"{Math.Max(0, t.Minutes)} 分 {Math.Max(0, t.Seconds)} 秒";
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024d:F1} KB",
        < 1024L * 1024 * 1024 => $"{bytes / 1024d / 1024d:F1} MB",
        _ => $"{bytes / 1024d / 1024d / 1024d:F2} GB",
    };
}
