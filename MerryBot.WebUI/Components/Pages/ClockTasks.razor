@page "/clock"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@using System.Text.Json
@using Agent.Session

<PageTitle>定时任务</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <div>
        <h1>定时任务</h1>
        <p>所有插件的定时任务（按 pluginId 隔离）。可编辑调度与文本型内容、启停或删除任务；插件自定义模型的内容为只读，请在插件侧修改。任务的创建由插件/模型工具完成。</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }

    @if (Tasks is null)
    {
        <FluentProgressRing />
    }
    else if (Tasks.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">暂时没有任何定时任务。</FluentMessageBar>
    }
    else
    {
        <FluentGrid Style="width:100%;">
            <FluentGridItem xs="12" md="4" Style="align-self:start;">
                <SelectableList TItem="ClockTaskDto"
                                Title="任务"
                                Items="FilteredTasks.ToList()"
                                GetKey="@(task => task.Id.ToString())"
                                SelectedKey="SelectedTask?.Id.ToString()"
                                OnSelected="SelectTaskByKeyAsync"
                                RowTitle="@(task => task.CronExpression)"
                                LoadingText="加载任务中…"
                                EmptyText="暂时没有任何定时任务。">
                    <HeaderActions>
                        <FluentSelect TOption="string"
                            SelectedOption="@PluginFilter"
                            SelectedOptionChanged="@((string? v) => OnPluginFilterChangedAsync(v))">
                            <FluentOption TOption="string" Value="">全部插件</FluentOption>
                            @foreach (var pluginId in PluginIds)
                            {
                                <FluentOption TOption="string" Value="@pluginId">@pluginId</FluentOption>
                            }
                        </FluentSelect>
                    </HeaderActions>
                    <RowContent Context="task">
                        <span class="select-row-line">
                            @if (task.Enabled)
                            {
                                <FluentBadge Appearance="Appearance.Accent">启用</FluentBadge>
                            }
                            else
                            {
                                <FluentBadge Appearance="Appearance.Neutral">停用</FluentBadge>
                            }
                            <code class="select-row-title" title="@task.CronExpression">@task.CronExpression</code>
                        </span>
                        <span class="select-row-sub">@task.PluginId / @ShortSession(task.SessionId)</span>
                        <span class="select-row-sub">下次: @(task.NextRunAtUtc?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "-")</span>
                    </RowContent>
                </SelectableList>
            </FluentGridItem>

            <FluentGridItem xs="12" md="8">
                @if (SelectedTask is null)
                {
                    <FluentMessageBar Intent="MessageIntent.Info">从左侧选择一个任务进行编辑。</FluentMessageBar>
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <FluentCard>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                                    <strong>编辑任务</strong>
                                    <FluentSpacer />
                                    <small>@SelectedTask.PluginId / @SelectedTask.SessionId</small>
                                </FluentStack>
                                <FluentTextField Label="Cron 表达式（分 时 日 月 周）" Placeholder="0 9 * * 1-5"
                                       Value="@EditCron" ValueChanged="@(v => { EditCron = v ?? string.Empty; })" />
                                <FluentTextField Label="时区" Placeholder="Asia/Shanghai"
                                       Value="@EditTimeZone" ValueChanged="@(v => { EditTimeZone = v ?? string.Empty; })" />
                                <FluentTextField Label="超时（秒，1-86400）" TextFieldType="TextFieldType.Number"
                                       Value="@EditTimeout" ValueChanged="@(v => { EditTimeout = v ?? string.Empty; })" />
                                <FluentCheckbox Label="只执行一次（run_once）" Value="@EditRunOnce" ValueChanged="@(v => { EditRunOnce = v; })" />
                                <FluentCheckbox Label="启用" Value="@EditEnabled" ValueChanged="@(v => { EditEnabled = v; })" />
                                @if (SelectedTask.ContentIsText)
                                {
                                    <FluentTextArea Label="内容（留空保存则保持原内容不变）" Rows="5"
                                            Value="@EditContent" ValueChanged="@(v => { EditContent = v ?? string.Empty; })" Style="width:100%" />
                                }
                                else
                                {
                                    <FluentLabel>内容（插件自定义类型，只读）</FluentLabel>
                                    <pre style="white-space:pre-wrap;word-break:break-word;margin:0">@ObjectJsonText</pre>
                                }
                                <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
                                    <FluentButton Appearance="Appearance.Accent" OnClick="SaveAsync" Disabled="@IsSaving" Loading="@IsSaving">@(IsSaving ? "保存中…" : "保存修改")</FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral" OnClick="() => ToggleEnabledAsync()" Disabled="@IsSaving">@(!EditEnabled ? "启用" : "停用")</FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral" OnClick="DeleteAsync" Disabled="@IsSaving">删除任务</FluentButton>
                                </FluentStack>
                                @if (!string.IsNullOrWhiteSpace(SaveError))
                                {
                                    <FluentMessageBar Intent="MessageIntent.Error">@SaveError</FluentMessageBar>
                                }
                            </FluentStack>
                        </FluentCard>

                        <FluentCard>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                <strong>执行记录</strong>
                                @if (Logs is null || Logs.Count == 0)
                                {
                                    <span>暂无执行记录。</span>
                                }
                                else
                                {
                                    <FluentDataGrid Items="@((Logs ?? []).AsQueryable())">
                                        <TemplateColumn Title="计划时间" Context="log">@log.ScheduledAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</TemplateColumn>
                                        <TemplateColumn Title="状态" Context="log">
                                            @if (log.Status == ClockRunStatus.Succeeded)
                                            {
                                                <FluentBadge Appearance="Appearance.Accent">@StatusText(log.Status)</FluentBadge>
                                            }
                                            else
                                            {
                                                <FluentBadge Appearance="Appearance.Neutral">@StatusText(log.Status)</FluentBadge>
                                            }
                                        </TemplateColumn>
                                        <TemplateColumn Title="耗时" Context="log">@(log.DurationMilliseconds is { } ms ? $"{ms / 1000.0:F1}s" : "-")</TemplateColumn>
                                        <TemplateColumn Title="结果 / 错误" Context="log">@(log.Error ?? log.SkipReason ?? TruncateText(log.ResultSummary, 160))</TemplateColumn>
                                    </FluentDataGrid>
                                }
                            </FluentStack>
                        </FluentCard>
                    </FluentStack>
                }
            </FluentGridItem>
        </FluentGrid>
    }
</FluentStack>

@code {
    private IReadOnlyList<ClockTaskDto>? Tasks;
    private List<ClockLogDto>? Logs;
    private ClockTaskDto? SelectedTask;
    private string? Error;
    private string? SaveError;
    private bool IsSaving;
    private string PluginFilter = string.Empty;

    // 编辑表单状态
    private string EditCron = string.Empty;
    private string EditTimeZone = string.Empty;
    private string EditTimeout = string.Empty;
    private string EditContent = string.Empty;
    private bool EditRunOnce;
    private bool EditEnabled;

    private IEnumerable<string> PluginIds => (Tasks ?? [])
        .Select(t => t.PluginId)
        .Distinct(StringComparer.Ordinal)
        .OrderBy(id => id, StringComparer.Ordinal);

    private IEnumerable<ClockTaskDto> FilteredTasks => string.IsNullOrEmpty(PluginFilter)
        ? Tasks ?? []
        : (Tasks ?? []).Where(t => t.PluginId == PluginFilter);

    /// <summary>对象型 Content 的只读 JSON 展示文本。</summary>
    private string ObjectJsonText
    {
        get
        {
            var content = SelectedTask?.Content;
            if (content is null)
            {
                return string.Empty;
            }
            try { return JsonSerializer.Serialize(content, new JsonSerializerOptions { WriteIndented = true }); }
            catch { return content.ToString() ?? string.Empty; }
        }
    }

    protected override Task OnInitializedAsync() => LoadTasksAsync();

    private async Task LoadTasksAsync()
    {
        try
        {
            Error = null;
            Tasks = await JSRuntime.InvokeAsync<List<ClockTaskDto>>("configApi.request", "GET", "/api/clock/tasks");
            // 列表刷新后保持选中项（任务可能被外部修改）
            if (SelectedTask != null)
            {
                var refreshed = Tasks.FirstOrDefault(t => t.Id == SelectedTask.Id);
                if (refreshed is null)
                {
                    SelectedTask = null;
                    Logs = null;
                }
            }
        }
        catch (Exception exception) { Error = $"无法读取定时任务: {exception.Message}"; }
    }

    private async Task OnPluginFilterChangedAsync(string? pluginId)
    {
        PluginFilter = pluginId ?? string.Empty;
        await Task.CompletedTask;
    }

    /// <summary>键选择（列表组件回传任务 Id 字符串）转对象选择。</summary>
    private Task SelectTaskByKeyAsync(string key)
    {
        ClockTaskDto? task = (Tasks ?? []).FirstOrDefault(t => t.Id.ToString() == key);
        return task is null ? Task.CompletedTask : SelectTaskAsync(task);
    }

    private async Task SelectTaskAsync(ClockTaskDto task)
    {
        SelectedTask = task;
        SaveError = null;
        EditCron = task.CronExpression;
        EditTimeZone = task.TimeZoneId;
        EditTimeout = task.TimeoutSeconds.ToString();
        EditRunOnce = task.RunOnce;
        EditEnabled = task.Enabled;
        EditContent = ContentToText(task.Content);
        Logs = null;
        await LoadLogsAsync(task);
    }

    private static string ContentToText(object? content)
    {
        return content switch
        {
            null => string.Empty,
            JsonElement { ValueKind: JsonValueKind.String } element => element.GetString() ?? string.Empty,
            JsonElement { ValueKind: JsonValueKind.Null } => string.Empty,
            _ => string.Empty,
        };
    }

    private async Task LoadLogsAsync(ClockTaskDto task)
    {
        try
        {
            var encodedPlugin = Uri.EscapeDataString(task.PluginId);
            var encodedSession = Uri.EscapeDataString(task.SessionId);
            Logs = await JSRuntime.InvokeAsync<List<ClockLogDto>>(
                "configApi.request", "GET",
                $"/api/clock/logs?pluginId={encodedPlugin}&sessionId={encodedSession}&taskId={task.Id}&limit=20");
        }
        catch (Exception exception) { Error = $"无法读取执行记录: {exception.Message}"; }
    }

    private Task SaveAsync() => SaveCoreAsync(EditEnabled);

    private Task ToggleEnabledAsync() => SaveCoreAsync(!EditEnabled);

    private async Task SaveCoreAsync(bool enabled)
    {
        if (SelectedTask is null) return;
        IsSaving = true;
        SaveError = null;
        try
        {
            var request = new ClockTaskUpdateRequest(
                SelectedTask.PluginId,
                SelectedTask.SessionId,
                SelectedTask.Id,
                string.IsNullOrWhiteSpace(EditCron) ? null : EditCron.Trim(),
                string.IsNullOrWhiteSpace(EditTimeZone) ? null : EditTimeZone.Trim(),
                EditContent,
                ContentProvided: SelectedTask.ContentIsText,
                RunOnce: EditRunOnce,
                TimeoutSeconds: int.TryParse(EditTimeout, out var timeout) ? timeout : null,
                Enabled: enabled);
            var updated = await JSRuntime.InvokeAsync<ClockTaskDto>("configApi.request", "POST", "/api/clock/tasks/update", request);
            EditEnabled = enabled;
            await LoadTasksAsync();
            // 用刷新后的数据重新填充表单（NextRunAtUtc 等可能变化）
            var refreshed = Tasks?.FirstOrDefault(t => t.Id == updated.Id);
            if (refreshed != null)
            {
                await SelectTaskAsync(refreshed);
            }
        }
        catch (Exception exception)
        {
            SaveError = $"保存失败: {exception.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (SelectedTask is null) return;
        bool confirmed;
        try { confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"确定要删除该定时任务吗？\n\n{SelectedTask.PluginId} / {SelectedTask.CronExpression}\n执行历史会保留。"); }
        catch { confirmed = false; }
        if (!confirmed) return;

        IsSaving = true;
        SaveError = null;
        try
        {
            var request = new ClockTaskDeleteRequest(SelectedTask.PluginId, SelectedTask.SessionId, SelectedTask.Id);
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", "/api/clock/tasks/delete", request);
            SelectedTask = null;
            Logs = null;
            await LoadTasksAsync();
        }
        catch (Exception exception)
        {
            SaveError = $"删除失败: {exception.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string ShortSession(string sessionId) =>
        sessionId.Length <= 24 ? sessionId : sessionId[..24] + "…";

    private static string StatusText(ClockRunStatus status) => status switch
    {
        ClockRunStatus.Running => "执行中",
        ClockRunStatus.Succeeded => "成功",
        ClockRunStatus.TimedOut => "超时",
        ClockRunStatus.Failed => "失败",
        ClockRunStatus.Skipped => "跳过",
        ClockRunStatus.Cancelled => "取消",
        _ => status.ToString(),
    };

    private static string TruncateText(string? value, int limit) =>
        string.IsNullOrEmpty(value) ? string.Empty : (value.Length <= limit ? value : value[..limit] + "…");
}
