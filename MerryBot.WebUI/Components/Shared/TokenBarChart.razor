@using DataService

@* Token 用量分桶表：替代原自绘 SVG 堆叠柱状图，按时间桶列出各类 token。
    Buckets 须为覆盖整个时间范围的完整序列（空桶补零，由页面负责）。 *@
<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
    <FluentBadge Appearance="Appearance.Accent">未缓存输入</FluentBadge>
    <FluentBadge Appearance="Appearance.Neutral">缓存命中</FluentBadge>
    <FluentBadge Appearance="Appearance.Lightweight">输出</FluentBadge>
</FluentStack>
@if (Buckets.Count == 0)
{
    <p>该时间范围内暂无用量数据</p>
}
else
{
    <FluentDataGrid Items="@Buckets.AsQueryable()">
        <TemplateColumn Title="时间" Context="bucket">@BucketLabel(bucket.BucketStart)</TemplateColumn>
        <PropertyColumn Property="@(b => b.UncachedInputTokens)" Title="未缓存输入" Sortable="true" />
        <PropertyColumn Property="@(b => b.CachedTokens)" Title="缓存命中" Sortable="true" />
        <PropertyColumn Property="@(b => b.OutputTokens)" Title="输出" Sortable="true" />
        <PropertyColumn Property="@(b => b.TotalTokens)" Title="合计" Sortable="true" />
    </FluentDataGrid>
}

@code {
    /// <summary>完整的时间桶序列（含空桶），按起始时间升序。</summary>
    [Parameter]
    public IReadOnlyList<TokenUsageBucket> Buckets { get; set; } = Array.Empty<TokenUsageBucket>();

    /// <summary>桶长度（秒）：3600 按小时标注 HH:mm；86400 按天标注 MM-dd。</summary>
    [Parameter]
    public long BucketSeconds { get; set; } = 3600;

    private string BucketLabel(long bucketStart)
    {
        var time = DateTimeOffset.FromUnixTimeSeconds(bucketStart).ToLocalTime();
        return BucketSeconds >= 86400
            ? time.ToString("MM-dd")
            : time.ToString("HH:mm");
    }

    /// <summary>大数缩写：1234 → 1.2k，2000000 → 2M。</summary>
    private static string FormatTokens(long value)
    {
        if (value >= 1_000_000) return $"{(double)value / 1_000_000:0.#}M";
        if (value >= 10_000) return $"{(double)value / 1000:0.#}k";
        return value.ToString();
    }
}
