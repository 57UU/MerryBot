@using NapcatClient.MessageType
@inject IJSRuntime JSRuntime

@* 单条消息段渲染：参数与公开 API 不变，只改内部展示 *@
@try
{
	@if (Msg is TextData textData)
	{
		<span>@textData.Text</span>
	}
	else if (Msg is AtData atData)
	{
		<FluentBadge Appearance="Appearance.Accent">@(atData.Qq == "all" ? "@全体成员" : $"@{atData.Qq}")</FluentBadge>
	}
	else if (Msg is FaceData faceData)
	{
		<span style="color: var(--neutral-foreground-hint);">[表情: @faceData.ToChinese()]</span>
	}
	else if (Msg is ImageData imageData)
	{
		<FluentStack Orientation="Orientation.Vertical" VerticalGap="4" Style="margin-top: 4px;">
			<span style="font-size: 12px; color: var(--neutral-foreground-hint);">@(imageData.Summary ?? "图片")</span>
			<img src="@GetImageUrl(imageData.Url)" alt="@(imageData.Summary ?? "图片")"
				loading="lazy" decoding="async"
				style="max-height: 300px; max-width: 100%; border-radius: 4px;" />
		</FluentStack>
	}
	else if (Msg is FileData fileData)
	{
		<div style="margin-top: 4px;">
			<FluentAnchor Href="@GetFileUrl(fileData.Url, fileData.File)" Download="@fileData.File"
				Appearance="Appearance.Hypertext" title="点击下载文件">
				[文件] @fileData.File (@CommonLib.Format.FormatFileSize(fileData.FileSize ?? 0))
			</FluentAnchor>
		</div>
	}
	else if (Msg is RecordData recordData)
	{
		@if (Mode == MessageRenderMode.Inline)
		{
			<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="margin-top: 4px;">
				<FluentButton Appearance="Appearance.Lightweight"
					IconStart="@(new Size20.Play())"
					@onclick='() => PlayAmr(GetFileUrl(recordData.Url, recordData.File))' title="点击播放语音" aria-label="播放语音" />
				<span>@(recordData.Path ?? "语音消息")</span>
			</FluentStack>
		}
		else
		{
			<div style="margin-top: 4px;">
				<FluentAnchor Href="@GetFileUrl(recordData.Url, recordData.File)" Target="_blank" Appearance="Appearance.Hypertext" title="点击播放语音">
					[语音] @(recordData.Path ?? "语音消息")
				</FluentAnchor>
			</div>
		}
	}
	else if (Msg is VideoData videoData)
	{
		@if (Mode == MessageRenderMode.Inline)
		{
			<div style="margin-top: 4px;">
				<video src="@GetFileUrl(videoData.Url, videoData.File)" controls preload="metadata"
					style="max-width: 100%; max-height: 300px;"></video>
			</div>
		}
		else
		{
			<div style="margin-top: 4px;">
				<FluentAnchor Href="@GetFileUrl(videoData.Url, videoData.File)" Target="_blank" Appearance="Appearance.Hypertext" title="点击播放视频">
					[视频] @(videoData.File ?? "视频消息")
				</FluentAnchor>
			</div>
		}
	}
	else if (Msg is ForwardData forwardData)
	{
		@if (Mode == MessageRenderMode.Inline)
		{
			<div style="margin-top: 4px;">
				<FluentButton Appearance="Appearance.Lightweight"
					@onclick="() => OnForwardClick.InvokeAsync(forwardData.Id)">
					[转发消息] 点击查看详情
				</FluentButton>
			</div>
		}
		else
		{
			<div style="margin-top: 4px;">
				<FluentAnchor Href='@($"/forwardedmessage?id={Uri.EscapeDataString(forwardData.Id ?? "")}&embed=1")' Appearance="Appearance.Hypertext">
					[转发消息] 点击查看详情
				</FluentAnchor>
			</div>
		}
	}
	else if (Msg is ReplyData replyData)
	{
		<div style="margin-top: 4px; color: var(--neutral-foreground-hint);">
			[回复] 消息 ID: @replyData.Id
		</div>
	}
	else if (Msg is JsonData)
	{
		<div style="margin-top: 4px; color: var(--neutral-foreground-hint);">
			[卡片消息]
		</div>
	}
	else if (Msg is MusicData musicData)
	{
		<div style="margin-top: 4px;">
			<FluentBadge Appearance="Appearance.Accent">[音乐] @musicData.Title - @musicData.Singer</FluentBadge>
		</div>
	}
	else if (Msg is DiceData diceData)
	{
		<div style="margin-top: 4px;">
			<FluentBadge Appearance="Appearance.Accent">[骰子] 点数: @diceData.Result</FluentBadge>
		</div>
	}
	else if (Msg is RpsData rpsData)
	{
		<div style="margin-top: 4px;">
			<FluentBadge Appearance="Appearance.Accent">[石头剪刀布] @(rpsData.Result == "1" ? "石头" : rpsData.Result == "2" ? "剪刀" : "布")</FluentBadge>
		</div>
	}
	else if (Msg is PokeData pokeData)
	{
		<div style="margin-top: 4px; color: var(--neutral-foreground-hint);">
			[戳一戳] @pokeData.Type
		</div>
	}
	else if (Msg is MfaceData mfaceData)
	{
		<div style="margin-top: 4px; color: var(--neutral-foreground-hint);">
			[商城表情] @mfaceData.Summary
		</div>
	}
	else
	{
		<span style="color: var(--neutral-foreground-hint);">[未知消息类型: @Msg.GetType().Name]</span>
	}
}
catch (Exception ex)
{
	<FluentMessageBar Intent="MessageIntent.Error">[消息渲染错误: @ex.Message]</FluentMessageBar>
}

@code {
	[Parameter]
	public TypedMessage Msg { get; set; } = null!;

	[Parameter]
	public MessageRenderMode Mode { get; set; } = MessageRenderMode.Inline;

	/// <summary>Inline 模式下点击转发消息的回调，参数为转发 ID。</summary>
	[Parameter]
	public EventCallback<string> OnForwardClick { get; set; }

	private async Task PlayAmr(string url)
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("playAmrAudio", url);
		}
		catch (JSDisconnectedException)
		{
			// 电路已断开，忽略
		}
	}

	private static string GetImageUrl(string? reference)
		=> IsLocalResource(reference) ? $"/api/resource?reference={Uri.EscapeDataString(reference!)}" : $"/api/image/{reference}";

	private static string GetFileUrl(string? reference, string? name)
		=> IsLocalResource(reference)
			? $"/api/resource?reference={Uri.EscapeDataString(reference!)}"
			: $"/api/file/{reference}?name={Uri.EscapeDataString(name ?? string.Empty)}";

	private static bool IsLocalResource(string? reference)
		=> reference?.StartsWith("merrybot://resource/", StringComparison.OrdinalIgnoreCase) == true;
}
