<div class="stat-card">
    <div class="stat-icon @ToneClass">
        <Icon Name="@IconName" />
    </div>
    <div class="stat-card-body">
        <p class="stat-card-value">@Value</p>
        <h5 class="stat-card-title">@Title</h5>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public object Value { get; set; } = 0;

    /// <summary>图标名（见 Icon.razor 的内置图标表）。</summary>
    [Parameter]
    public string IconName { get; set; } = "bar-chart";

    /// <summary>图标色调类名：tone-gray/indigo/cyan/green/violet/amber/red（见 app.css）。</summary>
    [Parameter]
    public string Tone { get; set; } = "gray";

    private string ToneClass => $"tone-{Tone}";
}
