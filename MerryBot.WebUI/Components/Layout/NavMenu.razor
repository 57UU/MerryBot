@inject IJSRuntime JSRuntime

<div class="top-row">
    <div class="nav-container">
        <a class="nav-brand" href="">
            <span class="nav-brand-logo">M</span>
            <span>
                MerryBot
                <span class="nav-brand-sub">QQ Bot Framework</span>
            </span>
        </a>
    </div>
    <div class="top-row-actions">
        <button class="theme-toggle" title="切换亮/暗主题" aria-label="切换亮/暗主题" @onclick="ToggleThemeAsync">
            <Icon Name="@(IsDark == true ? "sun" : "moon")" />
        </button>
        <input type="checkbox" title="导航菜单" class="nav-toggler" />
    </div>
</div>

<div class="nav-scrollable" @onclick="CloseNavIfToggled">
    <nav class="nav-column">
        <div class="nav-group">首页</div>

        <NavMenuItem Href="" Match=NavLinkMatch.All Icon="home">
            概览
        </NavMenuItem>

        <div class="nav-group">配置管理</div>

        <NavMenuItem Href="config" Icon="settings">
            配置中心
        </NavMenuItem>

        <NavMenuItem Href="advanced" Icon="flask">
            高级配置
        </NavMenuItem>

        <NavMenuItem Href="groups" Icon="users">
            群组管理
        </NavMenuItem>

        <div class="nav-group">AI 服务</div>

        <NavMenuItem Href="llmproviders" Icon="cpu">
            模型配置
        </NavMenuItem>

        <NavMenuItem Href="skills" Icon="puzzle">
            技能管理
        </NavMenuItem>

        <NavMenuItem Href="memories" Icon="archive">
            记忆管理
        </NavMenuItem>

        <NavMenuItem Href="sessionai" Icon="search">
            会话快照
        </NavMenuItem>

        <div class="nav-group">消息审计</div>

        <NavMenuItem Href="statistics" Icon="bar-chart">
            数据统计
        </NavMenuItem>

        <NavMenuItem Href="tokenusage" Icon="trending-up">
            Token 用量
        </NavMenuItem>

        <NavMenuItem Href="groupmessages" Icon="message-square">
            群聊记录
        </NavMenuItem>

        <NavMenuItem Href="aimessages" Icon="bot">
            AI 记录
        </NavMenuItem>

        <NavMenuItem Href="logs" Icon="scroll-text">
            运行日志
        </NavMenuItem>
    </nav>

    <div class="nav-footer">
        <div class="d-flex flex-column gap-2">
            <button class="btn btn-secondary btn-sm" @onclick="CheckUpdateAsync" disabled="@Checking">
                @(Checking ? "检测中…" : "检测更新")
            </button>
            <button class="btn btn-danger btn-sm" @onclick="RestartAsync" disabled="@Restarting">
                @(Restarting ? "重启中…" : "重启程序")
            </button>
            <button class="btn btn-secondary btn-sm" @onclick="ReloadAsync" disabled="@Reloading">
                @(Reloading ? "重载中…" : "重载")
            </button>
        </div>
    </div>
</div>

@code {
    private bool Restarting;
    private bool Reloading;
    private bool Checking;

    // 主题状态：预渲染阶段未知（显示 moon 占位），电路建立后从 JS 读取
    private bool? IsDark;
    private bool _themeInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 与页面数据加载同因：预渲染阶段无法调 JS，交互连接建立后再读当前主题
        if (firstRender && !_themeInitialized)
        {
            _themeInitialized = true;
            try
            {
                IsDark = await JSRuntime.InvokeAsync<string>("theme.get") == "dark";
                StateHasChanged();
            }
            catch
            {
                // 电路断开等场景忽略
            }
        }
    }

    /// <summary>切换亮/暗主题并持久化选择。</summary>
    private async Task ToggleThemeAsync()
    {
        try
        {
            var next = await JSRuntime.InvokeAsync<string>("theme.toggle");
            IsDark = next == "dark";
        }
        catch
        {
            // 电路断开等场景忽略
        }
    }

    private async Task CloseNavIfToggled()
    {
        // 移动端：点击导航项后关闭展开的菜单
        try
        {
            await JSRuntime.InvokeVoidAsync("closeNavMenu");
        }
        catch
        {
            // 忽略 JS 调用失败（例如电路已断开）
        }
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("confirm", message);
        }
        catch
        {
            return false;
        }
    }

    private async Task NotifyRestartingAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("alert", "正在重启,请稍后刷新页面…");
        }
        catch
        {
            // 重启瞬间连接断开属预期
        }
    }

    private async Task CheckUpdateAsync()
    {
        if (Checking) return;
        Checking = true;
        try
        {
            var result = await JSRuntime.InvokeAsync<UpdateCheckResult>("configApi.request", "POST", "/api/update/check");
            if (result is not { HasUpdate: true })
            {
                await JSRuntime.InvokeVoidAsync("alert", $"已是最新版本\n\n{result?.VersionInfo}");
                return;
            }

            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm", $"检测到新版本：\n\n{result.CommitMessages}\n\n立即更新并重启？");
            if (!confirmed)
            {
                return;
            }
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", "/api/update");
            await JSRuntime.InvokeVoidAsync("alert", "正在更新并重启，请稍后刷新页面…");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"检测更新失败: {ex.Message}");
        }
        finally
        {
            Checking = false;
        }
    }

    private async Task RestartAsync()
    {
        if (Restarting) return;
        if (!await ConfirmAsync("确定要重新编译并重启 MerryBot 吗?未保存的配置修改会丢失。")) return;

        Restarting = true;
        try
        {
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", "/api/config/restart");
        }
        catch
        {
            // 重启瞬间连接断开属预期
        }
        await NotifyRestartingAsync();
        Restarting = false;
    }

    private async Task ReloadAsync()
    {
        if (Reloading) return;
        if (!await ConfirmAsync("确定要重载 MerryBot 吗?(不重新编译)未保存的配置修改会丢失。")) return;

        Reloading = true;
        try
        {
            await JSRuntime.InvokeAsync<object>("configApi.request", "POST", "/api/config/reload");
        }
        catch
        {
            // 重启瞬间连接断开属预期
        }
        await NotifyRestartingAsync();
        Reloading = false;
    }
}
