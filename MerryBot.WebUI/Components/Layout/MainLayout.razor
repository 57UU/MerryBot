@inherits LayoutComponentBase
@using MerryBot.WebUI.Api
@inject NavigationManager NavigationManager
@inject WebUiServiceRegistry WebUiServices
@inject IJSRuntime JSRuntime

<FluentDesignTheme Mode="DesignThemeModes.System" />

@if (GetEmbedParam())

{
    @Body
}

else

{
    <FluentLayout>
        <FluentHeader>
            MerryBot
            <span style="margin-left:8px;font-size:.85rem;opacity:.75;">QQ Bot Framework</span>
            <FluentSpacer />
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Width="auto" Style="padding-right: 16px;">
                <FluentButton Appearance="Appearance.Neutral" Loading="@Checking" OnClick="CheckUpdateAsync">检测更新
                </FluentButton>
                <FluentButton Appearance="Appearance.Neutral" Loading="@Restarting" OnClick="RestartAsync">重启程序
                </FluentButton>
                <FluentButton Appearance="Appearance.Neutral" Loading="@Reloading" OnClick="ReloadAsync">重载</FluentButton>
            </FluentStack>
        </FluentHeader>
        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
            <div class="side-nav">
                <NavMenu />
            </div>
            <FluentBodyContent Class="body-content">
                <div class="content">
                    @Body
                </div>
            </FluentBodyContent>
        </FluentStack>
    </FluentLayout>
}

<FluentToastProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />
<FluentDialogProvider />

<div id="blazor-error-ui" data-nosnippet>
    发生未处理的错误。
    <a href=".">刷新</a>
    <button type="button" class="dismiss">×</button>
</div>

@code {
    private bool Restarting;

    private bool Reloading;

    private bool Checking;



    private bool GetEmbedParam()

    {

        var uri = new Uri(NavigationManager.Uri);

        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        return query["embed"] == "1";

    }



    private async Task<bool> ConfirmAsync(string message)

    {

        try

        {

            return await JSRuntime.InvokeAsync<bool>("confirm", message);

        }

        catch

        {

            return false;

        }

    }



    private async Task NotifyRestartingAsync()

    {

        try

        {

            await JSRuntime.InvokeVoidAsync("alert", "正在重启,请稍后刷新页面…");

        }

        catch

        {

            // 重启瞬间连接断开属预期

        }

    }



    // 直连进程内 IHostLifecycle；更新走后台触发（照抄 UpdateApiMapper）
    private async Task CheckUpdateAsync()

    {

        if (Checking) return;

        Checking = true;

        try

        {

            if (WebUiServices.HostLifecycle == null)

            {

                await JSRuntime.InvokeVoidAsync("alert", "检测更新失败: 更新服务不可用。");

                return;

            }

            UpdateCheckResult result = await WebUiServices.HostLifecycle.CheckUpdateAsync();

            if (result is not { HasUpdate: true })

            {

                await JSRuntime.InvokeVoidAsync("alert", $"已是最新版本\n\n{result?.VersionInfo}");

                return;

            }



            var confirmed = await JSRuntime.InvokeAsync<bool>(

            "confirm", $"检测到新版本：\n\n{result.CommitMessages}\n\n立即更新并重启？");

            if (!confirmed)

            {

                return;

            }

            // 照抄 UpdateApiMapper：延迟 500ms 后在后台执行更新，HTTP 语义的“先回包再重启”在直连下自然成立
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(500);
                    await WebUiServices.HostLifecycle.RequestUpdateAsync(force: false);
                }
                catch
                {
                    // 后台更新失败无处回显，忽略（日志由宿主侧记录）
                }
            });

            await JSRuntime.InvokeVoidAsync("alert", "正在更新并重启，请稍后刷新页面…");

        }

        catch (Exception ex)

        {

            await JSRuntime.InvokeVoidAsync("alert", $"检测更新失败: {ex.Message}");

        }

        finally

        {

            Checking = false;

        }

    }



    // 直连 Shutdown(Action<int>)：同步 void，直接调用（照抄 ConfigApiMapper 的延迟后台触发语义）
    private async Task RestartAsync()

    {

        if (Restarting) return;

        if (!await ConfirmAsync("确定要重新编译并重启 MerryBot 吗?未保存的配置修改会丢失。")) return;

        if (WebUiServices.Shutdown == null)

        {

            await JSRuntime.InvokeVoidAsync("alert", "重启失败: 进程控制不可用。");

            return;

        }



        Restarting = true;

        try

        {

            Action<int> shutdown = WebUiServices.Shutdown;
            _ = Task.Run(async () =>
            {
                await Task.Delay(500);
                shutdown(ExitCode.RESTART);
            });

        }

        catch

        {

            // 重启瞬间连接断开属预期

        }

        await NotifyRestartingAsync();

        Restarting = false;

    }



    private async Task ReloadAsync()

    {

        if (Reloading) return;

        if (!await ConfirmAsync("确定要重载 MerryBot 吗?(不重新编译)未保存的配置修改会丢失。")) return;

        if (WebUiServices.Shutdown == null)

        {

            await JSRuntime.InvokeVoidAsync("alert", "重载失败: 进程控制不可用。");

            return;

        }



        Reloading = true;

        try

        {

            Action<int> shutdown = WebUiServices.Shutdown;
            _ = Task.Run(async () =>
            {
                await Task.Delay(500);
                shutdown(ExitCode.RELOAD);
            });

        }

        catch

        {

            // 重启瞬间连接断开属预期

        }

        await NotifyRestartingAsync();

        Reloading = false;

    }
}
