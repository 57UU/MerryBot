<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BrowserService</RootNamespace>
    <DefineConstants>$(DefineConstants);_PUBLISH_CHROMEDRIVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Selenium.Support" Version="4.47.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.47.0" />
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="151.0.7922.13800" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Markdown2Html\Markdown2Html.csproj" />
    <ProjectReference Include="..\CommonLib\CommonLib.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="javascript\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 允许单元测试工程访问 internal 成员（如 IsChromeAvailable 的可注入重载） -->
  <ItemGroup>
    <InternalsVisibleTo Include="MerryBot.Test" />
  </ItemGroup>
</Project>
