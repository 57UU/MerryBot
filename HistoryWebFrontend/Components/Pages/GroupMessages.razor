@page "/groupmessages"
@using DataService
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@rendermode InteractiveServer
@inject HistoryRecorder HistoryRecorder
@inject IJSRuntime JSRuntime
@inject ILogger<GroupMessages> Logger
@implements IAsyncDisposable

<PageTitle>群聊消息</PageTitle>

<div class="container-custom" style="height: 100%;">

	<div class="row-layout" style="height: 100%;">
		<!-- 左侧群聊列表 -->
		<div class="col-left">
			<div class="card-full-height">
				<div class="card-header-custom">
					群聊列表
				</div>
				<div class="card-body-custom overflow-auto-custom" style="max-height: 80vh;">
					@if (IsLoadingGroups)
					{
						<div class="text-center-custom text-muted-custom py-2-custom">
							加载群聊列表中...
						</div>
					}
					else if (GroupIdsLoadError != null)
					{
						<div class="text-center-custom text-danger-custom py-2-custom">
							@GroupIdsLoadError
							<br />
							<button type="button" class="btn-link-custom" @onclick="LoadGroupIds">点击重试</button>
						</div>
					}
					else
					{
						<ul class="list-group-custom">
							@foreach (var groupId in GroupIds)
							{
								<li class="list-group-item-custom @(SelectedGroupId == groupId ? "active-custom" : "")"
									tabindex="0"
									role="button"
									aria-current="@(SelectedGroupId == groupId ? "true" : "false")"
									@onclick="async () => await SelectGroup(groupId)"
									@onkeydown="async () => await SelectGroupOnKey(groupId)">
									@if (GroupNameCache.TryGetValue(groupId, out var groupNameEntry) &&
											!string.IsNullOrEmpty(groupNameEntry.Name))
									{
										<span>@groupNameEntry.Name (@groupId)</span>
									}
									else
									{
										<span>@groupId</span>
									}
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>

		<!-- 右侧消息展示 -->
		<div class="col-right" style="height: 100%;">
			<div class="card-full-height">
				<div class="card-header-custom">
					@if (SelectedGroupId > 0)
					{
						@if (GroupNameCache.TryGetValue(SelectedGroupId, out var groupInfo) &&
								!string.IsNullOrEmpty(groupInfo.Name))
						{
							<span>@groupInfo.Name (@SelectedGroupId) - 成员: @groupInfo.MemberCount/@groupInfo.MaxMemberCount |
								更新于: @groupInfo.UpdatedTime.ToString("yyyy-MM-dd HH:mm")</span>
						}
						else
						{
							<span>群聊 @SelectedGroupId 的消息</span>
						}
					}
					else
					{
						<span>请选择一个群聊</span>
					}
				</div>
				<div class="card-body-custom overflow-auto-custom" style="max-height: 90vh;" @onscroll="HandleScroll"
					id="group-message-container">
					@if (IsLoadingMessages)
					{
						<div class="text-center-custom text-muted-custom mt-5-custom">
							加载消息中...
						</div>
					}
					else if (MessagesLoadError != null)
					{
						<div class="text-center-custom text-danger-custom mt-5-custom">
							@MessagesLoadError
						</div>
					}
					else if (SelectedGroupId > 0)
					{
						@if (GroupMessageList.Any())
						{
							<div class="message-container-custom" id="group-message-list">
								@if (IsLoadingMore)
								{
									<div class="text-center-custom text-muted-custom py-2-custom">
										加载更多消息...
									</div>
								}
								@foreach (var message in ReversedMessages)
								{
									@* sender *@
									<div
										class="@(message.IsDeleted ? "message-item-deleted-custom" : "message-item-custom") mb-3-custom">
										<div class="message-header-custom">
											<p>
												<strong>@message.SenderNickname</strong>
												@message.SenderId
												@(!string.IsNullOrEmpty(message.SenderGroupNickname) ?
													$"({message.SenderGroupNickname})" : "")
											</p>
											<span class="text-muted-custom float-end-custom">
												@message.MessageId &nbsp;
												@message.Time.ToString("yyyy-MM-dd HH:mm:ss")
											</span>
										</div>
										@* content *@
										<div class="message-content-custom">
											@if (message.IsDeleted)
											{
												<span class="message-deleted-text-custom">已撤回</span>
											}
											@foreach (var msg in message.Messages)
											{
												@RenderMessage(msg)
											}
										</div>
									</div>
								}
							</div>
						}
						else
						{
							<div class="text-center-custom text-muted-custom mt-5-custom">
								暂无消息
							</div>
						}
					}
					else
					{
						<div class="text-center-custom text-muted-custom mt-5-custom">
							请从左侧选择一个群聊
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>

<div id="forward-modal" class="modal-overlay" style="display: none;"
	role="dialog" aria-modal="true" aria-labelledby="forward-modal-title"
	@onkeydown="OnModalKeyDown">
	<div class="modal-content">
		<div class="modal-header">
			<span id="forward-modal-title">转发消息</span>
			<button type="button" class="modal-close-btn" aria-label="关闭" onclick="closeForwardModal()">×</button>
		</div>
		<iframe id="forward-iframe" class="modal-iframe" title="转发消息内容"></iframe>
	</div>
</div>

@code {
	private List<long> GroupIds { get; set; } = new List<long>();

	private Dictionary<long, GroupNameEntry> GroupNameCache { get; set; } = new Dictionary<long, GroupNameEntry>();

	private long SelectedGroupId { get; set; } = 0;

	private List<GroupMessage> GroupMessageList { get; set; } = new List<GroupMessage>();

	private bool IsLoadingGroups { get; set; } = true;
	private bool IsLoadingMessages { get; set; } = true;
	private bool IsLoadingMore { get; set; } = false;
	private string? GroupIdsLoadError { get; set; }
	private string? MessagesLoadError { get; set; }

	private int CurrentPage { get; set; } = 1;

	private int PageSize { get; set; } = 50;

	private bool HasMoreMessages { get; set; } = true;

	private DotNetObjectReference<GroupMessages>? _dotNetRef;

	private bool _isDisposed;

	// 群聊切换竞态守护：每次加载自增，完成后比较，过期则丢弃结果
	private long _loadSeq;

	private IEnumerable<GroupMessage> ReversedMessages => GroupMessageList.AsEnumerable().Reverse();


	protected override async Task OnInitializedAsync()
	{
		await LoadGroupIds();

		if (GroupIds.Any())
		{
			SelectedGroupId = GroupIds[0];
			await LoadGroupMessages(SelectedGroupId, false);
		}
		else
		{
			IsLoadingMessages = false;
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			_dotNetRef = DotNetObjectReference.Create(this);
			if (SelectedGroupId > 0)
			{
				await ScrollToBottom();
			}
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_isDisposed) return;

		if (_dotNetRef != null)
		{
			_dotNetRef.Dispose();
			_dotNetRef = null;
		}
		_isDisposed = true;
		await ValueTask.CompletedTask;
	}

	private async Task LoadGroupIds()
	{
		IsLoadingGroups = true;
		GroupIdsLoadError = null;
		try
		{
			GroupIds = await HistoryRecorder.GetAllGroupIdsAsync();
			var allGroupNames = await HistoryRecorder.GetAllGroupNamesAsync();
			GroupNameCache = allGroupNames.ToDictionary(g => g.GroupId, g => g);
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "加载群聊列表失败");
			GroupIds = new List<long>();
			GroupIdsLoadError = "加载群聊列表失败";
		}
		finally
		{
			IsLoadingGroups = false;
		}
	}

	private async Task LoadGroupMessages(long groupId, bool shouldScroll = true)
	{
		var seq = Interlocked.Increment(ref _loadSeq);
		CurrentPage = 1;
		HasMoreMessages = true;
		IsLoadingMessages = true;
		MessagesLoadError = null;

		try
		{
			var messages = await HistoryRecorder.GetMessagesByGroupIdAsync(groupId, CurrentPage, PageSize);
			// 过期结果丢弃，防止切换群聊后旧结果覆盖
			if (seq != Interlocked.Read(ref _loadSeq) || _isDisposed) return;
			GroupMessageList = messages;
		}
		catch (Exception ex)
		{
			if (seq != Interlocked.Read(ref _loadSeq) || _isDisposed) return;
			Logger.LogError(ex, "加载群聊消息失败: groupId={GroupId}", groupId);
			GroupMessageList = new List<GroupMessage>();
			MessagesLoadError = "加载消息失败";
		}
		finally
		{
			if (seq == Interlocked.Read(ref _loadSeq) && !_isDisposed)
			{
				IsLoadingMessages = false;
			}
		}

		if (shouldScroll && seq == Interlocked.Read(ref _loadSeq) && !_isDisposed)
		{
			await Task.Delay(50);
			await ScrollToBottom();
		}
	}

	private async Task LoadMoreGroupMessages()
	{
		if (IsLoadingMore || !HasMoreMessages)
			return;

		IsLoadingMore = true;
		CurrentPage++;

		try
		{
			var moreMessages = await HistoryRecorder.GetMessagesByGroupIdAsync(SelectedGroupId, CurrentPage, PageSize);
			if (moreMessages.Any())
			{
				var before = await JSRuntime.InvokeAsync<ScrollInfo>("getScrollInfo", "group-message-container");
				GroupMessageList.AddRange(moreMessages);
				await Task.Delay(50);
				var after = await JSRuntime.InvokeAsync<ScrollInfo>("getScrollInfo", "group-message-container");
				await JSRuntime.InvokeVoidAsync("setScrollTop", "group-message-container", before.ScrollTop + after.ScrollHeight - before.ScrollHeight);
			}
			else
			{
				HasMoreMessages = false;
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "加载更多群聊消息失败: groupId={GroupId}", SelectedGroupId);
		}
		finally
		{
			IsLoadingMore = false;
		}
	}

	private record ScrollInfo(double ScrollHeight, double ScrollTop);

	private async Task HandleScroll(EventArgs e)
	{
		if (_dotNetRef != null)
		{
			await JSRuntime.InvokeVoidAsync("handleScrollForLoadMore", "group-message-container", _dotNetRef);
		}
	}

	private async Task OpenForwardModal(string forwardId)
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("openForwardModal", forwardId);
		}
		catch (JSDisconnectedException)
		{
			// 电路已断开，忽略
		}
	}

	private async Task OnModalKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Escape")
		{
			await JSRuntime.InvokeVoidAsync("closeForwardModal");
		}
	}

	[JSInvokable]
	public async Task LoadMoreMessages()
	{
		if (HasMoreMessages && !IsLoadingMore)
		{
			await LoadMoreGroupMessages();
		}
	}

	private async Task ScrollToBottom()
	{
		await JSRuntime.InvokeVoidAsync("scrollToElementBottom", "group-message-container");
	}

	private async Task SelectGroup(long groupId)
	{
		if (SelectedGroupId == groupId) return;
		SelectedGroupId = groupId;
		await LoadGroupMessages(groupId);
	}

	private async Task SelectGroupOnKey(long groupId)
	{
		// 键盘激活（Enter/Space 等）触发选择
		await SelectGroup(groupId);
	}

	private RenderFragment RenderMessage(object msg)
	{
		return __builder =>
		{
			try
			{
				// 直接根据消息对象的类型进行处理
				if (msg is NapcatClient.MessageType.TextData textData)
				{
					<span>@textData.Text</span>
				}
				else if (msg is NapcatClient.MessageType.AtData atData)
				{
					<span class="text-primary-custom">@(atData.Qq == "all" ? "@全体成员" : $"@{atData.Qq}")</span>
				}
				else if (msg is NapcatClient.MessageType.FaceData faceData)
				{
					<span class="text-muted-custom">[表情: @faceData.ToChinese()]</span>
				}
				else if (msg is NapcatClient.MessageType.ImageData imageData)
				{
					<div class="mt-1-custom">
						<div class="text-muted-custom small-custom mb-1-custom">@(imageData.Summary ?? "图片")</div>
						<img src="/api/image/@imageData.Url" alt="@(imageData.Summary ?? "图片")" class="img-fluid-custom rounded-custom"
							loading="lazy" decoding="async"
							style="max-height: 300px;" />
					</div>
				}
				else if (msg is NapcatClient.MessageType.FileData fileData)
				{
					<div class="mt-1-custom">
						<a href="/api/file/@fileData.Url?name=@Uri.EscapeDataString(fileData.File ?? "")" download="@fileData.File" class="text-primary-custom"
							title="点击下载文件">
							[文件] @fileData.File (@CommonLib.Format.FormatFileSize(fileData.FileSize ?? 0))
						</a>
					</div>
				}
				else if (msg is NapcatClient.MessageType.RecordData recordData)
				{
					<div class="mt-1-custom play-btn-row-custom">
						<button type="button" class="play-btn-bare"
						@onclick='() => PlayAmr($"/api/file/{recordData.Url}")' title="点击播放语音" aria-label="播放语音">
							▶
						</button>
						<span class="text-primary-custom">@(recordData.Path ?? "语音消息")</span>
					</div>
				}
				else if (msg is NapcatClient.MessageType.VideoData videoData)
				{
					<div class="mt-1-custom">
						<video src="/api/file/@videoData.Url" controls preload="metadata"
							class="inline-video"></video>
					</div>
				}
				else if (msg is NapcatClient.MessageType.ForwardData forwardData)
				{
					<div class="mt-1-custom">
						<a href="javascript:void(0)" class="text-primary-custom" @onclick="() => OpenForwardModal(forwardData.Id)">
							[转发消息] 点击查看详情
						</a>
					</div>
				}
				else if (msg is NapcatClient.MessageType.ReplyData replyData)
				{
					<div class="mt-1-custom text-muted-custom">
						[回复] 消息 ID: @replyData.Id
					</div>
				}
				else if (msg is NapcatClient.MessageType.JsonData)
				{
					<div class="mt-1-custom text-muted-custom">
						[卡片消息]
					</div>
				}
				else if (msg is NapcatClient.MessageType.MusicData musicData)
				{
					<div class="mt-1-custom">
						<span class="text-primary-custom">[音乐] @musicData.Title - @musicData.Singer</span>
					</div>
				}
				else if (msg is NapcatClient.MessageType.DiceData diceData)
				{
					<div class="mt-1-custom">
						<span class="text-primary-custom">[骰子] 点数: @diceData.Result</span>
					</div>
				}
				else if (msg is NapcatClient.MessageType.RpsData rpsData)
				{
					<div class="mt-1-custom">
						<span class="text-primary-custom">[石头剪刀布] @(rpsData.Result == "1" ? "石头" : rpsData.Result == "2" ? "剪刀" : "布")</span>
					</div>
				}
				else if (msg is NapcatClient.MessageType.PokeData pokeData)
				{
					<div class="mt-1-custom text-muted-custom">
						[戳一戳] @pokeData.Type
					</div>
				}
				else if (msg is NapcatClient.MessageType.MfaceData mfaceData)
				{
					<div class="mt-1-custom text-muted-custom">
						[商城表情] @mfaceData.Summary
					</div>
				}
				else
				{
					<span class="text-muted-custom">[未知消息类型: @msg.GetType().Name]</span>
				}
			}
			catch (Exception ex)
			{
				<span class="text-danger-custom">[消息渲染错误: @ex.Message]</span>
			}
		};
	}

	private async Task PlayAmr(string url)
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("playAmrAudio", url);
		}
		catch (JSDisconnectedException)
		{
			// 电路已断开，忽略
		}
	}
}
