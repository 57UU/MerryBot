@page "/"
@using DataService
@inject HistoryRecorder HistoryRecorder

<PageTitle>统计数据</PageTitle>
<h1 style="margin-top: 1rem; margin-bottom: 1rem;">历史记录统计</h1>
<h2>统计数据</h2>
<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
	<StatCard Title="活跃群聊" Value="@GroupCount" />
	<StatCard Title="群聊消息数" Value="@MessageCount" />
	<StatCard Title="AI 消息数" Value="@AiMessageCount" />
	<StatCard Title="图片数量" Value="@ImageCount" />
	<StatCard Title="文件/视频/语音数量" Value="@FileCount" />
</div>
<br />
<h2>文件大小</h2>
<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
	<StatCard Title="群聊历史库" Value="@GroupHistoryDbSize" />
	<StatCard Title="图片存储" Value="@ImageStorageSize" />
	<StatCard Title="文件存储" Value="@FileStorageSize" />
</div>

@code {
	private List<long> GroupIds { get; set; } = new List<long>();
	private int GroupCount { get; set; } = 0;
	private int MessageCount { get; set; } = 0;
	private int AiMessageCount { get; set; } = 0;
	private int ImageCount { get; set; } = 0;
	private int FileCount { get; set; } = 0;
	private string GroupHistoryDbSize { get; set; } = "Unavaliable";
	private string ImageStorageSize { get; set; } = "Unavaliable";
	private string FileStorageSize { get; set; } = "Unavaliable";

	protected override async Task OnInitializedAsync()
	{
		await LoadGroupIds();
		await LoadStatistics();
		await LoadDbSizesAsync();
	}

	private async Task LoadGroupIds()
	{
		try
		{
			GroupIds = await HistoryRecorder.GetAllGroupIdsAsync();
			GroupCount = GroupIds.Count;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading group IDs: {ex.Message}");
			GroupIds = new List<long> { 0 };
			GroupCount = GroupIds.Count;
		}
	}

	private async Task LoadStatistics()
	{
		try
		{
			MessageCount = 0;
			foreach (var gid in GroupIds)
			{
				var messages = await HistoryRecorder.GetMessagesByGroupIdAsync(gid, 1000);
				MessageCount += messages.Count;
			}

			AiMessageCount = 0;
			foreach (var gid in GroupIds)
			{
				var count = await HistoryRecorder.GetAiMessageCountByGroupIdAsync(gid);
				AiMessageCount += count;
			}

			ImageCount = await HistoryRecorder.GetImageCountAsync();
			FileCount = await HistoryRecorder.GetFileCountAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading statistics: {ex.Message}");
			MessageCount = 100;
			AiMessageCount = 50;
		}
	}

	private async Task LoadDbSizesAsync()
	{
		try
		{
			GroupHistoryDbSize = HistoryRecorder.GetDatabaseSize();
			ImageStorageSize = await HistoryRecorder.GetImageStorageSizeAsync();
			FileStorageSize = await HistoryRecorder.GetFileStorageSizeAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading database sizes: {ex.Message}");
		}
	}
}
