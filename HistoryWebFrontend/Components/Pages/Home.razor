@page "/"
@using DataService
@using Microsoft.Extensions.Logging
@inject HistoryRecorder HistoryRecorder
@inject ILogger<Home> Logger

<PageTitle>统计数据</PageTitle>
<h1 class="page-title">历史记录统计</h1>
<h2>统计数据</h2>
<div class="stat-row">
	<StatCard Title="活跃群聊" Value="@(IsLoadingStats ? "—" : GroupCount.ToString())" />
	<StatCard Title="群聊消息数" Value="@(IsLoadingStats ? "—" : MessageCount.ToString())" />
	<StatCard Title="AI 消息数" Value="@(IsLoadingStats ? "—" : AiMessageCount.ToString())" />
	<StatCard Title="图片数量" Value="@(IsLoadingStats ? "—" : ImageCount.ToString())" />
	<StatCard Title="文件/视频/语音数量" Value="@(IsLoadingStats ? "—" : FileCount.ToString())" />
</div>
<h2>文件大小</h2>
<div class="stat-row">
	<StatCard Title="群聊历史库" Value="@GroupHistoryDbSize" />
	<StatCard Title="图片存储" Value="@ImageStorageSize" />
	<StatCard Title="文件存储" Value="@FileStorageSize" />
</div>

@code {
	private List<long> GroupIds { get; set; } = new List<long>();
	private int GroupCount { get; set; } = 0;
	private int MessageCount { get; set; } = 0;
	private int AiMessageCount { get; set; } = 0;
	private int ImageCount { get; set; } = 0;
	private int FileCount { get; set; } = 0;
	private string GroupHistoryDbSize { get; set; } = "加载中";
	private string ImageStorageSize { get; set; } = "加载中";
	private string FileStorageSize { get; set; } = "加载中";

	private bool IsLoadingStats { get; set; } = true;

	protected override async Task OnInitializedAsync()
	{
		await LoadGroupIds();
		// LoadStatistics 依赖 GroupIds；LoadDbSizesAsync 与统计无依赖，并行执行
		var statsTask = LoadStatistics();
		var sizesTask = LoadDbSizesAsync();
		await Task.WhenAll(statsTask, sizesTask);
	}

	private async Task LoadGroupIds()
	{
		try
		{
			GroupIds = await HistoryRecorder.GetAllGroupIdsAsync();
			GroupCount = GroupIds.Count;
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "加载群聊列表失败");
			GroupIds = new List<long>();
			GroupCount = 0;
		}
	}

	private async Task LoadStatistics()
	{
		try
		{
			// 消息计数：使用 CountAsync，避免逐群拉取 1000 条消息
			MessageCount = 0;
			foreach (var gid in GroupIds)
			{
				MessageCount += await HistoryRecorder.GetMessageCountByGroupIdAsync(gid);
			}

			AiMessageCount = 0;
			foreach (var gid in GroupIds)
			{
				AiMessageCount += await HistoryRecorder.GetAiMessageCountByGroupIdAsync(gid);
			}

			ImageCount = await HistoryRecorder.GetImageCountAsync();
			FileCount = await HistoryRecorder.GetFileCountAsync();
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "加载统计数据失败");
		}
		finally
		{
			IsLoadingStats = false;
		}
	}

	private async Task LoadDbSizesAsync()
	{
		try
		{
			GroupHistoryDbSize = HistoryRecorder.GetDatabaseSize();
			ImageStorageSize = await HistoryRecorder.GetImageStorageSizeAsync();
			FileStorageSize = await HistoryRecorder.GetFileStorageSizeAsync();
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "加载文件大小失败");
			GroupHistoryDbSize = "加载失败";
			ImageStorageSize = "加载失败";
			FileStorageSize = "加载失败";
		}
	}
}
