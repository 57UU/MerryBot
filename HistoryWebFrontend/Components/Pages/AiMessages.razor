@page "/aimessages"
@using DataService
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@rendermode InteractiveServer
@inject HistoryRecorder HistoryRecorder
@inject IJSRuntime JSRuntime
@inject ILogger<AiMessages> Logger
@implements IAsyncDisposable

<PageTitle>AI消息</PageTitle>

<div class="container-custom h-100-custom" style="height: 100%;">

    <div class="row-layout">
        <!-- 左侧群聊列表 -->
        <div class="col-left">
            <div class="card-full-height">
                <div class="card-header-custom">
                    群聊列表
                </div>
                <div class="card-body-custom overflow-auto-custom" style="max-height: 80vh;">
                    @if (IsLoadingGroups)
                    {
                        <div class="text-center-custom text-muted-custom py-2-custom">
                            加载群聊列表中...
                        </div>
                    }
                    else if (GroupIdsLoadError != null)
                    {
                        <div class="text-center-custom text-danger-custom py-2-custom">
                            @GroupIdsLoadError
                            <br />
                            <button type="button" class="btn-link-custom" @onclick="LoadGroupIds">点击重试</button>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group-custom">
                            @foreach (var groupId in GroupIds)
                            {
                                <li class="list-group-item-custom @(SelectedAiGroupId == groupId ? "active-custom" : "")"
                                    tabindex="0"
                                    role="button"
                                    aria-current="@(SelectedAiGroupId == groupId ? "true" : "false")"
                                    @onclick="async () => await SelectAiGroup(groupId)"
                                    @onkeydown="async () => await SelectGroupOnKey(groupId)">
                                    @if (GroupNameCache.TryGetValue(groupId, out var groupNameEntry) && !string.IsNullOrEmpty(groupNameEntry.Name))
                                    {
                                        <span>@groupNameEntry.Name (@groupId)</span>
                                    }
                                    else
                                    {
                                        <span>@groupId</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- 右侧消息展示 -->
        <div class="col-right">
            <div class="card-full-height">
                <div class="card-header-custom">
                    @(SelectedAiGroupId > 0 ? $"群聊 {SelectedAiGroupId} 的 AI 消息" : "请选择一个群聊")
                </div>
                <div class="card-body-custom overflow-auto-custom" style="max-height: 90vh;" @onscroll="HandleScroll" id="ai-message-container">
                    @if (IsLoadingMessages)
                    {
                        <div class="text-center-custom text-muted-custom mt-5-custom">
                            加载消息中...
                        </div>
                    }
                    else if (MessagesLoadError != null)
                    {
                        <div class="text-center-custom text-danger-custom mt-5-custom">
                            @MessagesLoadError
                        </div>
                    }
                    else if (SelectedAiGroupId > 0)
                    {
                        @if (AiMessageList.Any())
                        {
                            <div class="message-container-custom" id="ai-message-list">
                                @if (IsLoadingMore)
                                {
                                    <div class="text-center-custom text-muted-custom py-2-custom">
                                        加载更多消息...
                                    </div>
                                }
                                @foreach (var message in ReversedMessages)
                                {
                                    <div class="message-item-custom mb-3-custom">
                                        <div class="message-header-custom">
                                            <strong>@message.MessageType</strong>
                                            <span class="text-muted-custom float-end-custom">@DateTimeOffset.FromUnixTimeSeconds(message.Time).ToString("yyyy-MM-dd HH:mm:ss")</span>
                                        </div>
                                        <div class="message-content-custom">
                                            <div>@message.Content</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center-custom text-muted-custom mt-5-custom">
                                暂无 AI 消息
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center-custom text-muted-custom mt-5-custom">
                            请从左侧选择一个群聊
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<long> GroupIds { get; set; } = new List<long>();
    private Dictionary<long, GroupNameEntry> GroupNameCache { get; set; } = new Dictionary<long, GroupNameEntry>();
    private long SelectedAiGroupId { get; set; } = 0;
    private List<AiMessageEntry> AiMessageList { get; set; } = new List<AiMessageEntry>();
    private IEnumerable<AiMessageEntry> ReversedMessages => AiMessageList.AsEnumerable().Reverse();

    private bool IsLoadingGroups { get; set; } = true;
    private bool IsLoadingMessages { get; set; } = true;
    private bool IsLoadingMore { get; set; } = false;
    private string? GroupIdsLoadError { get; set; }
    private string? MessagesLoadError { get; set; }

    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 50;
    private bool HasMoreMessages { get; set; } = true;

    private DotNetObjectReference<AiMessages>? _dotNetRef;
    private bool _isDisposed;
    // 群聊切换竞态守护：每次加载自增，完成后比较，过期则丢弃结果
    private long _loadSeq;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupIds();

        if (GroupIds.Any())
        {
            SelectedAiGroupId = GroupIds[0];
            await LoadAiMessages(SelectedAiGroupId, false);
        }
        else
        {
            IsLoadingMessages = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            if (SelectedAiGroupId > 0)
            {
                await ScrollToBottom();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;

        if (_dotNetRef != null)
        {
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
        _isDisposed = true;
        await ValueTask.CompletedTask;
    }

    private async Task LoadGroupIds()
    {
        IsLoadingGroups = true;
        GroupIdsLoadError = null;
        try
        {
            GroupIds = await HistoryRecorder.GetAllGroupIdsAsync();
            var allGroupNames = await HistoryRecorder.GetAllGroupNamesAsync();
            GroupNameCache = allGroupNames.ToDictionary(g => g.GroupId, g => g);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载群聊列表失败");
            GroupIds = new List<long>();
            GroupIdsLoadError = "加载群聊列表失败";
        }
        finally
        {
            IsLoadingGroups = false;
        }
    }

    private async Task LoadAiMessages(long groupId, bool shouldScroll = true)
    {
        var seq = Interlocked.Increment(ref _loadSeq);
        CurrentPage = 1;
        HasMoreMessages = true;
        IsLoadingMessages = true;
        MessagesLoadError = null;

        try
        {
            var messages = await HistoryRecorder.GetAiMessagesByGroupIdAsync(groupId, CurrentPage, PageSize);
            // 过期结果丢弃，防止切换群聊后旧结果覆盖
            if (seq != Interlocked.Read(ref _loadSeq) || _isDisposed) return;
            AiMessageList = messages;
        }
        catch (Exception ex)
        {
            if (seq != Interlocked.Read(ref _loadSeq) || _isDisposed) return;
            Logger.LogError(ex, "加载 AI 消息失败: groupId={GroupId}", groupId);
            AiMessageList = new List<AiMessageEntry>();
            MessagesLoadError = "加载消息失败";
        }
        finally
        {
            if (seq == Interlocked.Read(ref _loadSeq) && !_isDisposed)
            {
                IsLoadingMessages = false;
            }
        }

        if (shouldScroll && seq == Interlocked.Read(ref _loadSeq) && !_isDisposed)
        {
            await Task.Delay(50);
            await ScrollToBottom();
        }
    }

    private record ScrollInfo(double ScrollHeight, double ScrollTop);

    private async Task LoadMoreAiMessages()
    {
        if (IsLoadingMore || !HasMoreMessages)
            return;

        IsLoadingMore = true;
        CurrentPage++;

        try
        {
            var moreMessages = await HistoryRecorder.GetAiMessagesByGroupIdAsync(SelectedAiGroupId, CurrentPage, PageSize);
            if (moreMessages.Any())
            {
                var before = await JSRuntime.InvokeAsync<ScrollInfo>("getScrollInfo", "ai-message-container");
                AiMessageList.AddRange(moreMessages);
                await Task.Delay(50);
                var after = await JSRuntime.InvokeAsync<ScrollInfo>("getScrollInfo", "ai-message-container");
                await JSRuntime.InvokeVoidAsync("setScrollTop", "ai-message-container", before.ScrollTop + after.ScrollHeight - before.ScrollHeight);
            }
            else
            {
                HasMoreMessages = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载更多 AI 消息失败: groupId={GroupId}", SelectedAiGroupId);
        }
        finally
        {
            IsLoadingMore = false;
        }
    }

    private async Task HandleScroll(EventArgs e)
    {
        if (_dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("handleScrollForLoadMore", "ai-message-container", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task LoadMoreMessages()
    {
        if (HasMoreMessages && !IsLoadingMore)
        {
            await LoadMoreAiMessages();
        }
    }

    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("scrollToElementBottom", "ai-message-container");
    }

    private async Task SelectAiGroup(long groupId)
    {
        if (SelectedAiGroupId == groupId) return;
        SelectedAiGroupId = groupId;
        await LoadAiMessages(groupId);
    }

    private async Task SelectGroupOnKey(long groupId)
    {
        // 键盘激活（Enter/Space 等）触发选择
        await SelectAiGroup(groupId);
    }
}
