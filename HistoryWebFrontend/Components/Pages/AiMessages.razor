@page "/aimessages"
@using DataService
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer
@inject HistoryRecorder HistoryRecorder
@inject IJSRuntime JSRuntime

<PageTitle>AI消息</PageTitle>

<div class="container-custom h-100-custom" style="height: 100%;">
    
    <div class="row-layout">
        <!-- 左侧群聊列表 -->
        <div class="col-left">
            <div class="card-full-height">
                <div class="card-header-custom">
                    群聊列表
                </div>
                <div class="card-body-custom overflow-auto-custom" style="max-height: 80vh;">
                    <ul class="list-group-custom">
                        @foreach (var groupId in GroupIds)
                        {
                            <li class="list-group-item-custom @(SelectedAiGroupId == groupId ? "active-custom" : "")" @onclick="async () => await SelectAiGroup(groupId)">
                                @if (GroupNameCache.TryGetValue(groupId, out var groupNameEntry) && !string.IsNullOrEmpty(groupNameEntry.Name))
                                {
                                    <span>@groupNameEntry.Name (@groupId)</span>
                                }
                                else
                                {
                                    <span>@groupId</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- 右侧消息展示 -->
        <div class="col-right">
            <div class="card-full-height">
                <div class="card-header-custom">
                    @(SelectedAiGroupId > 0 ? $"群聊 {SelectedAiGroupId} 的 AI 消息" : "请选择一个群聊")
                </div>
                <div class="card-body-custom overflow-auto-custom" style="max-height: 90vh;" @onscroll="HandleScroll" id="ai-message-container">
                    @if (SelectedAiGroupId > 0)
                    {
                        @if (IsAiLoading && CurrentPage == 1)
                        {
                            <div class="text-center-custom text-muted-custom py-2-custom">
                                加载中...
                            </div>
                        }
                        
                        @if (AiMessageList.Any())
                        {
                            <div class="message-container-custom" id="ai-message-list">
                                @if (IsLoadingMore)
                                {
                                    <div class="text-center-custom text-muted-custom py-2-custom">
                                        加载更多消息...
                                    </div>
                                }
                                @foreach (var message in AiMessageList.AsEnumerable().Reverse())
                                {
                                    <div class="message-item-custom mb-3-custom">
                                        <div class="message-header-custom">
                                            <strong>@message.MessageType</strong>
                                            <span class="text-muted-custom float-end-custom">@DateTimeOffset.FromUnixTimeSeconds(message.Time).ToString("yyyy-MM-dd HH:mm:ss")</span>
                                        </div>
                                        <div class="message-content-custom">
                                            <div>@message.Content</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else if (!IsAiLoading)
                        {
                            <div class="text-center-custom text-muted-custom mt-5-custom">
                                暂无 AI 消息
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center-custom text-muted-custom mt-5-custom">
                            请从左侧选择一个群聊
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let scrollTimeout = null;
    
    function scrollToElementBottom(elementId) {
        const element = document.getElementById(elementId);
        if (element) {
            element.scrollTop = element.scrollHeight;
        }
    }
    
    function checkScrollPosition(elementId, dotNetRef) {
        const element = document.getElementById(elementId);
        if (element && element.scrollTop <= 50) {
            dotNetRef.invokeMethodAsync('LoadMoreMessages');
        }
    }
    
    function handleScrollWithDebounce(elementId, dotNetRef) {
        if (scrollTimeout) {
            clearTimeout(scrollTimeout);
        }
        scrollTimeout = setTimeout(() => {
            checkScrollPosition(elementId, dotNetRef);
        }, 200);
    }
</script>

@code {
    private List<long> GroupIds { get; set; } = new List<long>();
    private Dictionary<long, GroupNameEntry> GroupNameCache { get; set; } = new Dictionary<long, GroupNameEntry>();
    private long SelectedAiGroupId { get; set; } = 0;
    private List<AiMessageEntry> AiMessageList { get; set; } = new List<AiMessageEntry>();
    private bool IsAiLoading { get; set; } = false;
    private bool IsLoadingMore { get; set; } = false;
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 50;
    private bool HasMoreMessages { get; set; } = true;
    private DotNetObjectReference<AiMessages>? _dotNetRef;
    private bool _isDisposed;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadGroupIds();
        
        if (GroupIds.Any())
        {
            SelectedAiGroupId = GroupIds[0];
            await LoadAiMessages(SelectedAiGroupId, false);
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            if (SelectedAiGroupId > 0)
            {
                await ScrollToBottom();
            }
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        if (!_isDisposed)
        {
            if (_dotNetRef != null)
            {
                _dotNetRef.Dispose();
            }
            _isDisposed = true;
        }
    }
    
    private async Task LoadGroupIds()
    {
        try
        {
            GroupIds = await HistoryRecorder.GetAllGroupIdsAsync();
            // 加载群名称缓存
            var allGroupNames = await HistoryRecorder.GetAllGroupNamesAsync();
            GroupNameCache = allGroupNames.ToDictionary(g => g.GroupId, g => g);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading group IDs: {ex.Message}");
            GroupIds = new List<long> { 0};
        }
    }
    
    private async Task LoadAiMessages(long groupId, bool shouldScroll = true)
    {
        CurrentPage = 1;
        HasMoreMessages = true;
        IsAiLoading = true;
        try
        {
            AiMessageList = await HistoryRecorder.GetAiMessagesByGroupIdAsync(groupId, CurrentPage, PageSize);
            if (shouldScroll)
            {
                await Task.Delay(100);
                await ScrollToBottom();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading AI messages: {ex.Message}");
            AiMessageList = new List<AiMessageEntry>();
        }
        finally
        {
            IsAiLoading = false;
        }
    }
    
    private async Task LoadMoreAiMessages()
    {
        if (IsLoadingMore || !HasMoreMessages)
            return;
        
        IsLoadingMore = true;
        CurrentPage++;
        
        try
        {
            var moreMessages = await HistoryRecorder.GetAiMessagesByGroupIdAsync(SelectedAiGroupId, CurrentPage, PageSize);
            if (moreMessages.Any())
            {
                var oldScrollHeight = await GetScrollHeight();
                var oldScrollTop = await GetScrollTop();
                
                AiMessageList.AddRange(moreMessages);
                
                await Task.Delay(50);
                
                var newScrollHeight = await GetScrollHeight();
                var scrollPosition = oldScrollTop + (newScrollHeight - oldScrollHeight);
                
                await SetScrollTop(scrollPosition);
            }
            else
            {
                HasMoreMessages = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading more AI messages: {ex.Message}");
        }
        finally
        {
            IsLoadingMore = false;
        }
    }
    
    private async Task HandleScroll(EventArgs e)
    {
        if (_dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("handleScrollWithDebounce", "ai-message-container", _dotNetRef);
        }
    }
    
    [JSInvokable]
    public async Task LoadMoreMessages()
    {
        if (HasMoreMessages && !IsLoadingMore)
        {
            await LoadMoreAiMessages();
        }
    }
    
    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("scrollToElementBottom", "ai-message-container");
    }
    
    private async Task<double> GetScrollHeight()
    {
        return await JSRuntime.InvokeAsync<double>("eval", "document.getElementById('ai-message-container').scrollHeight");
    }
    
    private async Task<double> GetScrollTop()
    {
        return await JSRuntime.InvokeAsync<double>("eval", "document.getElementById('ai-message-container').scrollTop");
    }
    
    private async Task SetScrollTop(double scrollTop)
    {
        await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('ai-message-container').scrollTop = {scrollTop}");
    }
    
    private async Task SelectAiGroup(long groupId)
    {
        SelectedAiGroupId = groupId;
        await LoadAiMessages(groupId);
    }
}
