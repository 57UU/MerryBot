@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

@{
    var isEmbed = GetEmbedParam();
}

<div class="page">
    @if (!isEmbed)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main class="@(isEmbed ? "embed-mode" : "")">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert" aria-live="assertive">
    发生未处理的错误。
    <a href="." class="reload">刷新</a>
    <button type="button" class="dismiss" aria-label="关闭错误提示">×</button>
</div>

@code {
    private bool GetEmbedParam()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query["embed"] == "1";
    }
}
