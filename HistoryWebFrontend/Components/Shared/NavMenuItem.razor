<div class="nav-item">
    <NavLink class="nav-link" href="@Href" Match=@Match>
          @ChildContent
    </NavLink>
</div>

@code {
    [Parameter]
    public string Href { get; set; } = string.Empty;

    [Parameter]
    public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}