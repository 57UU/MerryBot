<div class="stat-card">
    <div class="stat-card-body">
        <h5 class="stat-card-title">@Title</h5>
        <p class="stat-card-value">@Value</p>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public object Value { get; set; } = 0;
}
